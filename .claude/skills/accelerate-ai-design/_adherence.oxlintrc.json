{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/layout/**",
              "components/producto/**",
              "ui_kits/plantilla-redes/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo))/i]",
        "message": "Font not provided by the design system. Available: Archivo."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|size|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, icon, size, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:feed|compact)$/]",
        "message": "<Button> size must be one of 'feed' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardInvertida'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|radius|padding|style|key|ref|className|style|children)$/]",
        "message": "<CardInvertida> doesn't accept that prop. Declared props: children, radius, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardInvertida'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:lg|md)$/]",
        "message": "<CardInvertida> radius must be one of 'lg' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|montado|size|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, tone, icon, montado, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:claro|oscuro|acento)$/]",
        "message": "<Chip> tone must be one of 'claro' | 'oscuro' | 'acento'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:feed|compact)$/]",
        "message": "<Chip> size must be one of 'feed' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|fondo|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, fondo, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='fondo'] > Literal[value!=/^(?:claro|oscuro)$/]",
        "message": "<Eyebrow> fondo must be one of 'claro' | 'oscuro'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|fondo|logo|piezaLogo|index|total|guias|scale|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<FeedFrame> doesn't accept that prop. Declared props: children, fondo, logo, piezaLogo, index, total, guias, scale, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedFrame'] > JSXAttribute[name.name='fondo'] > Literal[value!=/^(?:claro|oscuro)$/]",
        "message": "<FeedFrame> fondo must be one of 'claro' | 'oscuro'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedFrame'] > JSXAttribute[name.name='piezaLogo'] > Literal[value!=/^(?:isotipo|imagotipo|logotipo)$/]",
        "message": "<FeedFrame> piezaLogo must be one of 'isotipo' | 'imagotipo' | 'logotipo'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Fuente'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|fondo|style|key|ref|className|style|children)$/]",
        "message": "<Fuente> doesn't accept that prop. Declared props: children, fondo, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Fuente'] > JSXAttribute[name.name='fondo'] > Literal[value!=/^(?:claro|oscuro)$/]",
        "message": "<Fuente> fondo must be one of 'claro' | 'oscuro'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Glow'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|fondo|corner|size|opacity|style|key|ref|className|style|children)$/]",
        "message": "<Glow> doesn't accept that prop. Declared props: tone, fondo, corner, size, opacity, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Glow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:azul|cian)$/]",
        "message": "<Glow> tone must be one of 'azul' | 'cian'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Glow'] > JSXAttribute[name.name='fondo'] > Literal[value!=/^(?:oscuro|claro)$/]",
        "message": "<Glow> fondo must be one of 'oscuro' | 'claro'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Glow'] > JSXAttribute[name.name='corner'] > Literal[value!=/^(?:top-left|top-right|bottom-left|bottom-right)$/]",
        "message": "<Glow> corner must be one of 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GradientText'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|as|style|key|ref|className|style|children)$/]",
        "message": "<GradientText> doesn't accept that prop. Declared props: children, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:pieza|fondo|width|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: pieza, fondo, width, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='pieza'] > Literal[value!=/^(?:isotipo|imagotipo|logotipo)$/]",
        "message": "<Logo> pieza must be one of 'isotipo' | 'imagotipo' | 'logotipo'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='fondo'] > Literal[value!=/^(?:azul|claro)$/]",
        "message": "<Logo> fondo must be one of 'azul' | 'claro'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Numeracion'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|total|fondo|style|key|ref|className|style|children)$/]",
        "message": "<Numeracion> doesn't accept that prop. Declared props: index, total, fondo, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Numeracion'] > JSXAttribute[name.name='fondo'] > Literal[value!=/^(?:claro|oscuro)$/]",
        "message": "<Numeracion> fondo must be one of 'claro' | 'oscuro'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SafeZones'] > JSXAttribute > JSXIdentifier[name!=/^(?:formato|style|key|ref|className|style|children)$/]",
        "message": "<SafeZones> doesn't accept that prop. Declared props: formato, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SafeZones'] > JSXAttribute[name.name='formato'] > Literal[value!=/^(?:feed|historia)$/]",
        "message": "<SafeZones> formato must be one of 'feed' | 'historia'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StoryFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|fondo|logo|piezaLogo|guias|scale|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<StoryFrame> doesn't accept that prop. Declared props: children, fondo, logo, piezaLogo, guias, scale, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StoryFrame'] > JSXAttribute[name.name='fondo'] > Literal[value!=/^(?:claro|oscuro)$/]",
        "message": "<StoryFrame> fondo must be one of 'claro' | 'oscuro'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StoryFrame'] > JSXAttribute[name.name='piezaLogo'] > Literal[value!=/^(?:isotipo|imagotipo|logotipo)$/]",
        "message": "<StoryFrame> piezaLogo must be one of 'isotipo' | 'imagotipo' | 'logotipo'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WhatsAppMensaje'] > JSXAttribute > JSXIdentifier[name!=/^(?:from|text|hora|key|ref|className|style|children)$/]",
        "message": "<WhatsAppMensaje> doesn't accept that prop. Declared props: from, text, hora."
      },
      {
        "selector": "JSXOpeningElement[name.name='WhatsAppMensaje'] > JSXAttribute[name.name='from'] > Literal[value!=/^(?:recibida|enviada)$/]",
        "message": "<WhatsAppMensaje> from must be one of 'recibida' | 'enviada'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
