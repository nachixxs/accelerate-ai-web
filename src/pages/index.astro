---
// Las 7 secciones de SPECS §4, en orden. Todas van en <main>, portada y cierre incluidos:
// ahí están el título y los dos botones, y el lector de pantalla salta directo a <main>.
import Base from '../layouts/Base.astro';
import Portada from '../components/secciones/Portada.astro';
import QueResolvemos from '../components/secciones/QueResolvemos.astro';
import SistemasAMedida from '../components/secciones/SistemasAMedida.astro';
import ComoTrabajamos from '../components/secciones/ComoTrabajamos.astro';
import QuienesSomos from '../components/secciones/QuienesSomos.astro';
import PreguntasFrecuentes from '../components/secciones/PreguntasFrecuentes.astro';
import Cierre from '../components/secciones/Cierre.astro';
import Pie from '../components/Pie.astro';
import Encabezado from '../components/Encabezado.astro';
---

<Base
	title="Accelerate.ai | Sistemas a medida para pymes"
	description="Armamos sistemas a medida para negocios de cualquier rubro. Empezamos con una auditoría gratis para encontrar dónde perdés más tiempo."
>
	<Encabezado />
	<main>
		<Portada />
		<QueResolvemos />
		<SistemasAMedida />
		<ComoTrabajamos />
		<QuienesSomos />
		<PreguntasFrecuentes />
		<Cierre />
	</main>
	<Pie />
</Base>
