---
// El selector de pantallas de #trabajo: trae un celular al frente del escenario (el que lo mueve es
// scripts/trabajo-escenario.ts). Tres botones con aria-pressed. En el celular, control segmentado con una
// píldora que se desliza (--activa) y el texto del momento elegido debajo (sin JS, data-listo no está: los
// tres textos, sin botones); desde 768, cada momento con su texto, siempre visible, en una tarjeta con borde.
import Icono from '../Icono.astro';
import { pantallas } from './pantallas';

const activa = pantallas.findIndex((p) => p.pose === 'frente');
---

<div class="selector" data-selector role="group" aria-label="Elegí qué pantalla de la app ver">
	<ul class="selector__lista" style={`--activa:${activa}`}>
		<li class="sel__pildora" aria-hidden="true"></li>
		{
			pantallas.map((p, i) => (
				<li class="sel" data-sel={p.id} data-activa={p.pose === 'frente' ? '' : undefined} style={`--n:${i + 1}`}>
					<button type="button" class="sel__boton" aria-pressed={p.pose === 'frente' ? 'true' : 'false'} aria-label={`${p.nombre}: ${p.momento.toLowerCase()}`}>
						<Icono nombre={p.icono} size={32} class="sel__icono" />
						<span class="sel__corto">{p.corto}</span>
						<span class="sel__momento">{p.momento}</span>
						<Icono nombre="arrow-right-bold" size={20} class="sel__flecha" />
					</button>
					<p class="sel__texto"><strong>{p.nombre}.</strong> {p.texto}</p>
				</li>
			))
		}
	</ul>
</div>

<style>
	.selector {
		grid-area: selector;
		margin-top: var(--space-5);
	}

	.selector__lista {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
	}

	.sel__boton {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		min-width: 0;
		border: 2px solid transparent;
		background: transparent;
		color: var(--text-heading-dark);
		font: inherit;
		font-weight: var(--fw-semibold);
		cursor: pointer;
	}

	.sel__boton :global(.sel__icono) {
		flex: none;
	}

	.sel__boton :global(.sel__flecha) {
		display: none;
	}

	.sel__texto {
		color: var(--text-body-dark);
		font-size: var(--type-meta-size);
	}

	.sel__texto strong {
		color: var(--text-heading-dark);
		font-weight: var(--fw-semibold);
	}

	@media (forced-colors: active) {
		.sel__boton {
			border-color: Canvas;
		}

		.sel__boton[aria-pressed='true'] {
			border-color: Highlight;
		}

		.sel {
			border-color: CanvasText;
		}

		.sel[data-activa] {
			border-color: Highlight;
		}
	}

	/* Celular: ícono arriba y nombre corto; los tres textos comparten la celda de abajo, así que el
	   alto no salta al cambiar. La píldora azul se desliza detrás del botón elegido. */
	@media (max-width: 767.98px) {
		.selector__lista::before {
			content: '';
			grid-area: 1 / 1 / 2 / -1;
			margin: -4px;
			border-radius: var(--radius-pill);
			background: var(--slate-100);
		}

		/* Es un elemento y no un pseudo para que axe vea su fondo detrás del texto del elegido. */
		.sel__pildora {
			grid-area: 1 / 1 / 2 / -1;
			border-radius: var(--radius-pill);
			width: calc(100% / 3);
			background: var(--brand-primary-deep);
			box-shadow: var(--shadow-elevada);
			translate: calc(var(--activa) * 100%) 0;
			transition: translate 300ms var(--curva-cajon);
			pointer-events: none;
		}

		.sel {
			display: contents;
		}

		.sel__boton {
			grid-row: 1;
			grid-column: var(--n);
			flex-direction: column;
			justify-content: center;
			gap: 2px;
			min-height: 56px;
			padding: 4px;
			border-radius: var(--radius-pill);
			color: var(--text-body-dark);
			font-size: min(var(--type-meta-size), 4.4vw);
			overflow-wrap: normal;
			text-align: center;
			transition:
				background-color 200ms var(--curva-salida),
				color 200ms var(--curva-salida);
		}

		.sel__boton[aria-pressed='true'] {
			color: var(--off-white);
		}

		.sel__boton:active:not([aria-pressed='true']) {
			background: var(--slate-200);
		}

		.sel__boton :global(.sel__icono) {
			width: 24px;
			height: 24px;
		}

		.sel__momento {
			display: none;
		}

		.sel__texto {
			grid-area: 2 / 1 / 3 / -1;
			margin-top: var(--space-3);
			transition: opacity 200ms var(--curva-salida);
		}

		.selector[data-listo] .sel:not([data-activa]) .sel__texto {
			opacity: 0;
			visibility: hidden;
		}

		/* Sin JS los botones no hacen nada: no se muestran y los tres textos van uno debajo del otro. */
		.selector:not([data-listo]) .selector__lista::before,
		.selector:not([data-listo]) :is(.sel__pildora, .sel__boton) {
			display: none;
		}

		.selector:not([data-listo]) .sel__texto {
			grid-area: auto / 1 / auto / -1;
			margin-top: var(--space-1);
		}
	}

	@media (min-width: 768px) {
		.sel__pildora {
			display: none;
		}

		.selector__lista {
			gap: var(--space-2);
		}

		.sel {
			padding: var(--space-2);
			border: 1px solid var(--border-light);
			border-radius: var(--radius-badge);
			cursor: pointer;
			transition:
				background-color 200ms var(--curva-salida),
				border-color 200ms var(--curva-salida);
		}

		.sel[data-activa] {
			background: var(--blue-50);
			border-color: var(--blue-200);
		}

		.sel__boton {
			gap: var(--space-1);
			width: 100%;
			min-height: 48px;
			padding: 0;
			font-size: var(--type-cuerpo-size);
			text-align: start;
		}

		.sel__texto {
			margin-top: var(--space-1);
		}

		/* El foco es el de la card entera (con su radio), no un rectángulo que pisa el texto. */
		.sel__boton:focus-visible {
			outline: none;
		}

		.sel:has(.sel__boton:focus-visible) {
			outline: 3px solid var(--brand-primary-deep);
			outline-offset: 3px;
		}

		/* Al tocar: solo cambia el fondo (sin escala, regla de la marca). */
		.sel:has(.sel__boton:active):not([data-activa]) {
			background: var(--slate-100);
		}

		.sel__boton[aria-pressed='true'] {
			color: var(--blue-900);
		}

		/* El ícono va en un círculo de 48 px: gris apagado y, en el elegido, azul con el ícono claro. */
		.sel__boton :global(.sel__icono) {
			box-sizing: border-box;
			width: 48px;
			height: 48px;
			padding: var(--space-1);
			border-radius: 50%;
			background: var(--slate-100);
			color: var(--text-muted-dark);
			transition:
				background-color 200ms var(--curva-salida),
				color 200ms var(--curva-salida);
		}

		.sel[data-activa] .sel__boton :global(.sel__icono) {
			background: var(--brand-primary-deep);
			color: var(--off-white);
		}

		.sel__corto {
			display: none;
		}
	}

	/* Tablet: tres cards angostas; el ícono va arriba y la etiqueta entera en una línea, igual en las tres. */
	@media (min-width: 768px) and (max-width: 1023.98px) {
		.sel__boton {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	@media (min-width: 1024px) {
		.selector__lista {
			grid-template-columns: 1fr;
			gap: var(--space-1);
		}

		/* La flecha aparece solo en el elegido y apunta al escenario. */
		.sel__boton :global(.sel__flecha) {
			display: block;
			flex: none;
			margin-left: auto;
			color: var(--brand-primary-deep);
			opacity: 0;
			transition: opacity 200ms var(--curva-salida);
		}

		.sel[data-activa] .sel__boton :global(.sel__flecha) {
			opacity: 1;
		}
	}

	@media (min-width: 768px) and (hover: hover) and (pointer: fine) {
		.sel:hover:not([data-activa]) {
			border-color: var(--slate-300);
		}

		.sel:hover:not([data-activa]) .sel__boton {
			color: var(--brand-primary-deep);
		}

		.sel:hover:not([data-activa]) .sel__boton :global(.sel__icono) {
			background: var(--blue-50);
			color: var(--brand-primary-deep);
		}
	}
</style>
