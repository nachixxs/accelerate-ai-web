---
// El selector de pantallas de #trabajo: trae un celular al frente del escenario (el que lo mueve es
// scripts/trabajo-escenario.ts). Tres botones con aria-pressed. En el celular, control segmentado y el
// texto del momento elegido debajo; desde 768, cada momento con su texto, siempre visible.
import Icono from '../Icono.astro';
import { pantallas } from './pantallas';
---

<div class="selector" data-selector role="group" aria-label="Elegí qué pantalla de la app ver">
	<ul class="selector__lista">
		{
			pantallas.map((p, i) => (
				<li class="sel" data-sel={p.id} data-activa={p.pose === 'frente' ? '' : undefined} style={`--n:${i + 1}`}>
					<button type="button" class="sel__boton" aria-pressed={p.pose === 'frente' ? 'true' : 'false'}>
						<Icono nombre={p.icono} size={32} class="sel__icono" />
						<span class="sel__corto">{p.corto}</span>
						<span class="sel__momento">{p.momento}</span>
					</button>
					<p class="sel__texto"><strong>{p.nombre}.</strong> {p.texto}</p>
				</li>
			))
		}
	</ul>
</div>

<style>
	.selector {
		grid-area: selector;
		margin-top: var(--space-4);
	}

	.selector__lista {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.sel__boton {
		position: relative;
		display: flex;
		align-items: center;
		min-width: 0;
		border: 2px solid transparent;
		background: transparent;
		color: var(--text-heading-dark);
		font: inherit;
		font-weight: var(--fw-semibold);
		cursor: pointer;
	}

	.sel__boton :global(.sel__icono) {
		flex: none;
	}

	.sel__texto {
		color: var(--text-body-dark);
		font-size: var(--type-meta-size);
	}

	.sel__texto strong {
		color: var(--text-heading-dark);
	}

	@media (forced-colors: active) {
		.sel__boton[aria-pressed='true'] {
			border-color: ButtonText;
		}
	}

	/* Celular: ícono arriba y nombre corto; los tres textos comparten la celda de abajo, así que el
	   alto no salta al cambiar. */
	@media (max-width: 767.98px) {
		.selector__lista::before {
			content: '';
			grid-area: 1 / 1 / 2 / -1;
			margin: -4px;
			border-radius: var(--radius-pill);
			background: var(--slate-100);
		}

		.sel {
			display: contents;
		}

		.sel__boton {
			grid-row: 1;
			grid-column: var(--n);
			flex-direction: column;
			justify-content: center;
			gap: 2px;
			min-height: 56px;
			padding: 4px;
			border-radius: var(--radius-pill);
			color: var(--text-body-dark);
			font-size: 0.875rem;
			text-align: center;
			overflow-wrap: anywhere;
			transition:
				background-color 200ms var(--curva-salida),
				color 200ms var(--curva-salida);
		}

		.sel__boton[aria-pressed='true'] {
			background: var(--brand-primary-deep);
			color: var(--off-white);
			box-shadow: var(--shadow-elevada);
		}

		.sel__boton :global(.sel__icono) {
			width: 24px;
			height: 24px;
		}

		.sel__momento {
			display: none;
		}

		.sel__texto {
			grid-area: 2 / 1 / 3 / -1;
			margin-top: var(--space-3);
			transition: opacity 200ms var(--curva-salida);
		}

		.sel:not([data-activa]) .sel__texto {
			opacity: 0;
			visibility: hidden;
		}
	}

	@media (min-width: 768px) {
		.selector {
			margin-top: var(--space-5);
		}

		.selector__lista {
			gap: var(--space-2);
		}

		.sel {
			padding: var(--space-2);
			border-radius: var(--radius-badge);
			cursor: pointer;
			transition: background-color 200ms var(--curva-salida);
		}

		.sel[data-activa] {
			background: var(--blue-50);
		}

		.sel__boton {
			gap: var(--space-1);
			width: 100%;
			min-height: 48px;
			padding: 0;
			font-size: 1.0625rem;
		}

		.sel__boton[aria-pressed='true'] {
			color: var(--blue-900);
		}

		.sel__boton :global(.sel__icono) {
			width: 32px;
			height: 32px;
			color: var(--brand-primary-deep);
		}

		.sel__corto {
			display: none;
		}
	}

	@media (min-width: 1024px) {
		.selector__lista {
			grid-template-columns: 1fr;
			gap: var(--space-1);
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.sel:hover:not([data-activa]) {
			background: var(--slate-100);
		}
	}
</style>
