---
// La conversación de ejemplo de #trabajo: la pregunta del dueño y la respuesta del asistente. Va en el
// flujo del escenario: la pregunta apoya en el bisel de abajo del celular del frente (no tapa la
// pantalla) y la respuesta cruza 48 px el borde de abajo del escenario. En `respuesta`, lo que va entre
// [ ] es la frase clave y sale en negrita (el texto que lee el lector de pantalla no cambia). El texto completo está siempre en el DOM (las palabras son <span>): el alto está
// reservado y el lector de pantalla lee el párrafo entero. El script (trabajo-escenario.ts) la arma
// con .en en cada pieza; sin JS o con movimiento reducido queda completa y quieta.
import Icono from '../Icono.astro';

interface Props {
	pregunta: string;
	respuesta: string;
}
const { pregunta, respuesta } = Astro.props;
let negrita = false;
const palabras = respuesta.split(' ').map((w) => {
	if (w.startsWith('[')) negrita = true;
	const pieza = { t: w.replace(/[[\]]/g, ''), clave: negrita };
	if (w.endsWith(']')) negrita = false;
	return pieza;
});
---

<div class="conv" data-conv role="group" aria-label="Ejemplo de conversación con el asistente">
	<p class="preg" data-preg><span class="solo-lector">Pregunta del dueño: </span>{pregunta}</p>
	<div class="escribiendo" data-escribiendo aria-hidden="true">
		<span style="--i:0"></span><span style="--i:1"></span><span style="--i:2"></span>
	</div>
	<div class="resp" data-resp>
		<p class="resp__rotulo"><Icono nombre="sparkle-duotone" size={20} />Ejemplo de respuesta</p>
		<p class="resp__texto">
			{palabras.map((w, n) => (<><span class:list={['w', { clave: w.clave }]} style={`--w:${n}`}>{w.t}</span>{' '}</>))}
		</p>
	</div>
</div>

<style>
	.conv {
		grid-row: 2;
		position: relative;
		z-index: 3;
		display: grid;
		gap: var(--space-1);
		width: min(86cqw, 340px);
		margin: calc(var(--f) * -0.045 + var(--space-1)) 0 calc(var(--space-5) * -1);
		transform: translate3d(0, 0, var(--zc));
		transition:
			opacity 200ms var(--curva-salida),
			transform 200ms var(--curva-salida);
	}

	@media (min-width: 768px) {
		.conv {
			justify-self: end;
			margin-right: 6cqw;
		}
	}

	/* Es del asistente: si el que está al frente es otro, se va y vuelve igual. */
	:global(.escenario:not([data-frente='asistente'])) .conv {
		opacity: 0;
		transform: translate3d(0, 8px, var(--zc));
		pointer-events: none;
	}

	.preg,
	.resp,
	.escribiendo {
		background: var(--off-white);
		color: var(--text-heading-dark);
	}

	.preg {
		justify-self: end;
		padding: 12px var(--space-2); /* 12 = 8 + 4: ajuste óptico de la burbuja */
		border-radius: 22px 22px 6px 22px;
		background: var(--brand-accent); /* cian = lo que no cuadra, el hilo con los 32 de la barra */
		color: var(--navy-950);
		font-size: 0.9375rem;
		font-weight: var(--fw-bold);
		line-height: 1.35;
		box-shadow: var(--shadow-elevada-oscura);
		transform-origin: 100% 100%;
	}

	.resp {
		grid-area: 2 / 1;
		padding: var(--space-2) var(--space-2) var(--space-3);
		border-radius: 22px 22px 22px 6px;
		box-shadow: var(--shadow-card-oscura);
		transform-origin: 0 0;
	}

	.resp__rotulo {
		display: flex;
		align-items: center;
		gap: 4px;
		margin-bottom: var(--space-1);
		color: var(--brand-primary-deep);
		font-size: var(--type-meta-size);
		font-weight: var(--fw-bold);
	}

	.resp__texto {
		font-size: 0.9375rem;
		line-height: 1.45;
	}

	.clave {
		color: var(--brand-primary-deep);
		font-weight: var(--fw-bold);
	}

	/* "Escribiendo": tres puntos, una sola pasada, en el lugar de la respuesta. Invisible al final. */
	.escribiendo {
		grid-area: 2 / 1;
		justify-self: start;
		align-self: start;
		display: flex;
		gap: var(--space-1);
		padding: 12px var(--space-2); /* 12 = 8 + 4: ajuste óptico de la burbuja */
		border-radius: 22px 22px 22px 6px;
		box-shadow: var(--shadow-elevada-oscura);
		opacity: 0;
		pointer-events: none;
		transition: opacity 120ms var(--curva-salida);
	}

	.escribiendo span {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--text-muted-dark);
	}

	@keyframes punto {
		from { opacity: 0.25; }
	}

	/* Armado por el script: cada pieza entra cuando recibe .en. */
	.conv[data-habla] .preg,
	.conv[data-habla] .resp {
		opacity: 0;
		transform: translateY(12px) scale(0.96);
	}

	.conv[data-habla] .preg.en,
	.conv[data-habla] .resp.en {
		opacity: 1;
		transform: none;
		transition:
			opacity 300ms var(--curva-salida),
			transform 300ms var(--curva-salida);
	}

	.conv[data-habla] .escribiendo.en {
		opacity: 1;
	}

	.conv[data-habla] .escribiendo.en span {
		animation: punto 360ms var(--curva-salida) both;
		animation-delay: calc(var(--i) * 120ms);
	}

	.conv[data-habla] .w {
		opacity: 0;
	}

	.conv[data-habla] .resp.en .w {
		opacity: 1;
		transition: opacity 160ms var(--curva-salida) calc(100ms + var(--w) * var(--pw, 35ms));
	}

	@media (forced-colors: active) {
		.preg,
		.resp,
		.escribiendo {
			border: 1px solid CanvasText;
		}
	}

	/* Movimiento reducido: al cambiar de celular se va con un fundido, sin desplazarse. */
	@media (prefers-reduced-motion: reduce) {
		:global(.escenario:not([data-frente='asistente'])) .conv {
			transform: translate3d(0, 0, var(--zc));
		}
	}
</style>
