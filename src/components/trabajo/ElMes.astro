---
// "El mes de prueba": la cifra en primer plano. El número de movimientos, enorme, y al lado un campo
// con una marca por movimiento que se llena mientras el número cuenta (un solo bucle, en
// scripts/trabajo-mes.ts); debajo, una barra con una marca por arqueo: las marcas viajan del campo a la
// barra y los que no cuadraron pasan a cian. Todo sale del objeto `mes` de PrimerTrabajo. Sin JS o con
// movimiento reducido: el valor final; sin JS, además, una textura de puntos y una barra de CSS con las
// 104 marcas y las 32 con diferencia en cian.
interface Props {
	mes: { dias: number; movimientos: number; arqueos: number; conDiferencia: number };
}
const { mes } = Astro.props;
const f = (n: number) => n.toLocaleString('es-AR');
const porDia = new Intl.NumberFormat('es-AR', { maximumFractionDigits: 1 }).format(mes.movimientos / mes.dias);
const ok = (((mes.arqueos - mes.conDiferencia) / mes.arqueos) * 100).toFixed(3);
---

<div class="mes" data-mes data-movimientos={mes.movimientos} data-arqueos={mes.arqueos} data-dif={mes.conDiferencia}>
	<h3 class="mes__titulo t-label">El mes de prueba</h3>

	<div class="mes__num">
		<p class="mes__gigante" aria-hidden="true" data-numero data-final={f(mes.movimientos)}>{f(mes.movimientos)}</p>
		<p class="mes__rotulo"><span class="solo-lector">{f(mes.movimientos)} </span>movimientos cargados en un mes simulado, {porDia} por día en promedio</p>
		<p class="mes__fuente">Un mes simulado con datos de prueba</p>
	</div>

	<div class="mes__campo">
		<canvas class="mes__lienzo mes__lienzo--campo" aria-hidden="true" data-campo></canvas>
		<p class="mes__nota">Cada marca es un movimiento. El orden no representa días ni horas.</p>
	</div>

	<p class="mes__datos">
		<span>{mes.dias} días ·</span> <span>{mes.arqueos} arqueos</span>
	</p>

	<div class="mes__arqueos">
		<canvas class="mes__lienzo mes__lienzo--barra" aria-hidden="true" data-barra style={`--n:${mes.arqueos};--ok:${ok}%`}></canvas>
		<p class="mes__leyenda">
			<span class="mes__ok">Arqueo que cuadró</span>
			<span class="mes__dif">Arqueo con diferencia: <span aria-hidden="true" data-dif-n>{mes.conDiferencia}</span><span class="solo-lector">{mes.conDiferencia}</span></span>
		</p>
	</div>
</div>

<style>
	/* En el celular, todo apilado; desde 768, el número a la izquierda y las marcas a la derecha. */
	.mes {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-3);
		margin-top: var(--space-6);
	}

	.mes__titulo {
		font-weight: var(--fw-semibold);
	}

	/* 72 px a 360 de ancho, 176 px a 1280; nunca más de 24vw (con la letra al 200 % no se corta el 3). */
	.mes__gigante {
		margin: 0;
		color: var(--text-heading-dark);
		font-size: min(clamp(4.5rem, 1.96rem + 11.3vw, 11rem), 24vw);
		font-weight: var(--fw-black);
		line-height: 0.95;
		letter-spacing: -0.04em;
		font-variant-numeric: tabular-nums;
	}

	/* Reserva el ancho del valor final: mientras cuenta, nada se corre. */
	.mes__gigante::after {
		content: attr(data-final);
		display: block;
		height: 0;
		overflow: hidden;
		visibility: hidden;
	}

	.mes__rotulo {
		max-width: 30ch;
		margin: var(--space-1) 0 0;
		color: var(--text-body-dark);
		font-size: var(--type-cuerpo-size);
		font-weight: var(--fw-medium);
		line-height: 1.3;
		text-wrap: balance;
	}

	.mes__lienzo {
		display: block;
		width: 100%;
	}

	/* Los colores de las marcas los lee el script de acá: cada lienzo, los suyos. */
	.mes__lienzo--campo {
		--marca: var(--blue-300);
		--marca-nueva: var(--brand-primary-deep); /* la tinta fresca de la marca que acaba de nacer */
	}

	.mes__lienzo--barra {
		--marca: var(--slate-400);
		--marca-dif: var(--cyan-600);
	}

	/* Sin JavaScript el lienzo queda en blanco: una textura de puntos ocupa su lugar en el campo y, en la
	   barra, las 104 marcas exactas (máscara) con las que no cuadraron en cian y más altas. */
	.mes__lienzo:not(.listo) {
		min-height: 192px;
		background: radial-gradient(circle, var(--blue-300) 2px, transparent 2.5px) 0 0 / 8px 8px;
	}

	.mes__lienzo--barra:not(.listo) {
		min-height: 24px;
		background:
			linear-gradient(var(--slate-400), var(--slate-400)) 0 100% / var(--ok) 16px no-repeat,
			linear-gradient(var(--cyan-600), var(--cyan-600)) 100% 0 / calc(100% - var(--ok)) 100% no-repeat;
		-webkit-mask-image: repeating-linear-gradient(90deg, #000 0 calc(50% / var(--n)), transparent 0 calc(100% / var(--n)));
		mask-image: repeating-linear-gradient(90deg, #000 0 calc(50% / var(--n)), transparent 0 calc(100% / var(--n)));
	}

	/* Con JS el lienzo se estira solo al alto que calcula el script: sin altos mínimos de la versión sin JS. */
	.mes__lienzo.listo {
		min-height: 0;
	}

	/* Sin el lienzo armado no hay 1.703 marcas: la nota no tiene de qué hablar. */
	.mes__campo:has(.mes__lienzo:not(.listo)) .mes__nota {
		display: none;
	}

	.mes__nota,
	.mes__fuente,
	.mes__leyenda {
		margin: var(--space-1) 0 0;
		color: var(--text-muted-dark);
		font-size: var(--type-meta-size);
	}

	/* Cada dato va entero: si no entran en una línea, corta entre uno y otro (flex-wrap); adentro solo
	   si uno solo no entra en el ancho, como con la letra al 200 %. */
	.mes__datos {
		display: flex;
		flex-wrap: wrap;
		gap: 0 var(--space-1);
		margin: 0;
		color: var(--text-heading-dark);
		font-size: var(--type-label-size);
		font-weight: var(--fw-bold);
		letter-spacing: -0.01em;
		line-height: var(--type-label-lh);
		font-variant-numeric: tabular-nums;
	}

	.mes__leyenda {
		display: flex;
		flex-wrap: wrap;
		gap: 4px var(--space-3);
	}

	.mes__leyenda > span {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
	}

	.mes__leyenda > span::before {
		content: '';
		width: 4px;
		height: 12px;
		background: var(--slate-400);
	}

	.mes__leyenda .mes__dif {
		color: var(--text-heading-dark);
		font-weight: var(--fw-semibold);
	}

	.mes__leyenda .mes__dif::before {
		height: 16px;
		background: var(--cyan-600);
	}

	/* La cuenta del 32 corre a la par del tinte: ancho fijo para que la leyenda no se mueva. */
	[data-dif-n] {
		min-width: 2ch;
		font-variant-numeric: tabular-nums;
	}

	@media (forced-colors: active) {
		.mes__leyenda > span::before {
			forced-color-adjust: none;
			background: CanvasText;
		}

		.mes__leyenda .mes__dif::before {
			background: Highlight;
		}
	}

	@media (min-width: 768px) {
		.mes {
			grid-template-columns: auto minmax(0, 1fr);
			grid-template-areas: 'titulo titulo' 'num campo' 'datos arqueos';
			column-gap: var(--space-5);
			row-gap: var(--space-4);
			align-items: start;
		}

		.mes__titulo {
			grid-area: titulo;
		}

		.mes__num {
			grid-area: num;
		}

		.mes__campo {
			grid-area: campo;
			align-self: end;
		}

		/* contain: el largo de la línea no ensancha la columna del número; parte entre ítems. */
		.mes__datos {
			grid-area: datos;
			align-self: center;
			contain: inline-size;
		}

		.mes__arqueos {
			grid-area: arqueos;
			align-self: center;
		}
	}

	@media (min-width: 1024px) {
		.mes {
			column-gap: var(--space-6);
		}
	}
</style>

<script>
	import { elMes } from '../../scripts/trabajo-mes';

	const raiz = document.querySelector<HTMLElement>('[data-mes]');
	if (raiz) elMes(raiz);
</script>
