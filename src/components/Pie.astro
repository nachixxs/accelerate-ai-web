---
// El pie, fuera de <main> para que siga siendo el landmark del pie. Mismo fondo oscuro que la
// sección de cierre, así se leen como un solo bloque; los separa la estela: las tres capas de
// velocidad de la A (atrás, medio, frente), cortadas en diagonal como en el isotipo, que se
// descubren con el scroll una detrás de la otra (clip-path).
// Tres columnas: la marca (imagotipo chico + frase), las secciones y el contacto. Lo último de
// la página es la línea legal: nada va debajo.
import { Image } from 'astro:assets';
// El contacto, como en minificando: una línea discreta por canal (ícono, canal y dato), no un
// número grande. WhatsApp primero porque es el canal principal; después el mail de cada socio.
import Icono from './Icono.astro';
import imagotipo from '../assets/identidad/imagotipo-claro.png';
import { EMAILS, WHATSAPP_NUMERO_VISIBLE, WHATSAPP_URL } from '../config';

const contactos = [
	{ icono: 'si:whatsapp', canal: 'WhatsApp', dato: WHATSAPP_NUMERO_VISIBLE, href: WHATSAPP_URL, externo: true },
	...EMAILS.map(({ nombre, email }) => ({ icono: 'envelope-simple-duotone', canal: nombre, dato: email, href: `mailto:${email}`, externo: false })),
];

const anio = new Date().getFullYear();

const links = [
	{ href: '#resolvemos', texto: 'Qué resolvemos' },
	{ href: '#sistemas', texto: 'Qué armamos' },
	{ href: '#proceso', texto: 'Cómo trabajamos' },
	{ href: '#somos', texto: 'Quiénes somos' },
	{ href: '#preguntas', texto: 'Preguntas' },
];
---

<footer class="seccion--oscura pie">
	<div class="pie__estela" aria-hidden="true"><span></span><span></span><span></span></div>

	<div class="contenedor">
		<div class="pie__grilla">
			<div class="pie__bloque pie__marca" style="--i: 0">
				<Image src={imagotipo} alt="Accelerate.ai" width={352} class="pie__logo" />
				<p>Sistemas a medida para pymes que repiten tareas todos los días.</p>
			</div>

			<nav class="pie__bloque" aria-label="Secciones del sitio" style="--i: 1">
				<h2 class="pie__titulo">Secciones</h2>
				<ul class="pie__links">
					{links.map(({ href, texto }) => <li><a class="pie__link" href={href}>{texto}</a></li>)}
				</ul>
			</nav>

			<div class="pie__bloque" style="--i: 2">
				<h2 class="pie__titulo">Contacto</h2>
				<ul class="pie__contactos">
					{
						contactos.map(({ icono, canal, dato, href, externo }) => (
							<li>
								<a class="pie__contacto" href={href} target={externo ? '_blank' : undefined} rel={externo ? 'noopener' : undefined}>
									<span class="pie__contacto-icono">
										<Icono nombre={icono} size={18} />
									</span>
									<span class="pie__contacto-texto">
										<span class="pie__contacto-canal">{canal}</span>
										<span class="pie__contacto-dato" translate="no">{dato}</span>
									</span>
									{externo && <span class="solo-lector"> (abre WhatsApp)</span>}
								</a>
							</li>
						))
					}
				</ul>
				{/* TODO: links a las redes. Faltan las URL (REVISION-TEXTOS.md). */}
			</div>
		</div>

		<div class="pie__base">
			<p class="pie__legal">© {anio} <span translate="no">Accelerate.ai</span>. Todos los derechos reservados.</p>
			<a class="pie__arriba" href="#inicio">
				Volver arriba
				<Icono nombre="arrow-up-bold" size={18} />
			</a>
		</div>
	</div>
</footer>

<style>
	.pie {
		color: var(--text-muted-light);
		view-timeline: --pie block;
	}

	/* La estela: tres líneas con los colores de las capas de la A sobre oscuro. */
	.pie__estela {
		display: grid;
		gap: 3px;
	}

	/* Cada capa termina en diagonal, con la inclinación de la A. */
	.pie__estela span {
		height: 4px;
		clip-path: polygon(0 0, 100% 0, calc(100% - 8px) 100%, 0 100%);
	}

	/* Escalonadas como la estela de la A: la de atrás cruza todo el ancho, las de adelante se
	   quedan más cortas. */
	.pie__estela span:nth-child(1) { background: var(--mark-back-on-dark); }
	.pie__estela span:nth-child(2) { width: 72%; background: var(--mark-mid-on-dark); }
	.pie__estela span:nth-child(3) { width: 44%; background: var(--mark-front-on-dark); }

	.pie__grilla {
		display: grid;
		gap: var(--space-5);
		padding-block: var(--space-6) var(--space-5);
	}

	.pie__bloque {
		display: grid;
		align-content: start;
		gap: var(--space-2);
	}

	.pie__marca p {
		max-width: 22ch;
		color: var(--text-heading-light);
		font-size: var(--type-label-size);
		font-weight: var(--fw-semibold);
		line-height: 1.25;
	}

	/* El imagotipo en tamaño normal, alineado a la izquierda con el resto de la columna. */
	.pie__logo {
		display: block;
		width: 140px;
		height: auto;
		margin-bottom: var(--space-1);
	}

	/* Título de columna y links al mismo tamaño chico: el título se distingue por peso y color, y
	   los links no le ganan en jerarquía (antes iban a tamaño de párrafo). */
	.pie__titulo {
		color: var(--text-heading-light);
		font-size: var(--type-meta-size);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.01em;
	}

	/* En el celular, los links en dos columnas: la lista no se vuelve una torre. */
	.pie__links {
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: var(--space-2);
	}

	/* El subrayado crece desde la izquierda con el mouse: la misma dirección que la estela. */
	.pie__link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		background: linear-gradient(var(--cyan-300), var(--cyan-300)) no-repeat 0 calc(50% + 0.8em) / 0% 1px;
		color: var(--text-body-light);
		font-size: var(--type-meta-size);
		transition: color 0.2s, background-size 0.25s var(--curva-salida);
	}

	/* Feedback al apretar: cambia de color rápido; al soltar, vuelve con la transición de arriba
	   (0.2s), más lenta que la de presionar. */
	.pie__link:active {
		color: var(--cyan-300);
		transition: color 0.12s var(--curva-salida);
	}

	.pie__contactos {
		display: grid;
		gap: var(--space-1);
	}

	/* Una fila por canal: el ícono en un recuadro fino, el canal chico arriba y el dato abajo. */
	.pie__contacto {
		display: flex;
		align-items: center;
		gap: 12px;
		min-height: 44px;
	}

	.pie__contacto-icono {
		display: grid;
		flex: none;
		place-items: center;
		width: 40px;
		height: 40px;
		border: 1px solid var(--border-dark);
		border-radius: 12px;
		color: var(--cyan-300);
		transition: border-color 0.2s;
	}

	/* Feedback al apretar, igual que el hover pero más rápido: al soltar vuelve con la transición
	   de reposo de cada elemento (0.2s), más lenta que la de presionar (0.12s). */
	.pie__contacto:active .pie__contacto-icono {
		border-color: var(--cyan-300);
		transition: border-color 0.12s var(--curva-salida);
	}

	.pie__contacto:active .pie__contacto-dato {
		color: var(--text-heading-light);
		transition: color 0.12s var(--curva-salida);
	}

	.pie__contacto-texto {
		display: grid;
		min-width: 0;
		line-height: 1.35;
	}

	.pie__contacto-canal {
		color: var(--text-muted-light);
		font-size: 0.8125rem;
	}

	.pie__contacto-dato {
		color: var(--text-body-light);
		font-size: var(--type-meta-size);
		font-variant-numeric: tabular-nums;
		overflow-wrap: anywhere;
		transition: color 0.2s;
	}

	/* En una columna angosta, la fila no entra entera: apilada, con "Volver arriba" arriba, así el
	   © queda siempre como lo último visible de la página (nunca al revés). */
	.pie__base {
		display: flex;
		flex-direction: column-reverse;
		align-items: flex-start;
		gap: var(--space-2);
		padding-block: var(--space-2) var(--space-5);
		border-top: 1px solid var(--border-dark);
	}

	.pie__legal {
		color: var(--text-muted-light);
		font-size: var(--type-meta-size);
	}

	.pie__arriba {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		min-height: 44px;
		padding-inline: var(--space-2);
		border: 1px solid var(--border-dark);
		border-radius: var(--radius-pill);
		color: var(--text-heading-light);
		font-size: var(--type-meta-size);
		font-weight: var(--fw-semibold);
		transition: border-color 0.2s, scale 0.2s var(--curva-salida);
	}

	/* Feedback al apretar: se achica y al soltar vuelve con la transición de arriba (0.2s), más
	   lenta que la de presionar (0.12s). */
	.pie__arriba:active {
		scale: 0.97;
		transition: scale 0.12s var(--curva-salida);
	}

	.pie__arriba :global(svg) {
		color: var(--cyan-300);
		transition: transform 0.2s var(--curva-salida);
	}

	@media (hover: hover) and (pointer: fine) {
		.pie__link:hover {
			background-size: 100% 1px;
			color: var(--text-heading-light);
		}

		.pie__contacto:hover .pie__contacto-icono {
			border-color: var(--cyan-300);
		}

		.pie__contacto:hover .pie__contacto-dato {
			color: var(--text-heading-light);
		}

		.pie__arriba:hover {
			border-color: var(--cyan-300);
		}
	}

	@media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
		.pie__arriba:hover :global(svg) {
			transform: translateY(-3px);
		}
	}

	/* El anillo (cian) sale de .seccion--oscura; acá solo se redondea. */
	.pie :is(.pie__link, .pie__contacto):focus-visible {
		border-radius: 4px;
	}

	/* Entre 768 y 1023 el mail no entra en una columna de 1.25fr (queda "…gmail.co" / "m"): 2
	   columnas, con la marca a lo ancho arriba y secciones + contacto abajo. Las 3 columnas una
	   al lado de la otra recién entran desde 1024. */
	@media (min-width: 768px) {
		.pie__grilla {
			grid-template-columns: 1fr 1fr;
			gap: var(--space-4);
		}

		.pie__marca {
			grid-column: 1 / -1;
		}

		.pie__links {
			grid-template-columns: 1fr;
		}

		/* Alineados por abajo: el botón es más alto que la línea de texto (padding, borde), y
		   centrado dejaría su base por debajo del ©. Así el © queda siempre lo último. */
		.pie__base {
			flex-direction: row;
			align-items: flex-end;
			justify-content: space-between;
		}
	}

	@media (min-width: 1024px) {
		.pie__grilla {
			grid-template-columns: minmax(0, 5fr) minmax(0, 3fr) minmax(0, 4fr);
		}

		.pie__marca {
			grid-column: auto;
		}
	}

	@keyframes pie-estela {
		from { clip-path: polygon(0 0, 0 0, -8px 100%, 0 100%); }
		to { clip-path: polygon(0 0, 100% 0, calc(100% - 8px) 100%, 0 100%); }
	}

	/* El pie es lo último de la página: los tramos terminan antes de que termine de entrar, así
	   se completan aunque no haya más scroll. */
	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			.pie__estela span {
				animation: pie-estela var(--curva-salida) both;
				animation-timeline: --pie;
			}

			.pie__estela span:nth-child(1) { animation-range: entry 0% entry 30%; }
			.pie__estela span:nth-child(2) { animation-range: entry 5% entry 38%; }
			.pie__estela span:nth-child(3) { animation-range: entry 10% entry 46%; }

			.pie__bloque {
				animation: entrar-subiendo linear both;
				animation-timeline: --pie;
				animation-range: entry calc(20% + var(--i) * 12%) entry calc(55% + var(--i) * 12%);
			}

			/* Tab puede llevar el foco a un link antes de que su bloque termine de entrar (el
			   navegador sólo scrollea lo mínimo): con el foco adentro, se ve entero. */
			.pie__bloque:focus-within {
				animation: none;
			}
		}
	}
</style>
