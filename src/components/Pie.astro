---
// El pie, fuera de <main> para que siga siendo el landmark del pie. Mismo fondo oscuro
// que la sección de cierre, así se leen como un solo bloque.
import { Image } from 'astro:assets';
import logotipo from '../assets/identidad/logotipo-claro.png';
---

<footer class="seccion--oscura">
	<div class="contenedor">
		<div class="pie">
			<Image src={logotipo} alt="Accelerate.ai" width={128} class="pie__logo" />
			{/* TODO: links a las redes. Faltan las URL (REVISION-TEXTOS.md). */}
			<p class="t-meta">© 2026 Accelerate.ai</p>
		</div>
	</div>
</footer>

<style>
	.pie {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
		padding-block: var(--space-4);
		border-top: 1px solid var(--border-dark);
		color: var(--text-muted-light);
	}

	.pie__logo {
		width: 128px;
		height: auto;
	}
</style>
