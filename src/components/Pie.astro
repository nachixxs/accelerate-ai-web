---
// El pie, fuera de <main> para que siga siendo el landmark del pie. Mismo fondo oscuro que la
// sección de cierre, así se leen como un solo bloque; los separa la estela: las tres capas de
// velocidad de la A (atrás, medio, frente) que cruzan el ancho con el scroll, una detrás de
// la otra, como arranca el isotipo.
// Tres columnas: la marca, las secciones y el contacto. El imagotipo va a 200-232 px, como en el
// encabezado: los 280 px de mínimo de la marca son sobre el lienzo de 1080 (ver Encabezado.astro).
import { Image } from 'astro:assets';
// El contacto, como en minificando: una línea discreta por canal (ícono, canal y dato), no un
// número grande. WhatsApp primero porque es el canal principal; después el mail de cada socio.
import Icono from './Icono.astro';
import imagotipo from '../assets/identidad/imagotipo-claro.png';
import { EMAILS, WHATSAPP_NUMERO_VISIBLE, WHATSAPP_URL } from '../config';

const contactos = [
	{ icono: 'si:whatsapp', canal: 'WhatsApp', dato: WHATSAPP_NUMERO_VISIBLE, href: WHATSAPP_URL, externo: true },
	...EMAILS.map(({ nombre, email }) => ({ icono: 'envelope-simple-duotone', canal: nombre, dato: email, href: `mailto:${email}`, externo: false })),
];

const anio = new Date().getFullYear();

const links = [
	{ href: '#resolvemos', texto: 'Qué resolvemos' },
	{ href: '#sistemas', texto: 'Qué armamos' },
	{ href: '#proceso', texto: 'Cómo trabajamos' },
	{ href: '#somos', texto: 'Quiénes somos' },
	{ href: '#preguntas', texto: 'Preguntas' },
];
---

<footer class="seccion--oscura pie">
	<div class="pie__estela" aria-hidden="true"><span></span><span></span><span></span></div>

	<div class="contenedor">
		<div class="pie__grilla">
			<div class="pie__bloque pie__marca" style="--i: 0">
				<Image src={imagotipo} alt="Accelerate.ai" width={464} class="pie__logo" />
				<p>Sistemas a medida para pymes que repiten tareas todos los días.</p>
			</div>

			<nav class="pie__bloque" aria-labelledby="pie-secciones" style="--i: 1">
				<h2 id="pie-secciones" class="pie__titulo">Secciones</h2>
				<ul class="pie__links">
					{links.map(({ href, texto }) => <li><a class="pie__link" href={href}>{texto}</a></li>)}
				</ul>
			</nav>

			<div class="pie__bloque" style="--i: 2">
				<h2 class="pie__titulo">Contacto</h2>
				<ul class="pie__contactos">
					{
						contactos.map(({ icono, canal, dato, href, externo }) => (
							<li>
								<a class="pie__contacto" href={href} target={externo ? '_blank' : undefined} rel={externo ? 'noopener' : undefined}>
									<span class="pie__contacto-icono">
										<Icono nombre={icono} size={18} />
									</span>
									<span class="pie__contacto-texto">
										<span class="pie__contacto-canal">{canal}</span>
										<span class="pie__contacto-dato">{dato}</span>
									</span>
								</a>
							</li>
						))
					}
				</ul>
				{/* TODO: links a las redes. Faltan las URL (REVISION-TEXTOS.md). */}
			</div>
		</div>

		<div class="pie__base">
			<p class="pie__legal">© {anio} Accelerate.ai. Todos los derechos reservados.</p>
			<a class="pie__arriba" href="#inicio">
				Volver arriba
				<Icono nombre="arrow-up-bold" size={18} />
			</a>
		</div>
	</div>
</footer>

<style>
	.pie {
		color: var(--text-muted-light);
		view-timeline: --pie block;
	}

	/* La estela: tres líneas con los colores de las capas de la A sobre oscuro. */
	.pie__estela {
		display: grid;
		gap: 3px;
	}

	.pie__estela span {
		height: 3px;
		transform-origin: left;
	}

	/* Escalonadas como la estela de la A: la de atrás cruza todo el ancho, las de adelante se
	   quedan más cortas. */
	.pie__estela span:nth-child(1) { background: var(--mark-back-on-dark); }
	.pie__estela span:nth-child(2) { width: 72%; background: var(--mark-mid-on-dark); }
	.pie__estela span:nth-child(3) { width: 44%; background: var(--mark-front-on-dark); }

	.pie__grilla {
		display: grid;
		gap: var(--space-5);
		padding-block: var(--space-6) var(--space-5);
	}

	.pie__bloque {
		display: grid;
		align-content: start;
		gap: var(--space-2);
	}

	.pie__marca p {
		max-width: 32ch;
		color: var(--text-body-light);
		font-size: 1rem;
	}

	.pie__logo {
		width: 200px;
		height: auto;
	}

	/* Título de columna y links al mismo tamaño chico: el título se distingue por peso y color, y
	   los links no le ganan en jerarquía (antes iban a tamaño de párrafo). */
	.pie__titulo {
		color: var(--text-heading-light);
		font-size: var(--type-meta-size);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.01em;
	}

	/* En el celular, los links en dos columnas: la lista no se vuelve una torre. */
	.pie__links {
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: var(--space-2);
	}

	/* El subrayado crece desde la izquierda con el mouse: la misma dirección que la estela. */
	.pie__link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		background: linear-gradient(var(--cyan-300), var(--cyan-300)) no-repeat 0 calc(50% + 0.8em) / 0% 1px;
		color: var(--text-body-light);
		font-size: var(--type-meta-size);
		transition: color 0.2s, background-size 0.25s var(--curva-salida);
	}

	.pie__contactos {
		display: grid;
		gap: var(--space-1);
	}

	/* Una fila por canal: el ícono en un recuadro fino, el canal chico arriba y el dato abajo. */
	.pie__contacto {
		display: flex;
		align-items: center;
		gap: 12px;
		min-height: 44px;
	}

	.pie__contacto-icono {
		display: grid;
		flex: none;
		place-items: center;
		width: 40px;
		height: 40px;
		border: 1px solid var(--border-dark);
		border-radius: 12px;
		color: var(--cyan-300);
		transition: border-color 0.2s;
	}

	.pie__contacto-texto {
		display: grid;
		min-width: 0;
		line-height: 1.35;
	}

	.pie__contacto-canal {
		color: var(--text-muted-light);
		font-size: 0.8125rem;
	}

	.pie__contacto-dato {
		color: var(--text-body-light);
		font-size: var(--type-meta-size);
		font-variant-numeric: tabular-nums;
		overflow-wrap: anywhere;
		transition: color 0.2s;
	}

	.pie__base {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
		padding-block: var(--space-2) var(--space-3);
		border-top: 1px solid var(--border-dark);
	}

	.pie__legal {
		color: var(--text-muted-light);
		font-size: var(--type-meta-size);
	}

	.pie__arriba {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		min-height: 44px;
		padding-inline: var(--space-2);
		border: 1px solid var(--border-dark);
		border-radius: var(--radius-pill);
		color: var(--text-heading-light);
		font-size: var(--type-meta-size);
		font-weight: var(--fw-semibold);
		transition: border-color 0.2s;
	}

	.pie__arriba :global(svg) {
		color: var(--cyan-300);
		transition: transform 0.2s var(--curva-salida);
	}

	@media (hover: hover) and (pointer: fine) {
		.pie__link:hover {
			background-size: 100% 1px;
			color: var(--text-heading-light);
		}

		.pie__contacto:hover .pie__contacto-icono {
			border-color: var(--cyan-300);
		}

		.pie__contacto:hover .pie__contacto-dato {
			color: var(--text-heading-light);
		}

		.pie__arriba:hover {
			border-color: var(--cyan-300);
		}
	}

	@media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
		.pie__arriba:hover :global(svg) {
			transform: translateY(-3px);
		}
	}

	.pie a:focus-visible {
		outline: 3px solid var(--brand-accent);
		outline-offset: 3px;
		border-radius: 4px;
	}

	.pie .pie__arriba:focus-visible {
		border-radius: var(--radius-pill);
	}

	@media (min-width: 768px) {
		.pie__grilla {
			grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) minmax(0, 1.25fr);
			gap: var(--space-4);
		}

		.pie__links {
			grid-template-columns: 1fr;
		}

		.pie__logo {
			width: 232px;
		}
	}

	@keyframes estela-cruza {
		from { transform: scaleX(0); }
	}

	@keyframes bloque-sube {
		from { opacity: 0; transform: translateY(24px); }
	}

	@keyframes logo-arranca {
		from {
			clip-path: inset(0 100% 0 0);
			transform: translateX(-12%);
		}
	}

	/* El pie es lo último de la página: los tramos terminan antes de que termine de entrar, así
	   se completan aunque no haya más scroll. */
	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			.pie__estela span {
				animation: estela-cruza var(--curva-salida) both;
				animation-timeline: --pie;
			}

			.pie__estela span:nth-child(1) { animation-range: entry 0% entry 30%; }
			.pie__estela span:nth-child(2) { animation-range: entry 5% entry 38%; }
			.pie__estela span:nth-child(3) { animation-range: entry 10% entry 46%; }

			.pie__bloque {
				animation: bloque-sube linear both;
				animation-timeline: --pie;
				animation-range: entry calc(20% + var(--i) * 12%) entry calc(55% + var(--i) * 12%);
			}

			.pie__logo {
				animation: logo-arranca var(--curva-salida) both;
				animation-timeline: --pie;
				animation-range: entry 25% entry 65%;
			}
		}
	}
</style>
