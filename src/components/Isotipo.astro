---
// El logo: el isotipo C4 (una "A." en cursiva con dos capas de velocidad detrás de la A y dos rastros
// detrás del punto) más "Accelerate.ai" como texto real. Los SVG de la marca separan las capas
// pintando encima formas del color del fondo; acá cada capa lleva una <mask> que recorta lo que
// esas formas tapaban (con 5 px de margen: son los cortes), así no hay fondo y sirve sobre
// cualquier color. Las coordenadas son las del SVG original (la A en 3.8 … 229.4, el punto
// en 267.4 … 342.2, la base en y = 0), con el viewBox ajustado al dibujo.
// El tamaño lo da el ANCHO del bloque (que lo pone quien lo usa: el bloque es un contenedor y
// la marca y el texto se miden en cqw), así que se achica entero y proporcional si el lugar es
// poco, como la imagen que reemplaza. `id` tiene que ser único en la página: va en las máscaras.
// Colores por custom property (--isotipo-*), con los tokens --mark-* de la marca.
interface Props {
	fondo: 'claro' | 'oscuro';
	id: string;
	class?: string;
}

const { fondo, id, class: clase } = Astro.props;
const ref = (nombre: string) => `#${id}-${nombre}`;
// Región de las máscaras: el viewBox con un poco de aire.
const region = { x: -60, y: -180, width: 410, height: 185 };
---

<span class:list={['isotipo', `isotipo--${fondo}`, clase]}>
	<svg class="isotipo__marca" viewBox="-52.2 -171.9 394.5 171.9" aria-hidden="true" focusable="false">
		<defs>
			<path id={`${id}-a`} fill-rule="evenodd" d="M3.83 0 164.86 -171.89H221.45L229.42 0H174.36L173.63 -27.54H81.39L56.28 0ZM115.03 -64.82H173.19L173.09 -99.75Q173.16 -102.09 173.3 -106.38Q173.45 -110.67 173.72 -115.55Q173.99 -120.42 174.25 -124.62Q174.52 -128.81 174.62 -130.83H172.76Q168.87 -126.23 163.82 -120.28Q158.77 -114.32 154.06 -108.73Q149.35 -103.14 146.18 -99.64Z"></path>
			<path id={`${id}-s`} d="M3.83 0 164.86 -171.89H221.45L229.42 0Z"></path>
			<path id={`${id}-p`} d="M267.42 0 287.81 -45.79H342.22L321.83 0Z"></path>
			{/* Cada máscara: todo visible, menos lo que tapan las capas de adelante (silueta con 5 px de margen). */}
			<mask id={`${id}-m1`} maskUnits="userSpaceOnUse" {...region}>
				<rect {...region} fill="#fff"></rect>
				<g fill="#000" stroke="#000" stroke-width="10">
					<rect x="-60" y="-180" width="300" height="125" stroke="none"></rect>
					<use href={ref('s')} transform="translate(-28)"></use>
					<use href={ref('s')}></use>
				</g>
			</mask>
			<mask id={`${id}-m2`} maskUnits="userSpaceOnUse" {...region}>
				<rect {...region} fill="#fff"></rect>
				<g fill="#000" stroke="#000" stroke-width="10">
					<rect x="-60" y="-180" width="300" height="73.4" stroke="none"></rect>
					<use href={ref('s')}></use>
				</g>
			</mask>
			<mask id={`${id}-m3`} maskUnits="userSpaceOnUse" {...region}>
				<rect {...region} fill="#fff"></rect>
				<g fill="#000" stroke="#000" stroke-width="10">
					<use href={ref('p')} transform="translate(-12)"></use>
					<use href={ref('p')}></use>
				</g>
			</mask>
			<mask id={`${id}-m4`} maskUnits="userSpaceOnUse" {...region}>
				<rect {...region} fill="#fff"></rect>
				<use href={ref('p')} fill="#000" stroke="#000" stroke-width="10"></use>
			</mask>
		</defs>
		<g mask={`url(${ref('m1')})`}><use class="isotipo__atras" href={ref('a')} transform="translate(-56)"></use></g>
		<g mask={`url(${ref('m2')})`}><use class="isotipo__medio" href={ref('a')} transform="translate(-28)"></use></g>
		<use class="isotipo__frente" href={ref('a')}></use>
		<g mask={`url(${ref('m3')})`}><use class="isotipo__atras" href={ref('p')} transform="translate(-24)"></use></g>
		<g mask={`url(${ref('m4')})`}><use class="isotipo__medio" href={ref('p')} transform="translate(-12)"></use></g>
		<use class="isotipo__frente" href={ref('p')}></use>
	</svg>
	<span class="isotipo__nombre" translate="no">Accelerate.ai</span>
</span>

<style>
	/* Contenedor: lo de adentro se mide en cqw. Todo suma 100 cqw: marca (18,6) + aire (3,5) + nombre
	   (77,7), con el nombre en Archivo 800 y -0,01em, y la marca del alto de las mayúsculas (0,69em)
	   sobre la misma base. Sin ancho puesto desde afuera el bloque mide 0. */
	.isotipo {
		container-type: inline-size;
		display: flex;
		align-items: baseline;
		white-space: nowrap;
	}

	.isotipo--claro {
		--isotipo-frente: var(--mark-front);
		--isotipo-medio: var(--mark-mid);
		--isotipo-atras: var(--mark-back);
		--isotipo-nombre: var(--text-heading-dark);
	}

	.isotipo--oscuro {
		--isotipo-frente: var(--mark-front-on-dark);
		--isotipo-medio: var(--mark-mid-on-dark);
		--isotipo-atras: var(--mark-back-on-dark);
		--isotipo-nombre: var(--mark-front-on-dark);
	}

	.isotipo__marca {
		flex: none;
		height: 8.12cqw;
		margin-right: 3.53cqw;
	}

	.isotipo__frente { fill: var(--isotipo-frente); }
	.isotipo__medio { fill: var(--isotipo-medio); }
	.isotipo__atras { fill: var(--isotipo-atras); }

	/* Mismo color y tracking que los títulos: pesado y apretado, un nombre corto. */
	.isotipo__nombre {
		color: var(--isotipo-nombre);
		font-family: var(--font-core);
		font-size: 11.76cqw;
		font-weight: var(--fw-black);
		letter-spacing: -0.01em;
		line-height: 1;
	}
</style>
