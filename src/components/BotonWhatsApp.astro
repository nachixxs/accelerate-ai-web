---
// Los botones que abren WhatsApp. Son links, no <button>: no hay JavaScript.
// - principal: el CTA de la marca, el único lugar con #2971f2 a saturación máxima. Va en la
//   portada y en el cierre, con el texto de la marca.
// - secundario: fill #1f57c2 sobre claro, o cian sobre oscuro (el acento de cada fondo).
// - contorno: borde y texto, para no competir con una card que ya pesa.
// - link: texto con flecha, para cerrar una sección sin sumar otro botón.
// Cada uno lleva su propio texto y su propio mensaje de WhatsApp según la sección, como
// minificando. Con el mouse encima se despegan, los cruza un brillo y el ícono se mueve
// (pedido del usuario, 2026-09-24 y 2026-09-25).
import Icono from './Icono.astro';
import { whatsappUrl } from '../config';

interface Props {
	texto?: string;
	mensaje?: string;
	variante?: 'principal' | 'secundario' | 'contorno' | 'link';
	class?: string;
}

const { texto = 'Escribinos por WhatsApp', mensaje, variante = 'principal', class: clase } = Astro.props;
---

<a class:list={['boton', `boton--${variante}`, clase]} href={whatsappUrl(mensaje)} target="_blank" rel="noopener">
	{(variante === 'principal' || variante === 'secundario') && <span class="boton__brillo" aria-hidden="true"></span>}
	{texto}
	{variante === 'principal' ? <Icono nombre="si:whatsapp" size={24} class="boton__icono" /> : <Icono nombre="arrow-right-bold" size={20} class="boton__icono" />}
</a>

<style>
	/* Sin nowrap: con la letra del celular agrandada, el texto baja de línea en vez de quedar
	   recortado por el overflow de la sección. */
	.boton {
		display: inline-flex;
		max-width: 100%;
		align-items: center;
		gap: var(--space-1);
		min-height: 48px;
		padding: 12px var(--space-3);
		border-radius: var(--radius-pill);
		font-size: var(--type-meta-size);
		font-weight: var(--fw-semibold);
		line-height: 1.2;
		-webkit-tap-highlight-color: transparent;
		/* isolation: las capas del brillo y de la sombra (z-index -1) quedan arriba del fondo del
		   botón y abajo del texto, sin escaparse detrás de la sección. */
		position: relative;
		isolation: isolate;
		transition:
			background-color 0.2s,
			border-color 0.2s,
			color 0.2s;
	}

	.boton :global(.boton__icono) {
		flex: none;
	}

	/* 19px en 700 cuenta como texto grande para WCAG: blanco sobre #2971f2 pide 3:1 y da 4,4:1. */
	.boton--principal {
		min-height: 56px;
		padding: var(--space-2) var(--space-3);
		background: var(--brand-primary);
		color: var(--white);
		font-size: 1.1875rem;
		font-weight: var(--fw-bold);
		letter-spacing: -0.01em;
		box-shadow: var(--shadow-boton);
	}

	.boton--secundario {
		background: var(--brand-primary-deep);
		color: var(--white);
		box-shadow: var(--shadow-elevada);
	}

	.boton--contorno {
		border: 1.5px solid var(--brand-primary-deep);
		color: var(--brand-primary-deep);
	}

	.boton--link {
		min-height: 44px;
		padding-inline: 0;
		color: var(--brand-primary-deep);
	}

	/* Sobre fondo oscuro: el secundario pasa al cian de la marca y el resto a texto claro. */
	:global(.seccion--oscura) .boton--secundario {
		background: var(--cyan-300);
		color: var(--navy-950);
	}

	:global(.seccion--oscura) .boton--contorno {
		border-color: var(--border-dark);
		color: var(--text-heading-light);
	}

	:global(.seccion--oscura) .boton--link {
		color: var(--cyan-300);
	}

	/* :active reemplaza el resaltado gris de Android, que es un rectángulo encima de la píldora.
	   El hover, solo con mouse: en el celular queda pegado al volver de WhatsApp. */
	.boton--principal:active {
		background: var(--brand-primary-deep);
		color: var(--white);
	}

	.boton--secundario:active {
		background: var(--blue-800);
		color: var(--white);
	}

	.boton--contorno:active {
		background: var(--blue-50);
	}

	@media (hover: hover) and (pointer: fine) {
		.boton--principal:hover {
			background: var(--brand-primary-deep);
			color: var(--white);
		}

		.boton--secundario:hover {
			background: var(--blue-800);
			color: var(--white);
		}

		:global(.seccion--oscura) .boton--secundario:hover {
			background: var(--cyan-200);
			color: var(--navy-950);
		}

		.boton--contorno:hover {
			background: var(--blue-50);
			color: var(--brand-primary-deep);
		}

		:global(.seccion--oscura) .boton--contorno:hover {
			border-color: var(--cyan-300);
			background: transparent;
			color: var(--text-heading-light);
		}

		.boton--link:hover {
			color: var(--brand-primary);
		}

		:global(.seccion--oscura) .boton--link:hover {
			color: var(--cyan-200);
		}
	}

	/* Con el mouse encima, el botón se despega (crece un 5 % y sube 2 px, con más sombra), un
	   brillo lo cruza una vez y el ícono responde: la flecha se adelanta y el logo de WhatsApp se
	   balancea como una notificación. Corre aunque el sistema pida movimiento reducido (pedido del
	   usuario, 2026-09-25): lo dispara quien pasa el mouse, dura menos de un segundo y no se
	   repite solo. Lo que tiene que poder cortarse a mitad de camino (crecer, la sombra, la
	   flecha) es transición y vuelve desde donde esté; el brillo y el balanceo son keyframes de
	   una sola pasada, y cortados no se notan. Solo transform y opacity. */

	/* El brillo va en su propia capa, que recorta solo su contenido: así el botón no necesita
	   overflow: hidden y la sombra de abajo puede salir de sus bordes. */
	.boton__brillo {
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: inherit;
		overflow: hidden;
		pointer-events: none;
	}

	.boton__brillo::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(105deg, transparent 30%, rgba(255, 255, 255, 0.22) 50%, transparent 70%);
		transform: translateX(-100%);
	}

	/* La sombra del hover, en una capa que solo cambia de opacidad: animar box-shadow repinta en
	   cada cuadro. Se suma a la sombra de reposo de cada variante. */
	.boton--principal::after,
	.boton--secundario::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: inherit;
		opacity: 0;
		pointer-events: none;
	}

	.boton--principal::after {
		box-shadow: 0 24px 48px rgba(15, 36, 80, 0.3);
	}

	.boton--secundario::after {
		box-shadow: var(--shadow-card);
	}

	@keyframes boton-brillo {
		from {
			transform: translateX(-100%);
		}
		to {
			transform: translateX(100%);
		}
	}

	@keyframes globo-suena {
		20% {
			transform: rotate(-14deg);
		}
		45% {
			transform: rotate(10deg);
		}
		70% {
			transform: rotate(-5deg);
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.boton {
			transition:
				background-color 0.2s,
				border-color 0.2s,
				color 0.2s,
				transform 0.25s var(--curva-salida);
		}

		.boton::after,
		.boton :global(.boton__icono) {
			transition:
				opacity 0.25s var(--curva-salida),
				transform 0.2s var(--curva-salida);
		}

		.boton:hover {
			transform: translateY(-2px) scale(1.05);
		}

		.boton:hover::after {
			opacity: 1;
		}

		.boton:not(.boton--principal):hover :global(.boton__icono) {
			transform: translateX(4px);
		}

		.boton--principal:hover :global(.boton__icono) {
			animation: globo-suena 0.45s var(--curva-cruce);
		}

		.boton:hover .boton__brillo::before {
			animation: boton-brillo 0.6s var(--curva-cruce);
		}
	}

	.boton:focus-visible {
		outline: 3px solid var(--brand-primary-deep);
		outline-offset: 3px;
	}

	.boton--principal:focus-visible,
	:global(.seccion--oscura) .boton:focus-visible {
		outline-color: var(--brand-accent);
	}
</style>
