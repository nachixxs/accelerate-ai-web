---
// Mock de "Stock e inventario": cada producto con su barra de nivel y la marca del mínimo. Con
// el scroll, las barras bajan hasta el stock de hoy, a los que quedaron bajo el mínimo les
// aparece "Reponer" y, montado sobre el borde, el pedido sugerido al proveedor: papel claro sobre
// la card oscura (la regla de profundidad de la marca). Son datos de ejemplo.
// El estado de base es el final: sin soporte o con movimiento reducido, se ve completo y quieto.
// Se anima con el timeline --celda de la card que lo contiene. Con JavaScript, las unidades
// cuentan al verse y "Reponer" llena la barra, cuenta el nuevo stock y tacha el ítem del pedido.
import Icono from '../Icono.astro';

// Tope de la barra: el doble del mínimo, o las unidades si son más. Reponer siempre sube al
// doble del mínimo, que (por construcción) es el tope de un producto bajo mínimo: la barra
// repuesta queda siempre llena (factor = 1 / nivel, para compensar el nivel de hoy).
const productos = [
	{ nombre: 'Cartulina A4 250 g', rubro: 'Papel', unidades: 1240, minimo: 500 },
	{ nombre: 'Tinta negra XL', rubro: 'Insumos', unidades: 3, minimo: 6 },
	{ nombre: 'Vinilo blanco mate', rubro: 'Rollos', unidades: 18, minimo: 8 },
	{ nombre: 'Anillos 12 mm', rubro: 'Encuadernación', unidades: 40, minimo: 50 },
].map((p, i) => {
	const tope = Math.max(p.minimo * 2, p.unidades * 1.15);
	const nivel = Math.min(p.unidades / tope, 1);
	const bajo = p.unidades < p.minimo;
	return { ...p, i, nivel, marca: p.minimo / tope, bajo, repuesto: p.minimo * 2, factor: bajo ? (1 / nivel).toFixed(3) : '1' };
});

// El pedido sugerido: lo que quedó bajo el mínimo, hasta el doble del mínimo.
const pedido = productos.filter((p) => p.bajo).map(({ i, nombre, repuesto }) => ({ i, nombre, cantidad: repuesto }));
---

<div
	class="stock"
	role="group"
	aria-label="Ejemplo con datos inventados: el stock de cuatro productos con su nivel y su mínimo. La tinta negra y los anillos quedaron bajo el mínimo y dicen reponer, y ya está armado el pedido sugerido al proveedor con esos dos productos."
>
	<div class="stock__barra">
		<strong>Stock</strong>
		<span class="stock__buscar" aria-hidden="true">
			<Icono nombre="magnifying-glass-duotone" size={14} />
			Buscar producto
		</span>
	</div>

	<ul class="stock__lista">
		{
			productos.map(({ nombre, rubro, unidades, minimo, nivel, marca, bajo, repuesto, factor, i }) => (
				<li class:list={['producto', { 'producto--bajo': bajo }]} style={`--i: ${i}`} data-idx={i}>
					<span class="producto__nombre">
						{nombre}
						<small>{rubro}</small>
					</span>
					<span class="producto__estado">
						{bajo ? (
							<>
								<button type="button" class="producto__reponer" data-nuevo={repuesto} data-factor={factor} aria-label={`Reponer ${nombre}`}>
									<Icono nombre="warning-duotone" size={14} />
									Reponer
								</button>
								<span class="producto__ok" hidden tabindex="-1">Al día</span>
							</>
						) : (
							<span class="producto__ok">Al día</span>
						)}
					</span>
					<span class="producto__nivel" aria-hidden="true" style={`--nivel: ${nivel.toFixed(3)}; --marca: ${(marca * 100).toFixed(1)}%`}>
						<span class="producto__relleno" />
						<span class="producto__minimo" />
					</span>
					<span class="producto__unidades">
						<span class="producto__cifra" data-valor={unidades}>{unidades.toLocaleString('es-AR')}</span> <small>/ mín. {minimo.toLocaleString('es-AR')}</small>
					</span>
				</li>
			))
		}
	</ul>

	<p class="stock__nota">Datos de ejemplo</p>

	<div class="pedido">
		<span class="pedido__titulo">
			<Icono nombre="shopping-cart-duotone" size={18} />
			Pedido sugerido
		</span>
		<ul>
			{pedido.map(({ i, nombre, cantidad }) => <li data-idx={i}><span>{nombre}</span><span>×&nbsp;{cantidad}</span></li>)}
		</ul>
		<span class="pedido__proveedor">Proveedor: Insumos del Sur</span>
	</div>
</div>

<script>
	import { contarAlVer, unidades, movimientoReducido, contar } from '../../scripts/contar';

	contarAlVer([...document.querySelectorAll<HTMLElement>('.producto__cifra')], unidades);

	// Reponer: llena la barra (con `scale`, no `transform`, que ya anima el scroll), cuenta las
	// unidades hasta el nuevo stock, pasa el estado a "Al día" y tacha el ítem en el pedido. El
	// botón y el "Al día" ya están en el HTML (con estilos scoped de Astro): el script solo
	// alterna `hidden`, sin crear elementos (un <span> creado a mano no tiene el atributo
	// data-astro-cid-* y se queda sin estilos).
	document.querySelectorAll<HTMLButtonElement>('.producto__reponer').forEach((boton) => {
		boton.addEventListener('click', () => {
			const fila = boton.closest<HTMLLIElement>('.producto');
			const relleno = fila?.querySelector<HTMLElement>('.producto__relleno');
			const cifra = fila?.querySelector<HTMLElement>('.producto__cifra');
			const ok = fila?.querySelector<HTMLElement>('.producto__ok');
			if (!fila || !relleno || !cifra || !ok) return;

			const nuevo = Number(boton.dataset.nuevo);
			const desde = Number(cifra.dataset.valor ?? 0);
			const pedido = document.querySelector<HTMLElement>(`.pedido li[data-idx="${fila.dataset.idx}"]`);
			const teniaFoco = document.activeElement === boton;

			fila.classList.remove('producto--bajo');
			relleno.style.scale = `${boton.dataset.factor} 1`;
			boton.hidden = true;
			ok.hidden = false;
			// El botón desaparece: si tenía el foco del teclado, que no se pierda en <body>.
			if (teniaFoco) ok.focus({ preventScroll: true });
			pedido?.classList.add('pedido__item--repuesto');
			cifra.dataset.valor = String(nuevo);

			if (movimientoReducido()) cifra.textContent = unidades(nuevo);
			// 500 ms: el mismo tiempo que tarda la barra en llenarse (`.producto__relleno`), para que
			// lleguen juntas.
			else contar(cifra, desde, nuevo, unidades, 500);
		});
	});
</script>

<style>
	.stock {
		container-type: inline-size;
		position: relative;
		display: grid;
		gap: 12px;
		padding: 16px 16px 0;
		border: 1px solid var(--border-dark);
		border-radius: var(--radius-card);
		background: var(--navy-900);
		color: var(--text-body-light);
		font-size: 0.875rem;
		line-height: 1.35;
	}

	.stock__barra {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	.stock__barra strong {
		color: var(--text-heading-light);
		font-weight: var(--fw-bold);
	}

	.stock__buscar {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 6px 12px;
		border: 1px solid var(--border-dark);
		border-radius: var(--radius-pill);
		color: var(--text-muted-light);
		font-size: 0.8125rem;
	}

	.stock__lista {
		display: grid;
		gap: 4px;
	}

	/* Cada fila: nombre y estado arriba, la barra con el mínimo y las unidades abajo. */
	.producto {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 8px 12px;
		padding: 10px 12px;
		border-radius: 14px;
		background: var(--navy-850);
	}

	.producto__nombre {
		display: grid;
		color: var(--text-heading-light);
		font-weight: var(--fw-semibold);
	}

	.producto__nombre small,
	.producto__unidades small {
		color: var(--text-muted-light);
		font-size: 0.8125rem;
		font-weight: var(--fw-regular);
	}

	.producto__estado {
		justify-self: end;
	}

	.producto__ok,
	.producto__reponer {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding: 4px 10px;
		border-radius: var(--radius-pill);
		font-size: 0.8125rem;
		font-weight: var(--fw-semibold);
		line-height: 1.2;
		white-space: nowrap;
	}

	.producto__ok {
		border: 1px solid var(--border-dark);
		color: var(--text-muted-light);
	}

	/* [hidden] del user-agent pierde contra el display: inline-flex de arriba (mismo origen
	   autor gana siempre a UA): hay que repetirlo a mano para el botón y el "Al día" que
	   arrancan ocultos. */
	.producto__ok[hidden],
	.producto__reponer[hidden] {
		display: none;
	}

	/* Botón real: sin bordes de navegador, con el área táctil de 44 px en un pseudo-elemento
	   (el pill se ve chico a propósito). Cian, nunca el azul del CTA de WhatsApp. */
	.producto__reponer {
		position: relative;
		border: 0;
		font: inherit;
		cursor: pointer;
		background: var(--cyan-300);
		color: var(--navy-950);
	}

	.producto__reponer::before {
		content: '';
		position: absolute;
		inset: 50%;
		width: 44px;
		height: 44px;
		translate: -50% -50%;
	}

	@media (hover: hover) and (pointer: fine) {
		.producto__reponer {
			transition: background-color 0.2s;
		}

		.producto__reponer:hover {
			background: var(--cyan-200);
		}
	}

	.producto__reponer:active {
		scale: 0.96;
		transition: scale 0.12s var(--curva-salida);
	}

	.producto__nivel {
		position: relative;
		height: 8px;
		border-radius: 8px;
		background: var(--border-dark);
	}

	.producto__relleno {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: var(--blue-400);
		transform-origin: left;
		transform: scaleX(var(--nivel));
		/* `scale` es una propiedad aparte de `transform`: no pisa la animación de scroll de abajo. */
		transition:
			scale 0.5s var(--curva-salida),
			background-color 0.3s;
	}

	.producto--bajo .producto__relleno {
		background: var(--cyan-400);
	}

	/* La marca del mínimo: una rayita clara que cruza la barra. */
	.producto__minimo {
		position: absolute;
		top: -4px;
		bottom: -4px;
		left: var(--marca);
		width: 2px;
		border-radius: 2px;
		background: var(--text-heading-light);
	}

	.producto__unidades {
		justify-self: end;
		color: var(--text-heading-light);
		font-size: 0.8125rem;
		font-weight: var(--fw-semibold);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.stock__nota {
		color: var(--text-muted-light);
		font-size: 0.8125rem;
	}

	/* El pedido sugerido: papel claro, montado sobre el borde de abajo y un poco girado. Cierra
	   el mock en el flujo, con margen negativo: con letra grande el mock crece y el pedido no tapa
	   ni la nota ni los productos. */
	.pedido {
		justify-self: end;
		display: grid;
		gap: 8px;
		width: min(260px, 100%);
		margin-bottom: -24px;
		padding: 16px;
		border-radius: 18px;
		background: var(--off-white);
		color: var(--text-body-dark);
		font-size: 0.875rem;
		box-shadow: var(--shadow-card);
		transform: rotate(1.5deg);
	}

	.pedido__titulo {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--text-heading-dark);
		font-weight: var(--fw-bold);
	}

	.pedido__titulo :global(svg) {
		color: var(--brand-primary-deep);
	}

	.pedido ul {
		display: grid;
		gap: 4px;
		padding-block: 8px;
		border-block: 1px dashed var(--slate-300);
	}

	.pedido li {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		font-variant-numeric: tabular-nums;
	}

	.pedido li span:last-child {
		color: var(--text-heading-dark);
		font-weight: var(--fw-semibold);
	}

	/* El ítem repuesto se tacha en el pedido, en vez de desarmar la lista. Color de token en vez de
	   opacidad: con opacidad el texto queda en ≈3,3:1, bajo el mínimo AA de 4,5:1. */
	.pedido li.pedido__item--repuesto,
	.pedido li.pedido__item--repuesto span:last-child {
		color: var(--text-muted-dark);
	}

	.pedido li.pedido__item--repuesto span {
		text-decoration: line-through;
	}

	.pedido__proveedor {
		color: var(--text-muted-dark);
		font-size: 0.8125rem;
	}

	/* Consulta de contenedor: la card mide distinto según la grilla, no según la pantalla. */
	@container (min-width: 420px) {
		.producto {
			grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) auto;
		}

		.producto__nombre { grid-column: 1; grid-row: 1 / span 2; }
		.producto__nivel { grid-column: 2; grid-row: 1; }
		.producto__unidades { grid-column: 2; grid-row: 2; justify-self: start; }
		.producto__estado { grid-column: 3; grid-row: 1 / span 2; }
	}

	/* --- Movimiento --- */
	@keyframes stock-baja {
		from { transform: scaleX(1); }
	}

	@keyframes stock-aparece {
		from { opacity: 0; transform: scale(0.9); }
	}

	@keyframes stock-pedido {
		from { opacity: 0; transform: translateY(32px) rotate(-2deg); }
		to { opacity: 1; transform: rotate(1.5deg); }
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			/* Las barras arrancan llenas y bajan hasta el stock de hoy, una detrás de otra. */
			.producto__relleno {
				animation: stock-baja var(--curva-salida) both;
				animation-timeline: --celda;
				animation-range: entry calc(40% + var(--i) * 6%) cover calc(40% + var(--i) * 3%);
			}

			.producto__estado {
				animation: stock-aparece var(--curva-salida) both;
				animation-timeline: --celda;
				animation-range: cover calc(38% + var(--i) * 3%) cover calc(44% + var(--i) * 3%);
			}

			.pedido {
				animation: stock-pedido var(--curva-salida) both;
				animation-timeline: --celda;
				animation-range: cover 50% cover 60%;
			}
		}
	}

	/* Con movimiento reducido, el clic en "Reponer" salta directo al estado final. */
	@media (prefers-reduced-motion: reduce) {
		.producto__relleno {
			transition: none;
		}
	}
</style>
