---
// Mock de "Cajas y cierres diarios sin cuadernos": el ticket del cierre del día, que se
// "imprime" de arriba hacia abajo con el scroll. Montos de ejemplo, no son métricas.
// Se anima con el timeline --celda de la card que lo contiene.
import CircleCheck from '@lucide/astro/icons/circle-check';

const movimientos = [
	{ medio: 'Efectivo', monto: '$ 184.300' },
	{ medio: 'Tarjeta', monto: '$ 261.900' },
	{ medio: 'Transferencias', monto: '$ 97.450' },
];
---

<div
	class="mock-caja"
	role="img"
	aria-label="Ejemplo: el ticket del cierre de caja del martes, con lo cobrado en efectivo, tarjeta y transferencias, el total, y la caja que cierra sin diferencia."
>
	<div class="ticket">
		<div class="ticket__cabecera">
			<strong>Cierre de caja</strong>
			<span>Martes 14, 20:05</span>
		</div>
		<dl>
			{
				movimientos.map(({ medio, monto }) => (
					<div class="ticket__fila">
						<dt>{medio}</dt>
						<dd>{monto}</dd>
					</div>
				))
			}
			<div class="ticket__fila ticket__fila--total">
				<dt>Total</dt>
				<dd>$ 543.650</dd>
			</div>
		</dl>
		<div class="ticket__cierre">
			<span>Diferencia $ 0</span>
			<span class="ticket__sello">
				<CircleCheck size={16} />
				Cierra
			</span>
		</div>
	</div>
</div>

<style>
	.mock-caja {
		display: grid;
		justify-items: center;
	}

	/* El ticket es papel: off-white (la marca no usa #fff puro), con el borde de abajo dentado. */
	.ticket {
		width: 100%;
		max-width: 300px;
		padding: 20px 20px 28px;
		background: var(--off-white);
		color: var(--text-body-dark);
		font-size: 0.875rem;
		font-variant-numeric: tabular-nums;
		box-shadow: var(--shadow-elevada);
		mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 16px 100%;
		transform: rotate(-1.5deg);
	}

	.ticket__cabecera {
		display: grid;
		gap: 2px;
		padding-bottom: 12px;
		border-bottom: 1px dashed var(--slate-400);
		text-align: center;
	}

	.ticket__cabecera strong {
		color: var(--text-heading-dark);
		font-weight: var(--fw-bold);
	}

	.ticket__cabecera span {
		color: var(--text-muted-dark);
		font-size: 0.8125rem;
	}

	.ticket__fila {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		padding-block: 8px;
	}

	.ticket__fila dd {
		margin: 0;
		color: var(--text-heading-dark);
		font-weight: var(--fw-medium);
	}

	.ticket__fila--total {
		margin-top: 4px;
		border-top: 1px dashed var(--slate-400);
		padding-top: 12px;
		color: var(--text-heading-dark);
		font-weight: var(--fw-bold);
	}

	.ticket__fila--total dd {
		font-weight: var(--fw-black);
	}

	.ticket__cierre {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-top: 8px;
		color: var(--text-muted-dark);
		font-size: 0.8125rem;
	}

	.ticket__sello {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding: 4px 10px;
		border: 1.5px solid var(--brand-primary-deep);
		border-radius: var(--radius-pill);
		color: var(--brand-primary-deep);
		font-weight: var(--fw-bold);
		transform: rotate(-4deg);
	}

	@keyframes imprimir {
		from { clip-path: inset(0 0 100% 0); transform: rotate(-1.5deg) translateY(-24px); }
	}

	@keyframes sellar {
		from { opacity: 0; transform: rotate(-4deg) scale(1.3); }
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			.ticket {
				animation: imprimir linear both;
				animation-timeline: --celda;
				animation-range: entry 30% cover 40%;
			}

			.ticket__sello {
				animation: sellar linear both;
				animation-timeline: --celda;
				animation-range: cover 40% cover 46%;
			}
		}
	}
</style>
