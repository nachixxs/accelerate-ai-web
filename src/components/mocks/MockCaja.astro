---
// Mock de "Cajas y cierres diarios sin cuadernos": el ticket del cierre del día, que se
// "imprime" de arriba hacia abajo con el scroll. Montos de ejemplo, no son métricas.
// Se anima con el timeline --celda de la card que lo contiene. Con JavaScript, los montos cuentan
// cuando el ticket se ve; con el mouse, el ticket se endereza y el sello se vuelve a estampar.
import Icono from '../Icono.astro';
import { pesos } from '../../scripts/contar';

const movimientos = [
	{ medio: 'Efectivo', monto: 184300 },
	{ medio: 'Tarjeta', monto: 261900 },
	{ medio: 'Transferencias', monto: 97450 },
];
const total = movimientos.reduce((suma, { monto }) => suma + monto, 0);
---

<div
	class="mock-caja"
	role="img"
	aria-label="Ejemplo: el ticket del cierre de caja del martes, con lo cobrado en efectivo, tarjeta y transferencias, el total, y la caja que cierra sin diferencia."
>
	<div class="ticket-sombra">
		<div class="ticket">
			<div class="ticket__cabecera">
				<strong>Cierre de caja</strong>
				<span>Martes 14, 20:05</span>
			</div>
			<dl>
				{
					movimientos.map(({ medio, monto }) => (
						<div class="ticket__fila">
							<dt>{medio}</dt>
							<dd class="ticket__monto" data-valor={monto}>{pesos(monto)}</dd>
						</div>
					))
				}
				<div class="ticket__fila ticket__fila--total">
					<dt>Total</dt>
					<dd class="ticket__monto" data-valor={total}>{pesos(total)}</dd>
				</div>
			</dl>
			<div class="ticket__cierre">
				<span>Diferencia $ 0</span>
				<span class="ticket__sello">
					<Icono nombre="check-circle-duotone" size={16} />
					Cierra
				</span>
			</div>
		</div>
	</div>
	<p class="mock-caja__nota">Datos de ejemplo</p>
</div>

<script>
	import { contarAlVer, movimientoReducido, pesos } from '../../scripts/contar';

	const montos = [...document.querySelectorAll<HTMLElement>('.ticket__monto')];
	contarAlVer(montos, pesos);

	// El sello se estampa por tiempo al verse (no por un tramo corto de scroll), con su propio
	// observador: el sello queda bastante más abajo que la primera fila del ticket, así que
	// observarlo a él directamente (entero y por encima del 85 % de la pantalla) evita que se
	// estampe mientras todavía está fuera de la vista.
	const sello = document.querySelector<HTMLElement>('.ticket__sello');
	if (sello && montos.length && !movimientoReducido()) {
		sello.classList.add('ticket__sello--espera');
		const observador = new IntersectionObserver(
			(entradas) => {
				if (!entradas.some((e) => e.isIntersecting)) return;
				observador.disconnect();
				sello.classList.remove('ticket__sello--espera');
				sello.classList.add('ticket__sello--vista');
			},
			{ threshold: 1, rootMargin: '0px 0px -15% 0px' },
		);
		observador.observe(sello);
	}
</script>

<style>
	/* Es un mock: nada es clickeable (el ticket reacciona al hover, no necesita cursor de mano),
	   sin cursor de texto ni selección. */
	.mock-caja {
		display: grid;
		justify-items: center;
		gap: 16px;
		cursor: default;
		user-select: none;
		-webkit-user-select: none;
	}

	.mock-caja__nota {
		color: var(--text-muted-light);
		font-size: 0.8125rem;
	}

	/* La sombra va en un envoltorio sin mask ni clip-path: la mask del ticket (el borde dentado)
	   recorta cualquier box-shadow que lleve el propio elemento, así que el tinte oscuro se pone
	   acá con drop-shadow, que sigue la forma dentada y acompaña el ticket cuando sube en el
	   hover (drop-shadow recalcula sobre lo ya pintado, incluido el translate del hijo). */
	.ticket-sombra {
		width: 100%;
		max-width: 300px;
		filter: drop-shadow(var(--shadow-elevada-oscura));
	}

	/* El ticket es papel: off-white (la marca no usa #fff puro), con el borde de abajo dentado. */
	.ticket {
		width: 100%;
		padding: 20px 20px 28px;
		background: var(--off-white);
		color: var(--text-body-dark);
		font-size: 0.875rem;
		font-variant-numeric: tabular-nums;
		mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 16px 100%;
		/* rotate y translate y no transform: transform es de la impresión con el scroll. */
		rotate: -1.5deg;
		transition: rotate 0.3s var(--curva-salida), translate 0.3s var(--curva-salida);
	}

	.ticket__cabecera {
		display: grid;
		gap: 2px;
		padding-bottom: 12px;
		border-bottom: 1px dashed var(--slate-400);
		text-align: center;
	}

	.ticket__cabecera strong {
		color: var(--text-heading-dark);
		font-weight: var(--fw-bold);
	}

	.ticket__cabecera span {
		color: var(--text-muted-dark);
		font-size: 0.8125rem;
	}

	.ticket__fila {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 4px 12px;
		padding-block: 8px;
	}

	.ticket__fila dd {
		margin: 0;
		color: var(--text-heading-dark);
		font-weight: var(--fw-medium);
	}

	.ticket__fila--total {
		margin-top: 4px;
		border-top: 1px dashed var(--slate-400);
		padding-top: 12px;
		color: var(--text-heading-dark);
		font-weight: var(--fw-bold);
	}

	.ticket__fila--total dd {
		font-weight: var(--fw-black);
	}

	.ticket__cierre {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-top: 8px;
		color: var(--text-muted-dark);
		font-size: 0.8125rem;
	}

	.ticket__sello {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding: 4px 10px;
		border: 1.5px solid var(--brand-primary-deep);
		border-radius: var(--radius-pill);
		color: var(--brand-primary-deep);
		font-weight: var(--fw-bold);
		rotate: -4deg;
	}

	/* Con el mouse encima del ticket (no de todo el mock) se endereza y sube, y el sello se vuelve
	   a estampar. Corre también con movimiento reducido: lo dispara quien pasa el mouse. */
	@media (hover: hover) and (pointer: fine) {
		.ticket:hover {
			rotate: 0deg;
			translate: 0 -4px;
		}

		/* Otro nombre que el del scroll: con el mismo, el navegador no reinicia la animación. */
		.ticket:hover .ticket__sello {
			animation: caja-reestampar 0.35s var(--curva-salida);
		}
	}

	/* El sello se estampa por tiempo al verse (el script agrega estas clases), no por un tramo
	   corto de scroll. Sin JS o con reducción, ya está en su estado final. El re-estampado con el
	   mouse (arriba) sigue andando siempre. */
	.ticket__sello--espera {
		opacity: 0;
		scale: 1.3;
	}

	.ticket__sello--vista {
		animation: caja-sellar-vista 450ms var(--curva-salida) both;
	}

	/* clip-path necesita el "to" explícito: sin él, algunos navegadores no interpolan desde el
	   valor base (none) y el ticket aparece de golpe. */
	@keyframes caja-imprimir {
		from { clip-path: inset(0 0 100% 0); transform: translateY(-24px); }
		to { clip-path: inset(0 0 0 0); transform: none; }
	}

	@keyframes caja-sellar-vista {
		from { opacity: 0; scale: 1.3; }
	}

	@keyframes caja-reestampar {
		from { opacity: 0; transform: scale(1.3); }
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			.ticket {
				animation: caja-imprimir var(--curva-salida) both;
				animation-timeline: --celda;
				animation-range: entry 30% cover 40%;
			}
		}
	}
</style>
