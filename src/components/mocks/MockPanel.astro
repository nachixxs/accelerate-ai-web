---
// El producto de la portada: el tablero de un negocio con varios sistemas adentro (órdenes, stock,
// caja, clientes, presupuestos), no un producto cerrado. Tres cifras que cuentan hacia arriba, la
// curva de ventas de la semana y los últimos movimientos, donde entra uno nuevo arriba.
// Son datos de ejemplo, y lo dice el propio tablero: no son resultados de un cliente.
// Para los lectores de pantalla es una imagen (role="img"): sin links ni foco. Con el mouse
// reacciona como una app (pedido del usuario, 2026-09-25): la pastilla de los módulos se desliza
// hasta el que señalás, y en el gráfico una guía sigue al cursor (o al dedo) y marca el día y el
// monto. El gráfico lo mueve el script del final; sin JavaScript queda marcado el pico.
// En escritorio la historia corre una vez al cargar, en unos 3 segundos. En el celular el tablero
// queda debajo del botón y avanza con el scroll, con su propio timeline (--tablero).
import Icono from '../Icono.astro';

const modulos = [
	{ nombre: 'Resumen', icono: 'squares-four-duotone', activo: true },
	{ nombre: 'Órdenes', icono: 'clipboard-text-duotone', aviso: 8 },
	{ nombre: 'Stock', icono: 'package-duotone' },
	{ nombre: 'Caja', icono: 'cash-register-duotone' },
	{ nombre: 'Clientes', icono: 'users-three-duotone' },
	{ nombre: 'Presupuestos', icono: 'file-text-duotone' },
];

// Ventas por día, en miles de pesos. Suman 1.284,5 (el total de la primera cifra).
const semana = [
	{ dia: 'Lun', miles: 142.3 },
	{ dia: 'Mar', miles: 168.9 },
	{ dia: 'Mié', miles: 151.2 },
	{ dia: 'Jue', miles: 196.8 },
	{ dia: 'Vie', miles: 263.5 },
	{ dia: 'Sáb', miles: 312.4 },
	{ dia: 'Dom', miles: 49.4 },
];

// Geometría del gráfico: lienzo de 700 × 200, un punto al centro de cada una de las 7 columnas.
const ANCHO = 700;
const ALTO = 200;
const TOPE = 330; // miles: la línea de arriba de la escala
const x = (i: number) => 50 + i * 100;
const y = (miles: number) => ALTO - 10 - (miles / TOPE) * (ALTO - 30);
const puntos = semana.map(({ miles }, i) => `${x(i)},${y(miles).toFixed(1)}`);
const linea = `M${puntos.join(' L')}`;
const area = `${linea} L${x(6)},${ALTO} L${x(0)},${ALTO} Z`;
const pico = semana.reduce((max, d, i) => (d.miles > semana[max].miles ? i : max), 0);
// Cada día en % del lienzo, para el marcador que sigue al cursor.
const dias = semana.map(({ dia, miles }, i) => ({
	dia,
	monto: `$ ${Math.round(miles * 1000).toLocaleString('es-AR')}`,
	x: +((x(i) / ANCHO) * 100).toFixed(2),
	y: +((y(miles) / ALTO) * 100).toFixed(2),
}));

const cifras = [
	{ nombre: 'Ventas', fin: 1284500, desde: 1000000, formato: 'millones', variacion: '+12 % vs. semana pasada' },
	{ nombre: 'Órdenes', fin: 142, desde: 0, formato: 'simple' },
	{ nombre: 'Ticket promedio', fin: 9045, desde: 5000, formato: 'miles' },
];
const texto = (n: number) => `${n > 999 ? '$ ' : ''}${n.toLocaleString('es-AR')}`;

// El primero es el que llega durante la animación; los otros dos ya estaban.
const movimientos = [
	{ icono: 'check-circle-duotone', texto: 'Orden #1043 terminada', detalle: 'Pasó sola a “Para entregar”', hora: '10:42' },
	{ icono: 'package-duotone', texto: 'Papel A4 bajo el mínimo', detalle: 'El pedido al proveedor ya está armado', hora: '10:15' },
	{ icono: 'cash-register-duotone', texto: 'Caja del lunes cerrada', detalle: 'Cuadró al peso', hora: 'Ayer' },
];
---

<div
	class="tablero"
	role="img"
	aria-label="Ejemplo con datos inventados: el tablero de un negocio con órdenes, stock, caja, clientes y presupuestos en un solo lugar. Muestra ventas de la semana por 1.284.500 pesos, 142 órdenes, un ticket promedio de 9.045 pesos, la curva de ventas con el pico el sábado y los últimos movimientos: una orden terminada, un producto bajo el mínimo con el pedido al proveedor armado y la caja del lunes cerrada."
>
	<span class="tablero__chip">
		<Icono nombre="lightning-duotone" size={16} />
		Al día sin pasar nada a mano
	</span>

	<div class="ventana">
		<div class="ventana__barra">
			<strong>Tu negocio</strong>
			<span class="ventana__buscar">
				<Icono nombre="magnifying-glass-duotone" size={16} />
				Buscar orden, cliente o producto
			</span>
			<span class="ventana__fecha">Martes 14</span>
		</div>

		<div class="ventana__cuerpo">
			<ul class="modulos">
				{
					modulos.map(({ nombre, icono, activo, aviso }, i) => (
						<li class:list={['modulo', { 'modulo--activo': activo }]} style={`--i: ${i}`}>
							<Icono nombre={icono} size={18} />
							{nombre}
							{aviso && <span class="modulo__aviso">{aviso}</span>}
						</li>
					))
				}
			</ul>

			<div class="ventana__contenido">
				<div class="contenido__barra">
					<span class="contenido__titulo">
						<strong>Esta semana</strong>
						<small>Datos de ejemplo</small>
					</span>
					<span class="periodo">
						<span class="periodo__opcion periodo__opcion--activa">Semana</span>
						<span class="periodo__opcion">Mes</span>
					</span>
				</div>

				<dl class="cifras">
					{
						cifras.map(({ nombre, fin, desde, formato, variacion }, i) => (
							<div class="cifra" style={`--i: ${i}`}>
								<dt>{nombre}</dt>
								<dd class={`cifra__valor cifra__valor--${formato}`} style={`--fin: ${fin}; --desde: ${desde}`}>
									<span class="cifra__texto">{texto(fin)}</span>
								</dd>
								{variacion && <dd class="cifra__variacion">{variacion}</dd>}
							</div>
						))
					}
				</dl>

				<div class="grafico" data-dias={JSON.stringify(dias)} data-pico={pico}>
					<div class="grafico__lienzo">
						<svg viewBox={`0 0 ${ANCHO} ${ALTO}`} preserveAspectRatio="none" aria-hidden="true">
							<defs>
								<linearGradient id="tablero-area" x1="0" y1="0" x2="0" y2="1">
									<stop offset="0" style="stop-color: var(--blue-900)" />
									<stop offset="1" style="stop-color: var(--surface-card-dark)" />
								</linearGradient>
							</defs>
							<path class="grafico__area" d={area} fill="url(#tablero-area)" />
							<path class="grafico__linea" d={linea} pathLength="1" fill="none" vector-effect="non-scaling-stroke" />
						</svg>
						<span class="grafico__guia" style={`transform: translateX(${dias[pico].x}%)`}></span>
						<span class="grafico__marcador" style={`transform: translate(${dias[pico].x}%, ${dias[pico].y}%)`}>
							<span class="grafico__pico"></span>
							<span class="grafico__etiqueta">{dias[pico].dia} {dias[pico].monto}</span>
						</span>
					</div>
					<div class="grafico__dias">
						{semana.map(({ dia }, i) => <span class:list={{ 'grafico__dia--marcado': i === pico }}>{dia}</span>)}
					</div>
				</div>

				<div class="movimientos">
					<strong class="movimientos__titulo">Últimos movimientos</strong>
					<ul>
						{
							movimientos.map(({ icono, texto, detalle, hora }, i) => (
								<li class:list={['movimiento', i === 0 ? 'movimiento--nuevo' : 'movimiento--previo']} style={`--i: ${i}`}>
									<span class="movimiento__icono">
										<Icono nombre={icono} size={18} />
									</span>
									<span class="movimiento__texto">
										{texto}
										<small>{detalle}</small>
									</span>
									<span class="movimiento__hora">{hora}</span>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>
	</div>

	<div class="tablero__aviso">
		<span class="aviso__icono">
			<Icono nombre="seal-check-duotone" size={20} />
		</span>
		<span>
			Presupuesto #218 aprobado
			<small>Ya es una orden de trabajo</small>
		</span>
	</div>
</div>

<script>
	// El gráfico sigue al cursor (o al dedo): la guía y el punto van al día más cercano y la
	// etiqueta dice cuánto se vendió. Al salir vuelve al pico de la semana.
	const grafico = document.querySelector<HTMLElement>('.tablero .grafico');
	if (grafico) {
		const dias: { dia: string; monto: string; x: number; y: number }[] = JSON.parse(grafico.dataset.dias!);
		const pico = Number(grafico.dataset.pico);
		const lienzo = grafico.querySelector('.grafico__lienzo')!;
		const guia = grafico.querySelector<HTMLElement>('.grafico__guia')!;
		const marcador = grafico.querySelector<HTMLElement>('.grafico__marcador')!;
		const etiqueta = grafico.querySelector('.grafico__etiqueta')!;
		const rotulos = grafico.querySelectorAll('.grafico__dias span');
		let actual = pico;
		let volver = 0;

		const marcar = (i: number) => {
			if (i === actual) return;
			actual = i;
			const { dia, monto, x, y } = dias[i];
			marcador.style.transform = `translate(${x}%, ${y}%)`;
			guia.style.transform = `translateX(${x}%)`;
			etiqueta.textContent = `${dia} ${monto}`;
			marcador.classList.toggle('grafico__marcador--derecha', i < 3);
			rotulos.forEach((rotulo, j) => rotulo.classList.toggle('grafico__dia--marcado', j === i));
		};

		const seguir = (evento: PointerEvent) => {
			clearTimeout(volver);
			const { left, width } = lienzo.getBoundingClientRect();
			const i = Math.floor(((evento.clientX - left) / width) * dias.length);
			marcar(Math.min(dias.length - 1, Math.max(0, i)));
			grafico.classList.add('grafico--activo');
		};

		const soltar = () => {
			grafico.classList.remove('grafico--activo');
			marcar(pico);
		};

		grafico.addEventListener('pointerdown', seguir);
		grafico.addEventListener('pointermove', seguir);
		// Con el mouse vuelve al salir; con el dedo, un rato después de soltar.
		grafico.addEventListener('pointerleave', (evento) => {
			if (evento.pointerType === 'mouse') soltar();
			else volver = window.setTimeout(soltar, 1500);
		});
	}
</script>

<style>
	@property --v {
		syntax: '<integer>';
		inherits: true;
		initial-value: 0;
	}

	@counter-style tres-cifras {
		system: extends decimal;
		pad: 3 '0';
	}

	/* --- El tablero: la ventana oscura (la card invertida de la sección) y, montados sobre sus
	   bordes, el chip de arriba y el aviso claro de abajo (la regla de profundidad de la marca). --- */
	/* Es un mock, no texto para copiar: sin el cursor de texto ni la selección. Lo que reacciona
	   al mouse lleva la manito (pedido del usuario, 2026-09-25). */
	.tablero {
		position: relative;
		padding-block: 20px 40px;
		cursor: default;
		user-select: none;
		-webkit-user-select: none;
	}

	.modulo,
	.periodo__opcion,
	.cifra,
	.movimiento,
	.grafico {
		cursor: pointer;
	}

	.ventana {
		display: grid;
		border: 1px solid var(--border-dark);
		border-radius: var(--radius-card-lg);
		background: var(--surface-card-dark);
		box-shadow: 0 32px 80px rgba(15, 36, 80, 0.28), 0 8px 24px rgba(15, 23, 42, 0.12);
		color: var(--text-body-light);
		font-size: 0.875rem;
		line-height: 1.35;
		overflow: clip;
	}

	.ventana__barra {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 20px;
		border-bottom: 1px solid var(--border-dark);
	}

	.ventana__barra strong {
		color: var(--text-heading-light);
		font-weight: var(--fw-bold);
	}

	/* El buscador es decorativo: da escala de app real. En el celular no entra. */
	.ventana__buscar {
		display: none;
		align-items: center;
		gap: 8px;
		flex: 1;
		max-width: 300px;
		padding: 8px 12px;
		border: 1px solid var(--border-dark);
		border-radius: var(--radius-pill);
		color: var(--text-muted-light);
		font-size: 0.8125rem;
	}

	/* En el celular la fecha deja su lugar al chip montado arriba a la derecha. */
	.ventana__fecha {
		display: none;
		color: var(--text-muted-light);
		font-size: 0.8125rem;
	}

	/* La columna va explícita: la implícita tomaba el ancho de la fila de módulos (overflow: clip
	   no la achica) y en el celular cortaba las cifras y el gráfico. */
	.ventana__cuerpo {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		min-width: 0;
	}

	/* --- Los módulos: en el celular, una fila que se corta en el borde (se ve que hay más); desde
	   640 px, la barra lateral de la app. --- */
	.modulos {
		display: flex;
		gap: 8px;
		padding: 12px 16px;
		border-bottom: 1px solid var(--border-dark);
		overflow: clip;
		mask-image: linear-gradient(90deg, #000 80%, transparent);
	}

	.modulo {
		display: inline-flex;
		flex: none;
		align-items: center;
		gap: 8px;
		padding: 8px 12px;
		border-radius: var(--radius-pill);
		color: var(--text-muted-light);
		font-weight: var(--fw-medium);
		white-space: nowrap;
	}

	.modulo--activo {
		background: var(--blue-950);
		color: var(--blue-100);
	}

	.modulo__aviso {
		display: grid;
		place-items: center;
		min-width: 22px;
		height: 22px;
		padding-inline: 6px;
		border-radius: var(--radius-pill);
		background: var(--cyan-300);
		color: var(--navy-950);
		font-size: 0.8125rem;
		font-weight: var(--fw-bold);
		line-height: 1;
	}

	/* Abajo queda aire para el aviso montado sobre el borde: no tapa el último movimiento. */
	.ventana__contenido {
		display: grid;
		gap: 16px;
		min-width: 0;
		padding: 16px 16px 40px;
	}

	.contenido__barra {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	/* "Datos de ejemplo" va arriba, junto al título: abajo lo taparía el aviso montado. */
	.contenido__titulo {
		display: grid;
	}

	.contenido__titulo small {
		color: var(--text-muted-light);
		font-size: 0.8125rem;
	}

	.contenido__barra strong,
	.movimientos__titulo {
		color: var(--text-heading-light);
		font-weight: var(--fw-semibold);
	}

	/* El selector de período: decorativo, el activo con el azul profundo (el de la marca es del botón). */
	/* Las dos opciones miden lo mismo: la pastilla se desliza a "Mes" con el mouse. */
	.periodo {
		position: relative;
		display: inline-grid;
		grid-template-columns: 1fr 1fr;
		padding: 3px;
		border: 1px solid var(--border-dark);
		border-radius: var(--radius-pill);
		color: var(--text-muted-light);
		font-size: 0.8125rem;
		font-weight: var(--fw-semibold);
	}

	.periodo::before {
		content: '';
		position: absolute;
		top: 3px;
		bottom: 3px;
		left: 3px;
		width: calc(50% - 3px);
		border-radius: var(--radius-pill);
		background: var(--brand-primary-deep);
		transition: transform 0.25s var(--curva-salida);
	}

	.periodo__opcion {
		position: relative;
		padding: 4px 10px;
		text-align: center;
		transition: color 0.2s ease;
	}

	.periodo__opcion--activa {
		color: var(--white);
	}

	/* --- Las tres cifras. En el celular, las ventas a lo ancho y las otras dos abajo. --- */
	.cifras {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 8px;
	}

	.cifra {
		display: grid;
		align-content: start;
		gap: 2px;
		padding: 12px;
		border: 1px solid transparent;
		border-radius: 14px;
		background: var(--navy-850);
		transition: border-color 0.2s ease, transform 0.25s var(--curva-salida);
	}

	.cifra:first-child {
		grid-column: 1 / -1;
	}

	.cifra dt {
		color: var(--text-muted-light);
		font-size: 0.8125rem;
		font-weight: var(--fw-medium);
	}

	.cifra dd {
		margin: 0;
	}

	.cifra__valor {
		color: var(--text-heading-light);
		font-size: 1.375rem;
		font-weight: var(--fw-bold);
		letter-spacing: -0.02em;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.cifra__variacion {
		color: var(--cyan-300);
		font-size: 0.8125rem;
		font-weight: var(--fw-semibold);
	}

	/* --- El gráfico: el SVG se estira al ancho; el trazo no se deforma (non-scaling-stroke) y el
	   punto del pico es HTML, así queda redondo. --- */
	/* El margen de arriba es para la etiqueta del pico, que sale por encima del lienzo. */
	.grafico {
		display: grid;
		gap: 8px;
		margin-top: 16px;
	}

	/* touch-action: el dedo que se desliza de costado mueve la guía; el que sube o baja, la página. */
	.grafico__lienzo {
		position: relative;
		height: 120px;
		touch-action: pan-y;
		/* Tres guías horizontales, recesivas: dan escala sin competir con la curva. */
		background:
			linear-gradient(var(--border-dark), var(--border-dark)) 0 15% / 100% 1px no-repeat,
			linear-gradient(var(--border-dark), var(--border-dark)) 0 50% / 100% 1px no-repeat,
			linear-gradient(var(--border-dark), var(--border-dark)) 0 100% / 100% 1px no-repeat;
	}

	.grafico__lienzo svg {
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.grafico__linea {
		stroke: var(--cyan-400);
		stroke-width: 2.5px;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-dasharray: 1;
		stroke-dashoffset: 0;
	}

	/* La guía y el marcador ocupan todo el lienzo: así se mueven con translate en % del lienzo
	   (solo transform), y el punto y la etiqueta cuelgan de su esquina de arriba a la izquierda. */
	.grafico__guia,
	.grafico__marcador {
		position: absolute;
		inset: 0;
		pointer-events: none;
		transition: transform 0.2s var(--curva-salida);
	}

	.grafico__guia {
		opacity: 0;
		transition: transform 0.2s var(--curva-salida), opacity 0.2s ease;
	}

	.grafico__guia::before {
		content: '';
		position: absolute;
		inset: 0 auto 0 0;
		border-left: 1px dashed var(--blue-400);
	}

	.grafico--activo .grafico__guia {
		opacity: 1;
	}

	.grafico__pico {
		position: absolute;
		top: 0;
		left: 0;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--cyan-400);
		box-shadow: 0 0 0 3px var(--surface-card-dark);
		transform: translate(-50%, -50%);
	}

	/* La etiqueta, arriba a la izquierda del punto; en los tres primeros días, a la derecha (a la
	   izquierda no entra). La ubica translate y no transform: transform es de su entrada. */
	.grafico__etiqueta {
		position: absolute;
		top: 0;
		left: 0;
		translate: -100% calc(-100% - 12px);
		transition: translate 0.2s var(--curva-salida);
		padding: 4px 10px;
		border-radius: var(--radius-pill);
		background: var(--cyan-300);
		color: var(--navy-950);
		font-size: 0.8125rem;
		font-weight: var(--fw-bold);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		box-shadow: 0 8px 20px rgba(2, 6, 18, 0.4);
	}

	.grafico__marcador--derecha .grafico__etiqueta {
		translate: 0 calc(-100% - 12px);
	}

	.grafico__dias {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		color: var(--text-muted-light);
		font-size: 0.8125rem;
		text-align: center;
	}

	.grafico__dias span {
		transition: color 0.2s ease;
	}

	.grafico__dias .grafico__dia--marcado {
		color: var(--text-heading-light);
		font-weight: var(--fw-semibold);
	}

	/* --- Los últimos movimientos: el de arriba es el que llega. --- */
	.movimientos {
		display: grid;
		gap: 8px;
	}

	.movimientos ul {
		display: grid;
		gap: 4px;
	}

	.movimiento {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 12px;
		padding: 8px;
		border-radius: 14px;
		transition: background-color 0.2s ease;
	}

	.movimiento--nuevo {
		background: rgba(34, 211, 238, 0.08);
	}

	.movimiento__icono {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 12px;
		background: var(--navy-850);
		color: var(--blue-300);
	}

	.movimiento--nuevo .movimiento__icono {
		background: var(--cyan-300);
		color: var(--navy-950);
	}

