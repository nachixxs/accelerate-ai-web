---
// El producto de la portada: el tablero de un negocio con varios sistemas adentro (órdenes, stock,
// caja, clientes, presupuestos), no un producto cerrado. Tres cifras que cuentan hacia arriba, la
// curva de ventas de la semana y los últimos movimientos, donde entra uno nuevo arriba.
// Son datos de ejemplo, y lo dice el propio tablero: no son resultados de un cliente.
// Es una imagen (role="img"), no una app para explorar: sin links, tooltips ni foco.
// En escritorio la historia corre una vez al cargar, en unos 3 segundos. En el celular el tablero
// queda debajo del botón y avanza con el scroll, con su propio timeline (--tablero).
import Icono from '../Icono.astro';

const modulos = [
	{ nombre: 'Resumen', icono: 'squares-four-duotone', activo: true },
	{ nombre: 'Órdenes', icono: 'clipboard-text-duotone', aviso: 8 },
	{ nombre: 'Stock', icono: 'package-duotone' },
	{ nombre: 'Caja', icono: 'cash-register-duotone' },
	{ nombre: 'Clientes', icono: 'users-three-duotone' },
	{ nombre: 'Presupuestos', icono: 'file-text-duotone' },
];

// Ventas por día, en miles de pesos. Suman 1.284,5 (el total de la primera cifra).
const semana = [
	{ dia: 'Lun', miles: 142.3 },
	{ dia: 'Mar', miles: 168.9 },
	{ dia: 'Mié', miles: 151.2 },
	{ dia: 'Jue', miles: 196.8 },
	{ dia: 'Vie', miles: 263.5 },
	{ dia: 'Sáb', miles: 312.4 },
	{ dia: 'Dom', miles: 49.4 },
];

// Geometría del gráfico: lienzo de 700 × 200, un punto al centro de cada una de las 7 columnas.
const ANCHO = 700;
const ALTO = 200;
const TOPE = 330; // miles: la línea de arriba de la escala
const x = (i: number) => 50 + i * 100;
const y = (miles: number) => ALTO - 10 - (miles / TOPE) * (ALTO - 30);
const puntos = semana.map(({ miles }, i) => `${x(i)},${y(miles).toFixed(1)}`);
const linea = `M${puntos.join(' L')}`;
const area = `${linea} L${x(6)},${ALTO} L${x(0)},${ALTO} Z`;
const pico = semana.reduce((max, d, i) => (d.miles > semana[max].miles ? i : max), 0);

const cifras = [
	{ nombre: 'Ventas', fin: 1284500, desde: 1000000, formato: 'millones', variacion: '+12 % vs. semana pasada' },
	{ nombre: 'Órdenes', fin: 142, desde: 0, formato: 'simple' },
	{ nombre: 'Ticket promedio', fin: 9045, desde: 5000, formato: 'miles' },
];
const texto = (n: number) => `${n > 999 ? '$ ' : ''}${n.toLocaleString('es-AR')}`;

// El primero es el que llega durante la animación; los otros dos ya estaban.
const movimientos = [
	{ icono: 'check-circle-duotone', texto: 'Orden #1043 terminada', detalle: 'Pasó sola a "Para entregar"', hora: '10:42' },
	{ icono: 'package-duotone', texto: 'Papel A4 bajo el mínimo', detalle: 'El pedido al proveedor ya está armado', hora: '10:15' },
	{ icono: 'cash-register-duotone', texto: 'Caja del lunes cerrada', detalle: 'Cuadró al peso', hora: 'Ayer' },
];
---

<div
	class="tablero"
	role="img"
	aria-label="Ejemplo con datos inventados: el tablero de un negocio con órdenes, stock, caja, clientes y presupuestos en un solo lugar. Muestra ventas de la semana por 1.284.500 pesos, 142 órdenes, un ticket promedio de 9.045 pesos, la curva de ventas con el pico el sábado y los últimos movimientos: una orden terminada, un producto bajo el mínimo con el pedido al proveedor armado y la caja del lunes cerrada."
>
	<span class="tablero__chip">
		<Icono nombre="lightning-duotone" size={16} />
		Al día sin pasar nada a mano
	</span>

	<div class="ventana">
		<div class="ventana__barra">
			<strong>Tu negocio</strong>
			<span class="ventana__buscar">
				<Icono nombre="magnifying-glass-duotone" size={16} />
				Buscar orden, cliente o producto
			</span>
			<span class="ventana__fecha">Martes 14</span>
		</div>

		<div class="ventana__cuerpo">
			<ul class="modulos">
				{
					modulos.map(({ nombre, icono, activo, aviso }, i) => (
						<li class:list={['modulo', { 'modulo--activo': activo }]} style={`--i: ${i}`}>
							<Icono nombre={icono} size={18} />
							{nombre}
							{aviso && <span class="modulo__aviso">{aviso}</span>}
						</li>
					))
				}
			</ul>

			<div class="ventana__contenido">
				<div class="contenido__barra">
					<span class="contenido__titulo">
						<strong>Esta semana</strong>
						<small>Datos de ejemplo</small>
					</span>
					<span class="periodo">
						<span class="periodo__activo">Semana</span>
						<span>Mes</span>
					</span>
				</div>

				<dl class="cifras">
					{
						cifras.map(({ nombre, fin, desde, formato, variacion }, i) => (
							<div class="cifra" style={`--i: ${i}`}>
								<dt>{nombre}</dt>
								<dd class={`cifra__valor cifra__valor--${formato}`} style={`--fin: ${fin}; --desde: ${desde}`}>
									<span class="cifra__texto">{texto(fin)}</span>
								</dd>
								{variacion && <dd class="cifra__variacion">{variacion}</dd>}
							</div>
						))
					}
				</dl>

				<div class="grafico">
					<div class="grafico__lienzo">
						<svg viewBox={`0 0 ${ANCHO} ${ALTO}`} preserveAspectRatio="none" aria-hidden="true">
							<defs>
								<linearGradient id="tablero-area" x1="0" y1="0" x2="0" y2="1">
									<stop offset="0" stop-color="#173872" />
									<stop offset="1" stop-color="#111b30" />
								</linearGradient>
							</defs>
							<path class="grafico__area" d={area} fill="url(#tablero-area)" />
							<path class="grafico__linea" d={linea} pathLength="1" fill="none" vector-effect="non-scaling-stroke" />
						</svg>
						<span
							class="grafico__pico"
							style={`left: ${(x(pico) / ANCHO) * 100}%; top: ${(y(semana[pico].miles) / ALTO) * 100}%`}
						>
							<span class="grafico__etiqueta">{semana[pico].dia} $ {Math.round(semana[pico].miles * 1000).toLocaleString('es-AR')}</span>
						</span>
					</div>
					<div class="grafico__dias">
						{semana.map(({ dia }, i) => <span class:list={{ 'grafico__dia--pico': i === pico }}>{dia}</span>)}
					</div>
				</div>

				<div class="movimientos">
					<strong class="movimientos__titulo">Últimos movimientos</strong>
					<ul>
						{
							movimientos.map(({ icono, texto, detalle, hora }, i) => (
								<li class:list={['movimiento', i === 0 ? 'movimiento--nuevo' : 'movimiento--previo']} style={`--i: ${i}`}>
									<span class="movimiento__icono">
										<Icono nombre={icono} size={18} />
									</span>
									<span class="movimiento__texto">
										{texto}
										<small>{detalle}</small>
									</span>
									<span class="movimiento__hora">{hora}</span>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>
	</div>

	<div class="tablero__aviso">
		<span class="aviso__icono">
			<Icono nombre="seal-check-duotone" size={20} />
		</span>
		<span>
			Presupuesto #218 aprobado
			<small>Ya es una orden de trabajo</small>
		</span>
	</div>
</div>

<style>
	@property --v {
		syntax: '<integer>';
		inherits: true;
		initial-value: 0;
	}

	@counter-style tres-cifras {
		system: extends decimal;
		pad: 3 '0';
	}

	/* --- El tablero: la ventana oscura (la card invertida de la sección) y, montados sobre sus
	   bordes, el chip de arriba y el aviso claro de abajo (la regla de profundidad de la marca). --- */
	.tablero {
		position: relative;
		padding-block: 20px 40px;
	}

	.ventana {
		display: grid;
		border: 1px solid var(--border-dark);
		border-radius: var(--radius-card-lg);
		background: var(--surface-card-dark);
		box-shadow: 0 32px 80px rgba(15, 36, 80, 0.28), 0 8px 24px rgba(15, 23, 42, 0.12);
		color: var(--text-body-light);
		font-size: 0.875rem;
		line-height: 1.35;
		overflow: clip;
	}

	.ventana__barra {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 20px;
		border-bottom: 1px solid var(--border-dark);
	}

	.ventana__barra strong {
		color: var(--text-heading-light);
		font-weight: var(--fw-bold);
	}

	/* El buscador es decorativo: da escala de app real. En el celular no entra. */
	.ventana__buscar {
		display: none;
		align-items: center;
		gap: 8px;
		flex: 1;
		max-width: 300px;
		padding: 8px 12px;
		border: 1px solid var(--border-dark);
		border-radius: var(--radius-pill);
		color: var(--text-muted-light);
		font-size: 0.8125rem;
	}

	/* En el celular la fecha deja su lugar al chip montado arriba a la derecha. */
	.ventana__fecha {
		display: none;
		color: var(--text-muted-light);
		font-size: 0.8125rem;
	}

	.ventana__cuerpo {
		display: grid;
		min-width: 0;
	}

	/* --- Los módulos: en el celular, una fila que se corta en el borde (se ve que hay más); desde
	   640 px, la barra lateral de la app. --- */
	.modulos {
		display: flex;
		gap: 8px;
		padding: 12px 16px;
		border-bottom: 1px solid var(--border-dark);
		overflow: clip;
		mask-image: linear-gradient(90deg, #000 80%, transparent);
	}

	.modulo {
		display: inline-flex;
		flex: none;
		align-items: center;
		gap: 8px;
		padding: 8px 12px;
		border-radius: var(--radius-pill);
		color: var(--text-muted-light);
		font-weight: var(--fw-medium);
		white-space: nowrap;
	}

	.modulo--activo {
		background: var(--blue-950);
		color: var(--blue-100);
	}

	.modulo__aviso {
		display: grid;
		place-items: center;
		min-width: 22px;
		height: 22px;
		padding-inline: 6px;
		border-radius: var(--radius-pill);
		background: var(--cyan-300);
		color: var(--navy-950);
		font-size: 0.8125rem;
		font-weight: var(--fw-bold);
		line-height: 1;
	}

	.ventana__contenido {
		display: grid;
		gap: 16px;
		min-width: 0;
		padding: 16px;
	}

	.contenido__barra {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	/* "Datos de ejemplo" va arriba, junto al título: abajo lo taparía el aviso montado. */
	.contenido__titulo {
		display: grid;
	}

	.contenido__titulo small {
		color: var(--text-muted-light);
		font-size: 0.8125rem;
	}

	.contenido__barra strong,
	.movimientos__titulo {
		color: var(--text-heading-light);
		font-weight: var(--fw-semibold);
	}

	/* El selector de período: decorativo, el activo con el azul profundo (el de la marca es del botón). */
	.periodo {
		display: inline-flex;
		padding: 3px;
		border: 1px solid var(--border-dark);
		border-radius: var(--radius-pill);
		color: var(--text-muted-light);
		font-size: 0.8125rem;
		font-weight: var(--fw-semibold);
	}

	.periodo > span {
		padding: 4px 10px;
		border-radius: var(--radius-pill);
	}

	.periodo .periodo__activo {
		background: var(--brand-primary-deep);
		color: var(--white);
	}

	/* --- Las tres cifras. En el celular, las ventas a lo ancho y las otras dos abajo. --- */
	.cifras {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 8px;
	}

	.cifra {
		display: grid;
		align-content: start;
		gap: 2px;
		padding: 12px;
		border-radius: 14px;
		background: var(--navy-850);
	}

	.cifra:first-child {
		grid-column: 1 / -1;
	}

	.cifra dt {
		color: var(--text-muted-light);
		font-size: 0.8125rem;
		font-weight: var(--fw-medium);
	}

	.cifra dd {
		margin: 0;
	}

	.cifra__valor {
		color: var(--text-heading-light);
		font-size: 1.375rem;
		font-weight: var(--fw-bold);
		letter-spacing: -0.02em;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.cifra__variacion {
		color: var(--cyan-300);
		font-size: 0.8125rem;
		font-weight: var(--fw-semibold);
	}

	/* --- El gráfico: el SVG se estira al ancho; el trazo no se deforma (non-scaling-stroke) y el
	   punto del pico es HTML, así queda redondo. --- */
	.grafico {
		display: grid;
		gap: 8px;
	}

	.grafico__lienzo {
		position: relative;
		height: 120px;
		/* Tres guías horizontales, recesivas: dan escala sin competir con la curva. */
		background:
			linear-gradient(var(--border-dark), var(--border-dark)) 0 15% / 100% 1px no-repeat,
			linear-gradient(var(--border-dark), var(--border-dark)) 0 50% / 100% 1px no-repeat,
			linear-gradient(var(--border-dark), var(--border-dark)) 0 100% / 100% 1px no-repeat;
	}

	.grafico__lienzo svg {
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.grafico__linea {
		stroke: var(--cyan-400);
		stroke-width: 2.5px;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-dasharray: 1;
		stroke-dashoffset: 0;
	}

	.grafico__pico {
		position: absolute;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--cyan-400);
		box-shadow: 0 0 0 3px var(--surface-card-dark);
		transform: translate(-50%, -50%);
	}

	/* La etiqueta del pico, arriba a la izquierda del punto: a la derecha no entra. */
	.grafico__etiqueta {
		position: absolute;
		right: 50%;
		bottom: calc(100% + 8px);
		padding: 4px 10px;
		border-radius: var(--radius-pill);
		background: var(--cyan-300);
		color: var(--navy-950);
		font-size: 0.8125rem;
		font-weight: var(--fw-bold);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		box-shadow: 0 8px 20px rgba(2, 6, 18, 0.4);
	}

	.grafico__dias {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		color: var(--text-muted-light);
		font-size: 0.8125rem;
		text-align: center;
	}

	.grafico__dias .grafico__dia--pico {
		color: var(--text-heading-light);
		font-weight: var(--fw-semibold);
	}

	/* --- Los últimos movimientos: el de arriba es el que llega. --- */
	.movimientos {
		display: grid;
		gap: 8px;
	}

	.movimientos ul {
		display: grid;
		gap: 4px;
	}

	.movimiento {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 12px;
		padding: 8px;
		border-radius: 14px;
	}

	.movimiento--nuevo {
		background: rgba(34, 211, 238, 0.08);
	}

	.movimiento__icono {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 12px;
		background: var(--navy-850);
		color: var(--blue-300);
	}

	.movimiento--nuevo .movimiento__icono {
		background: var(--cyan-300);
		color: var(--navy-950);
	}

	.movimiento__texto {
		display: grid;
		min-width: 0;
		color: var(--text-heading-light);
		font-weight: var(--fw-semibold);
	}

	.movimiento__texto small {
		color: var(--text-muted-light);
		font-size: 0.8125rem;
		font-weight: var(--fw-regular);
	}

	.movimiento__hora {
		align-self: start;
		padding-top: 2px;
		color: var(--text-muted-light);
		font-size: 0.8125rem;
		font-variant-numeric: tabular-nums;
	}

	/* --- Lo montado sobre los bordes --- */
	.tablero__chip {
		position: absolute;
		top: 20px;
		right: 16px;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 10px 16px;
		border-radius: var(--radius-pill);
		background: var(--cyan-300);
		color: var(--navy-950);
		font-size: 0.8125rem;
		font-weight: var(--fw-semibold);
		line-height: 1.2;
		white-space: nowrap;
		box-shadow: var(--shadow-elevada);
		transform: translateY(-50%);
	}

	/* El aviso claro: papel sobre la ventana oscura, montado sobre el borde de abajo. */
	.tablero__aviso {
		position: absolute;
		right: 16px;
		bottom: 0;
		z-index: 1;
		display: flex;
		align-items: center;
		gap: 12px;
		max-width: calc(100% - 32px);
		padding: 12px 16px 12px 12px;
		border: 1px solid var(--border-light);
		border-radius: 18px;
		background: var(--white);
		color: var(--text-heading-dark);
		font-size: 0.875rem;
		font-weight: var(--fw-semibold);
		line-height: 1.3;
		box-shadow: var(--shadow-card);
	}

	.tablero__aviso > span:last-child {
		display: grid;
	}

	.tablero__aviso small {
		color: var(--text-muted-dark);
		font-size: 0.8125rem;
		font-weight: var(--fw-regular);
	}

	.aviso__icono {
		display: grid;
		flex: none;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 12px;
		background: var(--blue-50);
		color: var(--brand-primary-deep);
	}

	@media (min-width: 480px) {
		.cifras {
			grid-template-columns: 1.4fr 1fr 1.2fr;
		}

		.cifra:first-child {
			grid-column: auto;
		}
	}

	/* Desde 640 px, la app completa: barra lateral de módulos y buscador. */
	@media (min-width: 640px) {
		.ventana__buscar {
			display: inline-flex;
		}

		.ventana__fecha {
			display: block;
		}

		.ventana__barra strong {
			min-width: 152px;
		}

		.ventana__cuerpo {
			grid-template-columns: 184px minmax(0, 1fr);
		}

		.modulos {
			flex-direction: column;
			gap: 4px;
			padding: 16px 12px;
			border-right: 1px solid var(--border-dark);
			border-bottom: 0;
			mask-image: none;
		}

		.modulo {
			border-radius: 12px;
		}

		.modulo__aviso {
			margin-left: auto;
		}

		.ventana__contenido {
			padding: 20px;
		}

		.grafico__lienzo {
			height: 140px;
		}

		.tablero__chip {
			right: auto;
			left: 216px;
		}

		.tablero {
			padding-bottom: 20px;
		}

		/* Con la barra lateral, el aviso se monta sobre el borde izquierdo, en el lugar libre que
		   queda abajo de los módulos: así se ve en la primera pantalla. */
		.tablero__aviso {
			top: 51%;
			right: auto;
			bottom: auto;
			left: -24px;
		}
	}

	@media (min-width: 1024px) {
		.cifra__valor {
			font-size: 1.5rem;
		}

		.tablero__aviso {
			left: -40px;
		}
	}

	/* --- Movimiento. Sin prefers-reduced-motion queda todo visible y quieto. --- */
	@keyframes tablero-llega {
		from { opacity: 0; transform: perspective(1600px) translateY(40px) rotateX(10deg); }
	}

	@keyframes tablero-aparece {
		from { opacity: 0; }
	}

	@keyframes tablero-sube {
		from { opacity: 0; transform: translateY(12px); }
	}

	@keyframes tablero-desde-izquierda {
		from { opacity: 0; transform: translateX(-12px); }
	}

	@keyframes tablero-linea {
		from { stroke-dashoffset: 1; }
	}

	@keyframes tablero-pico {
		from { opacity: 0; transform: translate(-50%, -50%) scale(0.4); }
	}

	@keyframes tablero-contar {
		from { --v: var(--desde); }
		to { --v: var(--fin); }
	}

	/* El movimiento nuevo entra desde arriba y su fondo cian se apaga despacio; los otros dos
	   bajan un lugar para hacerle espacio. */
	@keyframes tablero-nuevo {
		from { opacity: 0; transform: translateY(-16px); }
	}

	@keyframes tablero-fondo-se-apaga {
		from { background-color: rgba(34, 211, 238, 0.24); }
	}

	@keyframes tablero-baja-un-lugar {
		from { transform: translateY(calc(-100% - 4px)); }
	}

	@keyframes tablero-chip {
		from { opacity: 0; transform: translateY(-50%) scale(0.9); }
	}

	@keyframes tablero-aviso {
		from { opacity: 0; transform: translateY(24px) scale(0.96); }
	}

	@media (prefers-reduced-motion: no-preference) {
		.ventana {
