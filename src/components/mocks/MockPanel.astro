	/* Las cifras cuentan hacia arriba con un contador de CSS. El texto real queda en el HTML
	   para lectores y navegadores sin soporte; donde el contador anda, lo reemplaza. */
	@media (prefers-reduced-motion: no-preference) {
		@supports (width: mod(10px, 3px)) {
			.cifra__valor {
				animation: tablero-contar 1.4s var(--curva-salida) 0.7s both;
			}

			.cifra__texto {
				display: none;
			}

			.cifra__valor--simple::after {
				counter-reset: v var(--v);
				content: counter(v);
			}

			.cifra__valor--miles::after {
				counter-reset: k calc(round(down, var(--v) / 1000)) u calc(mod(var(--v), 1000));
				content: '$ ' counter(k) '.' counter(u, tres-cifras);
			}

			.cifra__valor--millones::after {
				counter-reset:
					m calc(round(down, var(--v) / 1000000))
					k calc(mod(round(down, var(--v) / 1000), 1000))
					u calc(mod(var(--v), 1000));
				content: '$ ' counter(m) '.' counter(k, tres-cifras) '.' counter(u, tres-cifras);
			}
		}
	}

	/* En el celular el tablero queda debajo del botón: si la historia corriera al cargar,
	   terminaría antes de que llegues. En tablet ya se ve casi entero en la primera pantalla y
	   corre al cargar, como en escritorio. En el celular cada parte se arma cuando entra en pantalla, con su
	   propio timeline: lo que ya se ve al cargar (la ventana, los módulos, el chip) entra con el
	   tiempo, y lo que está más abajo espera a que llegues, en cualquier alto de pantalla. */
	@media (prefers-reduced-motion: no-preference) and (max-width: 639px) {
		@supports (animation-timeline: view()) {
			.cifras { view-timeline: --tablero-cifras block; }
			.grafico { view-timeline: --tablero-grafico block; }
			.movimientos { view-timeline: --tablero-movimientos block; }

			.cifra,
			.grafico__linea,
			.grafico__area,
			.grafico__pico,
			.grafico__etiqueta,
			.movimiento--previo,
			.movimiento--nuevo,
			.tablero__aviso {
				animation-delay: 0s;
				animation-duration: auto;
			}

			/* Las cards de las cifras están ocultas hasta que llegás: el conteo va atado al mismo
			   timeline, un poco después, para que se vea contar y no aparezca ya terminado. */
			.cifra {
				animation-timeline: --tablero-cifras;
				animation-range: entry 20% entry 90%;
			}

			.cifra__valor {
				animation-delay: 0s;
				animation-duration: auto;
				animation-timeline: --tablero-cifras;
				animation-range: entry 40% cover 50%;
			}

			.grafico__linea,
			.grafico__area,
			.grafico__pico,
			.grafico__etiqueta {
				animation-timeline: --tablero-grafico;
			}

			.grafico__linea { animation-range: entry 40% cover 50%; }
			.grafico__area { animation-range: entry 90% cover 50%; }
			.grafico__pico { animation-range: cover 45% cover 52%; }
			.grafico__etiqueta { animation-range: cover 50% cover 56%; }

			.movimiento--previo,
			.movimiento--nuevo {
				animation-timeline: --tablero-movimientos;
			}

			.movimiento--previo { animation-range: entry 20% entry 70%, cover 30% cover 42%; }
			.movimiento--nuevo { animation-range: cover 30% cover 42%, cover 30% cover 60%; }

			.tablero__aviso {
				animation-timeline: view();
				animation-range: entry 30% entry 100%;
			}
		}
	}

	/* Movimiento reducido: la versión suave. Solo fundidos cortos, sin nada que se desplace ni
	   cuente. */
	@media (prefers-reduced-motion: reduce) {
