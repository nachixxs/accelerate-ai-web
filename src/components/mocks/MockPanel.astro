	}

	@keyframes tablero-sube {
		from { opacity: 0; transform: translateY(12px); }
	}

	@keyframes tablero-desde-izquierda {
		from { opacity: 0; transform: translateX(-12px); }
	}

	@keyframes tablero-linea {
		from { stroke-dashoffset: 1; }
	}

	@keyframes tablero-pico {
		from { opacity: 0; transform: translate(-50%, -50%) scale(0.4); }
	}

	@keyframes tablero-contar {
		from { --v: var(--desde); }
		to { --v: var(--fin); }
	}

	/* El movimiento nuevo entra desde arriba y su fondo cian se apaga despacio; los otros dos
	   bajan un lugar para hacerle espacio. */
	@keyframes tablero-nuevo {
