		}

		.movimiento--nuevo {
			animation:
				tablero-nuevo 0.5s var(--curva-salida) 2.35s both,
				tablero-fondo-se-apaga 2s var(--curva-salida) 2.35s both;
		}

		.tablero__chip {
			animation: tablero-chip 0.4s var(--curva-salida) 2.7s both;
		}

		.tablero__aviso {
			animation: tablero-aviso 0.6s var(--curva-salida) 3s both;
