---
// Mock de "Órdenes de trabajo": el tablero de una imprenta con cuatro columnas, de la entrada a la
// entrega. Con el scroll, una orden terminada cruza sola de "En proceso" a "Para entregar" y los
// contadores de las dos columnas se actualizan. Son datos de ejemplo, y lo dice el propio mock.
// El estado de base es el final (la orden ya en "Para entregar"): sin soporte de animaciones
// atadas al scroll, o con movimiento reducido, se ve completo y quieto.
// En el celular entran dos columnas: quedan las dos entre las que cruza la orden.
// Se anima con el timeline --celda de la card que lo contiene.
import Icono from '../Icono.astro';

type Orden = { numero: number; cliente: string; trabajo: string; fecha: string; quien: string; avance?: number; urgente?: boolean };

const columnas: { nombre: string; clase: string; antes: number; despues: number; ordenes: Orden[]; hueco?: boolean }[] = [
	{
		nombre: 'Recibidas',
		clase: 'recibidas',
		antes: 2,
		despues: 2,
		ordenes: [
			{ numero: 1048, cliente: 'Estudio Paz', trabajo: '200 tarjetas', fecha: 'Jue 25', quien: 'JM' },
			{ numero: 1049, cliente: 'Taller Sosa', trabajo: '30 carpetas', fecha: 'Vie 26', quien: 'LR', urgente: true },
		],
	},
	{
		nombre: 'En proceso',
		clase: 'proceso',
		antes: 2,
		despues: 1,
		ordenes: [{ numero: 1041, cliente: 'Club Norte', trabajo: 'Banner 3 × 1 m', fecha: 'Hoy', quien: 'JM', avance: 70 }],
		hueco: true,
	},
	{
		nombre: 'Para entregar',
		clase: 'entregar',
		antes: 1,
		despues: 2,
		ordenes: [{ numero: 1039, cliente: 'Kiosco Rivas', trabajo: '50 afiches A3', fecha: 'Listo', quien: 'AG', avance: 100 }],
	},
	{
		nombre: 'Entregadas',
		clase: 'entregadas',
		antes: 14,
		despues: 14,
		ordenes: [
			{ numero: 1031, cliente: 'Óptica Mar', trabajo: 'Folletos', fecha: 'Lun 22', quien: 'AG' },
			{ numero: 1036, cliente: 'Farmacia Luz', trabajo: 'Recetarios', fecha: 'Lun 22', quien: 'LR' },
		],
	},
];
---

<div
	class="ordenes"
	role="img"
	aria-label="Ejemplo con datos inventados: el tablero de órdenes de trabajo de una imprenta, con columnas de recibidas, en proceso, para entregar y entregadas. Cada orden dice cliente, trabajo, fecha de entrega, quién la tiene y cuánto avanzó. Una orden terminada pasa sola de en proceso a para entregar."
>
	<div class="ordenes__barra">
		<strong>Órdenes de trabajo</strong>
		<span class="ordenes__semana">Semana del 22 al 26</span>
		<span class="ordenes__nueva">
			<Icono nombre="plus-bold" size={14} />
			Nueva orden
		</span>
	</div>

	<p class="ordenes__pista">
		<Icono nombre="arrows-out-cardinal-duotone" size={14} />
		Arrastrá una orden entre columnas
	</p>

	<div class="columnas">
		{
			columnas.map(({ nombre, clase, antes, despues, ordenes, hueco }, c) => (
				<div class={`columna columna--${clase}`}>
					<div class="columna__cabecera">
						<span class="columna__nombre">
							<span class="columna__punto" />
							{nombre}
						</span>
						<span class:list={['cuenta', { 'cuenta--cambia': antes !== despues }]}>
							<span class="cuenta__despues">{despues}</span>
							{antes !== despues && <span class="cuenta__antes">{antes}</span>}
						</span>
					</div>

					{ordenes.map(({ numero, cliente, trabajo, fecha, quien, avance, urgente }, i) => (
						<div class="orden" style={`--i: ${c + i}`}>
							<div class="orden__arriba">
								<span class="orden__numero">#{numero}</span>
								{urgente && <span class="orden__urgente">Urgente</span>}
							</div>
							<span class="orden__cliente">
								{cliente}
								<small>{trabajo}</small>
							</span>
							{avance !== undefined && (
								<span class="orden__avance">
									<span style={`--avance: ${avance / 100}`} />
								</span>
							)}
							<div class="orden__abajo">
								<span class="orden__fecha">
									<Icono nombre={avance === 100 ? 'check-circle-duotone' : 'calendar-blank-duotone'} size={14} />
									{fecha}
								</span>
								<span class="orden__quien">{quien}</span>
							</div>
						</div>
					))}

					{hueco && <div class="hueco" />}

					{clase === 'entregar' && (
						<div class="hueco hueco--recibe">
							<div class="orden orden--cruza">
								<div class="orden__arriba">
									<span class="orden__numero">#1044</span>
								</div>
								<span class="orden__cliente">
									Casa Ferro
									<small>Lona para vidriera</small>
								</span>
								<span class="orden__avance">
									<span class="orden__avance-cruza" style="--avance: 1" />
								</span>
								<div class="orden__abajo">
									<span class="orden__fecha">
										<Icono nombre="check-circle-duotone" size={14} />
										Lista
									</span>
									<span class="orden__quien">AG</span>
								</div>
							</div>
						</div>
					)}
				</div>
			))
		}
	</div>

	<p class="ordenes__nota">Datos de ejemplo</p>

	<span class="ordenes__chip">
		<Icono nombre="lightning-duotone" size={16} />
		Terminada: pasó sola a entregar
	</span>
</div>

<script>
	import { movimientoReducido } from '../../scripts/contar';

	// Arrastrar una orden a otra columna: solo con mouse (los dedos siguen haciendo scroll). La
	// card sigue al puntero con `translate`, no `transform`, para no pisar la animación de scroll
	// de la orden que cruza. Recién arrastra después de 4 px, así un clic simple no hace nada.
	const tablero = document.querySelector<HTMLElement>('.ordenes');
	if (tablero) {
		const columnas = [...tablero.querySelectorAll<HTMLElement>('.columna')];
		const cartas = [...tablero.querySelectorAll<HTMLElement>('.orden:not(.orden--cruza)')];

		// El chip se estampa por tiempo al verse, no por un tramo corto de scroll. Sin JS o con
		// reducción queda en su estado final (ver la clase base en el CSS).
		const chip = tablero.querySelector<HTMLElement>('.ordenes__chip');
		if (chip && !movimientoReducido()) {
			chip.classList.add('ordenes__chip--espera');
			const observadorChip = new IntersectionObserver(
				(entradas) => {
					if (!entradas.some((e) => e.isIntersecting)) return;
					observadorChip.disconnect();
					chip.classList.remove('ordenes__chip--espera');
					chip.classList.add('ordenes__chip--vista');
				},
				{ threshold: 0.6 },
			);
			observadorChip.observe(chip);
		}

		const columnaBajo = (x: number, y: number) =>
			document.elementFromPoint(x, y)?.closest<HTMLElement>('.columna') ?? null;

		// El cubic-bezier repite --curva-salida: Element.animate() no puede leer una custom
		// property en `easing`.
		const curvaSalida = 'cubic-bezier(0.16, 1, 0.3, 1)';

		const sumarContador = (columna: HTMLElement, delta: number) => {
			const cuenta = columna.querySelector<HTMLElement>('.cuenta__despues');
			if (!cuenta) return;
			cuenta.textContent = String(Number(cuenta.textContent) + delta);
			cuenta.animate([{ transform: 'scale(1)' }, { transform: 'scale(1.12)' }, { transform: 'scale(1)' }], {
				duration: 200,
				easing: curvaSalida,
			});
		};

		// FLIP completo: antes de mover la carta, mide todo lo que puede correrse en las dos
		// columnas (cartas y huecos) y anima la diferencia a cero después del insertBefore. Sin
		// esto, solo la carta soltada tenía transición; sus hermanas saltaban de golpe.
		const medirHermanas = (origen: HTMLElement, destino: HTMLElement, saltar: HTMLElement) => {
			const elementos = new Set([
				...origen.querySelectorAll<HTMLElement>('.orden:not(.orden--cruza), .hueco'),
				...destino.querySelectorAll<HTMLElement>('.orden:not(.orden--cruza), .hueco'),
			]);
			elementos.delete(saltar);
			return new Map([...elementos].map((el) => [el, el.getBoundingClientRect()]));
		};

		const aplicarFlip = (posiciones: Map<HTMLElement, DOMRect>) => {
			posiciones.forEach((antes, el) => {
				const despues = el.getBoundingClientRect();
				const dx = antes.left - despues.left;
				const dy = antes.top - despues.top;
				if (!dx && !dy) return;
				el.style.transition = 'none';
				el.style.translate = `${dx}px ${dy}px`;
				el.getBoundingClientRect(); // fuerza el reflujo antes de volver a animar
				el.style.transition = '';
				const limpiar = () => (el.style.translate = '');
				el.addEventListener('transitionend', limpiar, { once: true });
				setTimeout(limpiar, 250);
				requestAnimationFrame(() => (el.style.translate = '0px 0px'));
			});
		};

		cartas.forEach((carta) => {
			let bajado = false;
			let arrastrando = false;
			let x0 = 0;
			let y0 = 0;

			carta.addEventListener('pointerdown', (evento) => {
				if (evento.pointerType !== 'mouse' || evento.button !== 0) return;
				bajado = true;
				x0 = evento.clientX;
				y0 = evento.clientY;
			});

			carta.addEventListener('pointermove', (evento) => {
				if (!bajado || !(evento.buttons & 1)) {
					bajado = false;
					return;
				}
				const dx = evento.clientX - x0;
				const dy = evento.clientY - y0;
				if (!arrastrando) {
					if (Math.hypot(dx, dy) < 4) return;
					arrastrando = true;
					carta.setPointerCapture(evento.pointerId);
					carta.classList.add('orden--arrastrando');
					// Solo rotate y scale llevan transición corta (el gesto de "levantar"): translate
					// queda sin transición y sigue al puntero 1:1, sin el retraso de los otros dos.
					carta.style.transition = `rotate 150ms ${curvaSalida}, scale 150ms ${curvaSalida}`;
					carta.style.rotate = '2deg';
					carta.style.scale = '1.04';
				}
				carta.style.translate = `${dx}px ${dy}px`;
				const destino = columnaBajo(evento.clientX, evento.clientY);
				columnas.forEach((columna) => columna.classList.toggle('columna--destino', columna === destino));
			});

			const soltar = (evento: PointerEvent) => {
				bajado = false;
				columnas.forEach((columna) => columna.classList.remove('columna--destino'));
				if (!arrastrando) return;
				arrastrando = false;

				const origen = carta.parentElement as HTMLElement;
				const destino = columnaBajo(evento.clientX, evento.clientY);
				const antes = carta.getBoundingClientRect();
				if (destino && destino !== origen) {
					const posiciones = medirHermanas(origen, destino, carta);
					destino.insertBefore(carta, destino.querySelector('.hueco'));
					sumarContador(origen, -1);
					sumarContador(destino, 1);
					aplicarFlip(posiciones);
				}
				const despues = carta.getBoundingClientRect();

				carta.classList.remove('orden--arrastrando');
				carta.style.translate = `${antes.left - despues.left}px ${antes.top - despues.top}px`;
				carta.getBoundingClientRect(); // fuerza el reflujo antes de volver a animar
				carta.style.transition = '';

				// Al llegar, se limpian los estilos inline (si no, le ganan al :hover y la carta ya no
				// se levanta). El transitionend cubre el caso normal; el timeout, cuando no hay nada
				// que transicionar (ej. soltar en el mismo lugar, sin desplazamiento real).
				const limpiar = () => {
					carta.style.translate = '';
					carta.style.rotate = '';
					carta.style.scale = '';
				};
				carta.addEventListener('transitionend', limpiar, { once: true });
				setTimeout(limpiar, 250);

				requestAnimationFrame(() => {
					carta.style.translate = '0px 0px';
					carta.style.rotate = '0deg';
					carta.style.scale = '1';
				});
			};

			carta.addEventListener('pointerup', soltar);
			carta.addEventListener('pointercancel', soltar);
		});
	}
</script>

<style>
	.ordenes {
		--separacion: 12px;
		container-type: inline-size;
		position: relative;
		display: grid;
		gap: 16px;
		padding: 16px 16px 0;
		border: 1px solid var(--border-dark);
		border-radius: var(--radius-card);
		background: var(--navy-900);
		color: var(--text-body-light);
		font-size: 0.875rem;
		line-height: 1.35;
		cursor: default;
		user-select: none;
		-webkit-user-select: none;
	}

	.ordenes__barra {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 12px;
	}

	.ordenes__barra strong {
		color: var(--text-heading-light);
		font-weight: var(--fw-bold);
	}

	.ordenes__semana {
		color: var(--text-muted-light);
		font-size: 0.8125rem;
	}

	.ordenes__nueva {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-left: auto;
		padding: 6px 12px;
		border: 1px solid var(--border-dark);
		border-radius: var(--radius-pill);
		font-size: 0.8125rem;
		font-weight: var(--fw-semibold);
	}

	/* La pista de arrastre: solo tiene sentido donde hay mouse. */
	.ordenes__pista {
		display: none;
	}

	@media (hover: hover) and (pointer: fine) {
		.ordenes__pista {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			margin: -4px 0 0;
			color: var(--text-muted-light);
			font-size: 0.8125rem;
		}
	}

	/* --- Las columnas: dos en el celular (las de la orden que cruza), cuatro desde tablet. --- */
	.columnas {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--separacion);
	}

	.columna {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-content: start;
		gap: 10px;
		min-width: 0;
	}

	/* Después de .columna, que les daría display: grid. */
	.columna--recibidas,
	.columna--entregadas {
		display: none;
	}

	.columna__cabecera {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		padding-inline: 4px;
	}

	.columna__nombre {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-width: 0;
		overflow: hidden;
		color: var(--text-heading-light);
		font-size: 0.8125rem;
		font-weight: var(--fw-semibold);
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.columna__punto {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--text-muted-light);
	}

	.columna--proceso .columna__punto { background: var(--cyan-400); }
	.columna--entregar .columna__punto { background: var(--blue-300); }
	.columna--entregadas .columna__punto { background: var(--navy-700); }

	/* El contador: el valor final en el HTML; el de antes se funde encima y se va cuando la orden
	   llega. */
	.cuenta {
		display: grid;
		color: var(--text-muted-light);
		font-size: 0.8125rem;
		font-variant-numeric: tabular-nums;
	}

	.cuenta > span {
		grid-area: 1 / 1;
		text-align: right;
	}

	.cuenta__antes {
		opacity: 0;
	}

	/* --- Cada orden: datos del negocio (vence, quién, avance), no una tarjeta vacía. --- */
	.orden {
		position: relative;
		display: grid;
		gap: 8px;
		padding: 12px;
		border: 1px solid var(--border-dark);
		border-radius: 12px;
		background: var(--navy-850);
		transition:
			translate 0.2s var(--curva-salida),
			rotate 0.2s var(--curva-salida),
			scale 0.2s var(--curva-salida);
	}

	/* La sombra del hover, en su propia capa que solo cambia de opacidad: animar box-shadow
	   directo repinta en cada cuadro (ver BotonWhatsApp.astro). */
	.orden::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: inherit;
		box-shadow: var(--shadow-elevada-oscura);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s;
	}

	.orden__arriba,
	.orden__abajo {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
	}

	.orden__numero,
	.orden__fecha {
		color: var(--text-muted-light);
		font-size: 0.8125rem;
		font-variant-numeric: tabular-nums;
	}

	.orden__fecha {
		display: inline-flex;
		align-items: center;
		gap: 4px;
	}

	.orden__urgente {
		padding: 4px 8px;
		border-radius: var(--radius-pill);
		background: var(--blue-900);
		color: var(--blue-100);
		font-size: 0.8125rem;
		font-weight: var(--fw-semibold);
		line-height: 1;
	}

	.orden__cliente {
		display: grid;
		color: var(--text-heading-light);
		font-weight: var(--fw-semibold);
	}

	.orden__cliente small {
		color: var(--text-muted-light);
		font-size: 0.8125rem;
		font-weight: var(--fw-regular);
	}

	.orden__avance {
		height: 4px;
		border-radius: 4px;
		background: var(--border-dark);
		overflow: clip;
	}

	.orden__avance > span {
		display: block;
		height: 100%;
		background: var(--cyan-400);
		transform-origin: left;
		transform: scaleX(var(--avance));
	}

	.orden__quien {
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		background: var(--blue-800);
		color: var(--blue-100);
		font-size: 0.8125rem;
		font-weight: var(--fw-bold);
	}

	/* El lugar vacío: ocupa el alto de una carta para que "En proceso" y "Para entregar" queden
	   parejas, pero no se ve: es un espaciador, no una caja vacía. Con movimiento, se ve dashed
	   mientras la orden todavía está ahí y se funde justo cuando termina de cruzar (ver --celda
	   más abajo); sin JS o con reducción, el estado final ya es invisible. */
	.hueco {
		min-height: 136px;
		border: 1px dashed var(--navy-700);
		border-radius: 12px;
		opacity: 0;
	}

	/* En el flujo, tapando el hueco que la recibe: si el texto baja de línea, el hueco crece con ella.
	   Este sí tiene contenido siempre (la orden que cruza), así que va opaco. */
	.hueco--recibe {
		display: grid;
		min-height: 0;
		opacity: 1;
	}

	.orden--cruza {
		position: relative;
		margin: -1px;
		z-index: 1;
		border-color: var(--blue-800);
		box-shadow: var(--shadow-elevada-oscura);
	}

	/* Arrastrar una orden: solo donde hay mouse, con lo que reacciona en cursor grab/grabbing. La
	   columna bajo el puntero se marca; al soltar, .orden--arrastrando ya se sacó y la carta cae
	   en su lugar con la misma transición de translate/rotate/scale. */
	@media (hover: hover) and (pointer: fine) {
		.orden:not(.orden--cruza) {
			cursor: grab;
		}

		.orden:not(.orden--cruza):not(.orden--arrastrando):hover {
			translate: 0 -4px;
		}

		.orden:not(.orden--cruza):not(.orden--arrastrando):hover::after {
			opacity: 1;
		}

		.orden--arrastrando {
			position: relative;
			z-index: 5;
			cursor: grabbing;
			box-shadow: var(--shadow-elevada-oscura);
			pointer-events: none;
		}

		:where(.columna--destino) {
			outline: 2px dashed var(--cyan-400);
			outline-offset: 6px;
			border-radius: 12px;
		}
	}

	/* El chip cierra el mock, montado sobre el borde de abajo: va en el flujo con un margen
	   negativo de medio chip, así con letra grande el mock crece y no tapa la nota. */
	.ordenes__chip {
		justify-self: end;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-bottom: -18px;
		padding: 10px 16px;
		border-radius: var(--radius-pill);
		background: var(--cyan-300);
		color: var(--navy-950);
		font-size: 0.8125rem;
		font-weight: var(--fw-semibold);
		line-height: 1.2;
		text-wrap: balance;
		box-shadow: var(--shadow-elevada-oscura);
	}

	.ordenes__nota {
		color: var(--text-muted-light);
		font-size: 0.8125rem;
	}

	/* Consulta de contenedor: cuatro columnas cuando el mock tiene lugar, no según la pantalla. */
	@container (min-width: 640px) {
		.columnas {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.columna--recibidas,
		.columna--entregadas {
			display: grid;
		}
	}

	/* --- Movimiento --- */
	/* La orden arranca en "En proceso" (una columna a la izquierda), se levanta, cruza y se
	   apoya en su lugar. */
	@keyframes ordenes-cruza {
		from { transform: translateX(calc(-100% - var(--separacion))); }
		15% { transform: translateX(calc(-100% - var(--separacion))) translateY(-6px) rotate(-2deg); }
		85% { transform: translateY(-6px) rotate(1.5deg); }
		to { transform: none; }
	}

	@keyframes ordenes-avance {
		from { transform: scaleX(0.9); }
	}

	@keyframes ordenes-cuenta-antes {
