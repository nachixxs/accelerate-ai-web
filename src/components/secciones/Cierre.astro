---
// SPECS §4.7: el botón de WhatsApp otra vez. Las redes van en el pie (Pie.astro).
// Cierre tipo manifiesto: un titular gigante, los tres datos de la auditoría en columnas y el
// botón montado sobre el borde de esa card (la regla de profundidad de la marca). Fondo oscuro,
// glow desde otra esquina que la portada.
// Con el scroll, la sección llega como una card con márgenes y se abre de borde a borde
// (clip-path), y las dos líneas del titular suben desde su renglón. Sin movimiento, o en
// Firefox, se ve abierta y completa.
import Icono from '../Icono.astro';
import BotonWhatsApp from '../BotonWhatsApp.astro';
import Glow from '../Glow.astro';

const datos = [
	{ icono: 'clock-duotone', titulo: '30 a 45 minutos', texto: 'Coordinamos el día por WhatsApp, cuando te quede cómodo.' },
	{ icono: 'gift-duotone', titulo: 'Gratis', texto: 'Salís con un problema concreto para resolver, lo contrates o no.' },
	{ icono: 'clipboard-text-duotone', titulo: 'Sin preparar nada', texto: 'Nos contás cómo trabajan hoy. No hace falta mandar nada antes.' },
];
---

<section class="seccion seccion--oscura con-glow cierre" aria-labelledby="cierre-titulo">
	<Glow tono="azul" esquina="abajo-izq" />
	<Glow tono="cian" esquina="abajo-izq" />

	<div class="contenedor">
		<h2 id="cierre-titulo" class="cierre__titular">
			<span class="cierre__renglon"><span>Empezá por la</span></span>
			<span class="cierre__renglon"><span class="texto-gradiente">auditoría gratis</span></span>
		</h2>
		<p class="t-cuerpo cierre__bajada revelar">Una charla para encontrar el proceso que más tiempo te hace perder.</p>

		<div class="cierre__card">
			<ul class="cierre__datos">
				{
					datos.map(({ icono, titulo, texto }, i) => (
						<li class="dato" style={`--i: ${i}`}>
							<Icono nombre={icono} size={28} />
							<strong>{titulo}</strong>
							<span>{texto}</span>
						</li>
					))
				}
			</ul>
			<div class="cierre__accion">
				<BotonWhatsApp />
			</div>
		</div>
		<p class="cierre__quien">Te contesta Ignacio o Gabriel</p>
	</div>
</section>

<style>
	.cierre {
		padding-bottom: var(--space-8);
	}

	/* El titular es la pieza: más grande que el de la portada, en dos renglones. */
	.cierre__titular {
		display: grid;
		max-width: 15ch;
		view-timeline: --titular block;
		font-size: clamp(3rem, 1.25rem + 7vw, 6.5rem);
		font-weight: var(--type-hook-weight);
		line-height: 0.95;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}

	/* Cada renglón recorta a su texto, que sube desde abajo. El padding deja lugar a las letras
	   que bajan de la línea (p, g) y el margen negativo lo devuelve. */
	.cierre__renglon {
		display: block;
		overflow: clip;
		padding-bottom: 0.12em;
		margin-bottom: -0.12em;
	}

	.cierre__renglon > span {
		display: inline-block;
	}

	.cierre__bajada {
		max-width: 40ch;
		margin-top: var(--space-3);
		color: var(--text-body-light);
	}

	/* La card de los tres datos. Deja abajo lugar para el botón, que se monta sobre su borde. */
	.cierre__card {
		position: relative;
		margin-top: var(--space-6);
		padding: var(--space-4) var(--space-3) var(--space-6);
		border: 1px solid var(--border-dark);
		border-radius: var(--radius-card-lg);
		background: var(--surface-card-dark);
		box-shadow: 0 24px 60px rgba(2, 6, 18, 0.45);
	}

	.cierre__datos {
		display: grid;
		gap: var(--space-3);
	}

	.dato {
		display: grid;
		gap: var(--space-1);
		align-content: start;
		padding-top: var(--space-3);
		border-top: 1px solid var(--border-dark);
	}

	.dato:first-child {
		padding-top: 0;
		border-top: 0;
	}

	.dato :global(svg) {
		color: var(--cyan-300);
	}

	.dato strong {
		color: var(--text-heading-light);
		font-size: var(--type-label-size);
		font-weight: var(--fw-bold);
		line-height: 1.15;
	}

	.dato span {
		max-width: 32ch;
		color: var(--text-body-light);
		font-size: var(--type-meta-size);
	}

	/* El botón, mitad adentro y mitad afuera del borde de abajo. */
	/* En el celular va a lo ancho, con menos aire a los lados para que entre en un renglón. */
	.cierre__accion {
		position: absolute;
		left: var(--space-2);
		right: var(--space-2);
		bottom: 0;
		display: grid;
		translate: 0 50%;
	}

	.cierre__accion > :global(*) {
		padding-inline: var(--space-2);
	}

	/* Debajo del botón, ya fuera de la card: quién contesta. */
	.cierre__quien {
		margin-top: var(--space-5);
		padding-left: var(--space-2);
		color: var(--text-muted-light);
		font-size: var(--type-meta-size);
	}

	@media (min-width: 768px) {
		.cierre__card {
			padding: var(--space-5) var(--space-4) var(--space-6);
		}

		.cierre__datos {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0;
		}

		/* En columnas, los separa una línea vertical en lugar de la horizontal. */
		.dato,
		.dato:first-child {
			padding: 0 var(--space-3);
			border-top: 0;
			border-left: 1px solid var(--border-dark);
		}

		.dato:first-child {
			padding-left: 0;
			border-left: 0;
		}

		.cierre__accion {
			left: var(--space-4);
			right: auto;
		}

		.cierre__accion > :global(*) {
			padding-inline: var(--space-3);
		}

		.cierre__quien {
			padding-left: var(--space-4);
		}
	}

	@media (min-width: 1024px) {
		.cierre {
			padding-block: var(--space-8) calc(var(--space-8) + var(--space-3));
		}
	}

	/* --- Movimiento --- */
	/* La sección llega como card con márgenes y se abre de borde a borde. */
	@keyframes cierre-abre {
		from { clip-path: inset(0 var(--abre-margen) round var(--radius-card-lg)); }
		to { clip-path: inset(0 0 round 0); }
	}

	@keyframes cierre-renglon {
		from { transform: translateY(105%); }
	}

	@keyframes cierre-dato {
		from { opacity: 0; transform: translateY(16px); }
	}

	@keyframes cierre-icono {
		from { opacity: 0; transform: scale(0.6) rotate(-12deg); }
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			/* Lineal: la apertura sigue al dedo, sin adelantarse. Relleno backwards: terminado el
			   tramo, la sección vuelve a no tener clip-path. */
			.cierre {
				--abre-margen: var(--space-2);
				animation: cierre-abre linear backwards;
				animation-timeline: view();
				animation-range: entry 0% entry 90%;
			}

			.cierre__renglon > span {
				animation: cierre-renglon var(--curva-salida) both;
				animation-timeline: --titular;
				animation-range: entry 30% cover 30%;
			}

			.cierre__renglon:nth-child(2) > span {
				animation-range: entry 60% cover 38%;
			}

			.dato {
				animation: cierre-dato var(--curva-salida) both;
				animation-timeline: view();
				animation-range: entry calc(20% + var(--i) * 12%) entry calc(60% + var(--i) * 12%);
			}

			.dato :global(svg) {
				animation: cierre-icono var(--curva-salida) both;
				animation-timeline: view();
				animation-range: entry calc(40% + var(--i) * 12%) entry calc(80% + var(--i) * 12%);
			}
		}
	}

	@media (prefers-reduced-motion: no-preference) and (min-width: 768px) {
		.cierre {
			--abre-margen: var(--space-7);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		@supports (animation-timeline: view()) {
			.cierre__titular,
			.cierre__card {
				animation: aparecer linear both;
				animation-timeline: view();
				animation-range: entry 0% entry 50%;
			}
		}
	}
</style>
