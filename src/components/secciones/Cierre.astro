---
// SPECS §4.7: el botón de WhatsApp otra vez. Las redes van en el pie (Pie.astro).
// Layout "CTA" de la marca: fondo oscuro, glow desde otra esquina que la portada,
// titular arriba y botón abajo.
import BotonWhatsApp from '../BotonWhatsApp.astro';
import Glow from '../Glow.astro';
---

<section class="seccion seccion--oscura con-glow" aria-labelledby="cierre-titulo">
	<Glow tono="azul" esquina="abajo-izq" />
	<Glow tono="cian" esquina="abajo-izq" />

	<div class="contenedor cierre">
		<h2 id="cierre-titulo" class="t-titular">Empezá por la auditoría gratis</h2>
		<p class="t-cuerpo">
			Son 30 a 45&nbsp;minutos para encontrar el proceso que más tiempo te hace perder. No tenés que
			preparar nada.
		</p>
		<BotonWhatsApp />
	</div>
</section>

<style>
	.cierre {
		display: grid;
		justify-items: start;
		gap: var(--space-3);
	}

	.cierre p {
		max-width: 44ch;
	}
</style>
