---
// SPECS §4.7: el botón de WhatsApp otra vez. Las redes van en el pie (Pie.astro).
// Cierre tipo manifiesto: un titular gigante, los tres datos de la auditoría en columnas y el
// botón montado sobre el borde de esa card (la regla de profundidad de la marca). Fondo oscuro,
// glow desde otra esquina que la portada.
// Con el scroll, la sección llega como una card con márgenes y se abre de borde a borde
// (clip-path), y las dos líneas del titular suben desde su renglón. Sin movimiento, o en
// Firefox, se ve abierta y completa.
import Icono from '../Icono.astro';
import BotonWhatsApp from '../BotonWhatsApp.astro';
import Glow from '../Glow.astro';

const datos = [
	{ icono: 'clock-duotone', titulo: '30 a 45 minutos', texto: 'Coordinamos el día por WhatsApp, cuando te quede cómodo.' },
	{ icono: 'gift-duotone', titulo: 'Gratis', texto: 'Salís con un problema concreto para resolver, lo contrates o no.' },
	{ icono: 'clipboard-text-duotone', titulo: 'Sin preparar nada', texto: 'Nos contás cómo trabajan hoy. No hace falta mandar nada antes.' },
];
---

<section class="seccion seccion--oscura con-glow cierre" aria-labelledby="cierre-titulo">
	<Glow tono="azul" esquina="abajo-izq" />
	<Glow tono="cian" esquina="abajo-izq" />

	<div class="contenedor">
		<h2 id="cierre-titulo" class="cierre__titular fundir">
			<span class="cierre__renglon"><span>Empezá por la</span></span>{' '}
			<span class="cierre__renglon"><span class="texto-gradiente">auditoría gratis</span></span>
		</h2>
		<p class="t-cuerpo cierre__bajada revelar">Una charla para encontrar el proceso que más tiempo te hace perder.</p>

		<div class="cierre__card fundir">
			<ul class="cierre__datos">
				{
					datos.map(({ icono, titulo, texto }) => (
						<li class="dato">
							<Icono nombre={icono} size={28} />
							<strong>{titulo}</strong>
							<span>{texto}</span>
						</li>
					))
				}
			</ul>
			<div class="cierre__accion">
				<BotonWhatsApp />
			</div>
		</div>
		<p class="cierre__quien">Te contesta Ignacio o Gabriel</p>
	</div>
</section>

<style>
	.cierre {
		--abre-margen: var(--space-2);
		padding-bottom: var(--space-8);
	}

	/* El titular es la pieza: más grande que el de la portada, en dos renglones. */
	.cierre__titular {
		display: grid;
		max-width: 15ch;
		view-timeline: --titular block;
		/* Tope en vw: sin él, "auditoría" y "Empezá" salen recortados por el overflow: clip de
		   .con-glow con la letra del sistema al 200% (el mínimo de 3rem sube a 96px). */
		font-size: min(clamp(3rem, 1.25rem + 7vw, 6rem), 16vw);
		font-weight: var(--type-hook-weight);
		line-height: 0.95;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}

	/* Cada renglón recorta a su texto, que sube desde abajo. El padding deja lugar a las letras
	   que bajan de la línea (p, g) y el margen negativo lo devuelve. Va en el span y no en el
	   renglón: el gradiente (background-clip: text) solo pinta dentro de la caja del span, y sin
	   el padding la cola de la "g" de "gratis" quedaba afuera. */
	.cierre__renglon {
		display: block;
		overflow: clip;
		margin-bottom: -0.12em;
	}

	.cierre__renglon > span {
		display: inline-block;
		padding-bottom: 0.12em;
	}

	.cierre__bajada {
		max-width: 40ch;
		margin-top: var(--space-3);
		color: var(--text-body-light);
	}

	/* La card de los tres datos. Sin padding abajo: el botón cierra la card y se monta sobre
	   su borde. */
	.cierre__card {
		margin-top: var(--space-6);
		padding: var(--space-4) var(--space-3) 0;
		border: 1px solid var(--border-dark);
		border-radius: var(--radius-card-lg);
		background: var(--surface-card-dark);
		box-shadow: var(--shadow-card-oscura);
	}

	.cierre__datos {
		display: grid;
		gap: var(--space-3);
	}

	.dato {
		display: grid;
		gap: var(--space-1);
		align-content: start;
		padding-top: var(--space-3);
		border-top: 1px solid var(--border-dark);
	}

	.dato:first-child {
		padding-top: 0;
		border-top: 0;
	}

	.dato :global(svg) {
		color: var(--cyan-300);
	}

	.dato strong {
		color: var(--text-heading-light);
		font-size: var(--type-label-size);
		font-weight: var(--fw-bold);
		line-height: 1.15;
	}

	.dato span {
		max-width: 32ch;
		color: var(--text-body-light);
		font-size: var(--type-meta-size);
	}

	/* El botón, mitad adentro y mitad afuera del borde de abajo: es el último elemento de la
	   card, con un margen negativo de medio botón (56 px de alto). Va en el flujo, así con letra
	   grande la card crece y nada queda tapado. En el celular va a lo ancho, con menos aire a los
	   lados para que entre en un renglón. */
	.cierre__accion {
		display: grid;
		margin: var(--space-4) calc(var(--space-2) - var(--space-3)) -28px;
	}

	.cierre__accion > :global(*) {
		padding-inline: var(--space-2);
	}

	/* Debajo del botón, ya fuera de la card: quién contesta. El gris apagado (--text-muted-light)
	   no llega a AA acá: el glow de la esquina y la sombra del botón aclaran el fondo real por
	   debajo. Pasa al gris claro del cuerpo, con margen de sobra para separarlo de esa sombra. */
	.cierre__quien {
		margin-top: var(--space-6);
		padding-left: var(--space-2);
		color: var(--text-body-light);
		font-size: var(--type-meta-size);
	}

	@media (min-width: 768px) {
		.cierre {
			/* 80px, no --space-7 (90, del lienzo de redes): múltiplo de 8. */
			--abre-margen: 80px;
		}

		.cierre__card {
			padding: var(--space-5) var(--space-4) 0;
		}

		.cierre__datos {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0;
		}

		/* En columnas, los separa una línea vertical en lugar de la horizontal. */
		.dato {
			padding: 0 var(--space-3);
			border-top: 0;
			border-left: 1px solid var(--border-dark);
		}

		.dato:first-child {
			padding-left: 0;
			border-left: 0;
		}

		.cierre__accion {
			justify-items: start;
			margin-inline: 0;
		}

		.cierre__accion > :global(*) {
			padding-inline: var(--space-3);
		}

		.cierre__quien {
			padding-left: var(--space-4);
		}
	}

	@media (min-width: 1024px) {
		.cierre {
			padding-block: var(--space-8) calc(var(--space-8) + var(--space-3));
		}
	}

	/* --- Movimiento --- */
	/* La sección llega como card con márgenes y se abre de borde a borde. */
	@keyframes cierre-abre {
		from { clip-path: inset(0 var(--abre-margen) round var(--radius-card-lg)); }
		to { clip-path: inset(0 0 round 0); }
	}

	@keyframes cierre-renglon {
		from { transform: translateY(105%); }
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			/* Lo que se recorta es solo el fondo, una capa de color plano: recortar la sección
			   entera volvía a rasterizar los glows (blur de 90 px) en cada cuadro del scroll. Los
			   glows llegan con opacidad, que no cuesta. Lineal: la apertura sigue al dedo. Relleno
			   backwards: terminado el tramo, la capa vuelve a no tener clip-path. */
			.cierre {
				background: none;
				view-timeline: --cierre block;
			}

			.cierre::before {
				content: '';
				position: absolute;
				inset: 0;
				z-index: -1;
				background: var(--surface-dark);
				animation: cierre-abre linear backwards;
				animation-timeline: --cierre;
				animation-range: entry 0% entry 90%;
			}

			.cierre > :global(.glow) {
				animation: aparecer linear both;
				animation-timeline: --cierre;
				animation-range: entry 50% entry 100%;
			}

			.cierre__renglon > span {
				animation: cierre-renglon var(--curva-salida) both;
				animation-timeline: --titular;
				animation-range: entry 30% cover 30%;
			}

			.cierre__renglon:nth-child(2) > span {
				animation-range: entry 60% cover 38%;
			}

			/* .revelar (global.css) dura 33-39px acá: la bajada mide 51-60px de alto. Un rango
			   más largo la deja legible mientras se mueve, en vez de un parpadeo. */
			.cierre__bajada {
				animation-range: entry 20% cover 30%;
			}

			/* .dato y su ícono quedan quietos en su estado final: animaban en el 10% de abajo
			   de la pantalla, donde no se veían (decisión del usuario). */
		}
	}

</style>
