---
// SPECS §4.6: las objeciones típicas. <details> abre y cierra sin JavaScript.
// En escritorio el título queda fijo a la izquierda mientras pasan las preguntas. La apertura
// es suave con ::details-content e interpolate-size (Chrome); donde no hay soporte, abre de golpe.
import Icono from '../Icono.astro';
import BotonWhatsApp from '../BotonWhatsApp.astro';

const preguntas = [
	{
		pregunta: '¿Y si algo falla?',
		respuesta:
			'Nos escribís por WhatsApp y lo arreglamos nosotros. Para eso es el soporte mensual: no te quedás solo con el sistema.',
	},
	{
		pregunta: '¿Tengo que cambiar mi número de WhatsApp?',
		respuesta:
			'No hace falta. Si usás WhatsApp Business, el sistema puede atender en tu mismo número y vos seguís viendo y contestando los chats desde tu celular.',
	},
	{
		pregunta: '¿Cuánto tarda?',
		respuesta:
			'Entre 1 y 3\u00a0semanas desde que aprobás la propuesta, según lo que haya que armar. Si el sistema usa WhatsApp, Meta pide verificar tu negocio, un trámite que suma unos días hábiles.',
	},
	{
		pregunta: '¿Sirve para mi rubro?',
		respuesta:
			'Si en tu negocio hay tareas que se repiten todos los días, probablemente sí. La auditoría sirve justamente para averiguarlo, y es gratis.',
	},
];
---

<section id="preguntas" class="seccion" aria-labelledby="preguntas-titulo">
	<div class="contenedor preguntas">
		<div class="preguntas__intro">
			<h2 id="preguntas-titulo" class="t-titular">Preguntas frecuentes</h2>
			<p class="t-cuerpo">Si la tuya no está, la charlamos en la auditoría.</p>
			<BotonWhatsApp
				variante="contorno"
				texto="Hacenos tu pregunta"
				mensaje="Hola, vi la web y tengo una pregunta:"
			/>
		</div>

		<div class="preguntas__lista">
			{
				preguntas.map(({ pregunta, respuesta }) => (
					<details class="pregunta">
						<summary class="t-label">
							{pregunta}
							<span class="pregunta__flecha" aria-hidden="true">
								<Icono nombre="caret-down-bold" size={20} />
							</span>
						</summary>
						<p class="t-cuerpo">{respuesta}</p>
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	.preguntas {
		display: grid;
		gap: var(--space-4);
	}

	.preguntas__intro {
		display: grid;
		justify-items: start;
		gap: var(--space-2);
		align-content: start;
	}

	.preguntas__intro .t-cuerpo {
		max-width: 30ch;
	}

	.pregunta {
		border-bottom: 1px solid var(--border-light);
		interpolate-size: allow-keywords;
	}

	.pregunta:first-child {
		border-top: 1px solid var(--border-light);
	}

	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
		min-height: 72px;
		padding-block: var(--space-2);
		color: var(--text-heading-dark);
		font-weight: var(--fw-semibold);
		cursor: pointer;
		list-style: none;
		-webkit-tap-highlight-color: transparent;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	.pregunta[open] summary {
		color: var(--brand-primary-deep);
	}

	/* Solo con mouse: en el celular el hover queda pegado después de tocar. */
	@media (hover: hover) and (pointer: fine) {
		summary:hover {
			color: var(--brand-primary-deep);
		}
	}

	/* La flecha va en un círculo: se lee como el control de la fila y marca el estado abierto. */
	.pregunta__flecha {
		display: grid;
		flex: none;
		place-items: center;
		width: 40px;
		height: 40px;
		border: 1px solid var(--border-light);
		border-radius: var(--radius-pill);
		color: var(--brand-primary-deep);
	}

	.pregunta[open] .pregunta__flecha {
		border-color: var(--brand-primary-deep);
		background: var(--brand-primary-deep);
		color: var(--white);
	}

	.pregunta[open] .pregunta__flecha :global(svg) {
		transform: rotate(180deg);
	}

	.pregunta p {
		padding-bottom: var(--space-4);
	}

	@media (min-width: 1024px) {
		.preguntas {
			grid-template-columns: 4fr 7fr;
			gap: var(--space-6);
			align-items: start;
		}

		.preguntas__intro {
			position: sticky;
			top: 120px;
		}

		/* La respuesta no pasa por debajo del círculo de la flecha. */
		.pregunta p {
			padding-right: var(--space-6);
		}
	}

	/* Los cambios de color no mueven nada: quedan también con movimiento reducido. */
	summary {
		transition: color 0.2s;
	}

	.pregunta__flecha {
		transition: background-color 0.2s, border-color 0.2s, color 0.2s;
	}

	@media (prefers-reduced-motion: no-preference) {
		/* Todo lo que se mueve al cerrar dura 0.2 s; al abrir, 0.3 s. */
		.pregunta__flecha :global(svg) {
			transition: transform 0.2s var(--curva-salida);
		}

		.pregunta[open] .pregunta__flecha :global(svg) {
			transition-duration: 0.3s;
		}

		/* El alto se abre de 0 a auto; al cerrar, content-visibility espera a que termine.
		   Cerrar (0.2 s) es más rápido que abrir (0.3 s): es sacar algo del medio. */
		.pregunta::details-content {
			block-size: 0;
			overflow: clip;
			transition:
				block-size 0.2s var(--curva-salida),
				content-visibility 0.2s allow-discrete;
		}

		.pregunta[open]::details-content {
			block-size: auto;
			transition-duration: 0.3s;
		}

		.pregunta p {
			opacity: 0;
			transform: translateY(-6px);
			transition: opacity 0.2s, transform 0.2s var(--curva-salida);
		}

		.pregunta[open] p {
			opacity: 1;
			transform: none;
			transition-duration: 0.2s, 0.3s;
			transition-delay: 60ms;
		}
	}
</style>
