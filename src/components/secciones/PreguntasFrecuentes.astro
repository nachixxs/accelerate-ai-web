---
// SPECS §4.6: las objeciones típicas. <details> abre y cierra sin JavaScript.
// En escritorio el título queda fijo a la izquierda mientras pasan las preguntas. La apertura
// es suave con ::details-content e interpolate-size (Chrome); donde no hay soporte, abre de golpe.
import Icono from '../Icono.astro';
import BotonWhatsApp from '../BotonWhatsApp.astro';

const preguntas = [
	{
		pregunta: '¿Y si algo falla?',
		respuesta:
			'Nos escribís por WhatsApp y lo arreglamos nosotros. Para eso es el soporte mensual: no te quedás solo con el sistema.',
	},
	{
		pregunta: '¿Cuánto tarda?',
		respuesta:
			'Entre 1 y 3\u00a0semanas desde que aprobás la propuesta, según lo que haya que armar.',
	},
	{
		pregunta: '¿Sirve para mi rubro?',
		respuesta:
			'Si en tu negocio hay tareas que se repiten todos los días, probablemente sí. La auditoría sirve justamente para averiguarlo, y es gratis.',
	},
	{
		pregunta: '¿Tengo que dejar mis planillas?',
		respuesta:
			'No hace falta. Si hoy trabajás con Excel o Google Sheets, el sistema arranca desde ahí y tus datos vienen con vos.',
	},
	{
		pregunta: '¿Mi equipo lo va a saber usar?',
		respuesta:
			'Lo armamos con cómo trabajan hoy, no al revés. Les mostramos cómo se usa y, si algo no se entiende, lo cambiamos.',
	},
	{
		pregunta: '¿Y si mi negocio cambia?',
		respuesta:
			'El sistema cambia con él: para eso es el soporte mensual. Se suman cosas o se ajustan sin empezar de cero.',
	},
];
---

<section id="preguntas" class="seccion" aria-labelledby="preguntas-titulo">
	<div class="contenedor preguntas">
		<div class="preguntas__intro">
			<h2 id="preguntas-titulo" class="t-titular">Preguntas frecuentes</h2>
			<p class="t-cuerpo">Si la tuya no está, la charlamos en la auditoría.</p>
			<BotonWhatsApp
				variante="contorno"
				texto="Hacenos tu pregunta"
				mensaje="Hola, vi la web y tengo una pregunta:"
			/>
		</div>

		<div class="preguntas__lista">
			{
				preguntas.map(({ pregunta, respuesta }) => (
					<details class="pregunta">
						<summary class="t-label">
							{pregunta}
							<span class="pregunta__flecha" aria-hidden="true">
								<Icono nombre="caret-down-bold" size={20} />
							</span>
						</summary>
						<p class="t-cuerpo">{respuesta}</p>
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	.preguntas {
		display: grid;
		gap: var(--space-4);
	}

	.preguntas__intro {
		display: grid;
		justify-items: start;
		gap: var(--space-3);
		align-content: start;
	}

	.preguntas__intro .t-cuerpo {
		max-width: 30ch;
	}

	.pregunta {
		border-bottom: 1px solid var(--border-light);
		interpolate-size: allow-keywords;
	}

	.pregunta:first-child {
		border-top: 1px solid var(--border-light);
	}

	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
		min-height: 72px;
		padding-block: var(--space-2);
		color: var(--text-heading-dark);
		font-weight: var(--fw-semibold);
		cursor: pointer;
		list-style: none;
		-webkit-tap-highlight-color: transparent;
		user-select: none;
		-webkit-user-select: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	.pregunta[open] summary {
		color: var(--brand-primary-deep);
	}

	/* Solo con mouse: en el celular el hover queda pegado después de tocar. */
	@media (hover: hover) and (pointer: fine) {
		summary:hover {
			color: var(--brand-primary-deep);
		}
	}

	/* La flecha va en un círculo: se lee como el control de la fila y marca el estado abierto. */
	.pregunta__flecha {
		display: grid;
		flex: none;
		place-items: center;
		width: 40px;
		height: 40px;
		border: 1px solid var(--border-light);
		border-radius: var(--radius-pill);
		color: var(--brand-primary-deep);
	}

	.pregunta[open] .pregunta__flecha {
		border-color: var(--brand-primary-deep);
		background: var(--brand-primary-deep);
		color: var(--white);
	}

	.pregunta[open] .pregunta__flecha :global(svg) {
		transform: rotate(180deg);
	}

	/* Feedback al presionar en el círculo, no en la fila: la marca no usa escalas al presionar,
	   y una fila de 682 px temblaba con un scale chico. Gana al estado abierto por orden (misma
	   especificidad) para que también se note al cerrar. Presionar es más rápido que soltar
	   (mismo patrón que BotonWhatsApp). */
	.pregunta:has(summary:active) .pregunta__flecha {
		border-color: var(--brand-primary-deep);
		background: var(--blue-50);
		color: var(--brand-primary-deep);
		transition-duration: 0.12s;
	}

	.pregunta p {
		padding-bottom: var(--space-4);
	}

	@media (min-width: 1024px) {
		.preguntas {
			grid-template-columns: 4fr 7fr;
			gap: var(--space-6);
			align-items: start;
		}

		.preguntas__intro {
			position: sticky;
			top: 120px;
		}

		/* La respuesta no pasa por debajo del círculo de la flecha. */
		.pregunta p {
			padding-right: var(--space-6);
		}
	}

	/* Los cambios de color no mueven nada: quedan también con movimiento reducido. */
	summary {
		transition: color 0.2s;
	}

	.pregunta__flecha {
		transition: background-color 0.2s, border-color 0.2s, color 0.2s;
	}

	@media (prefers-reduced-motion: no-preference) {
		/* Todo lo que se mueve al cerrar dura 0.2 s; al abrir, 0.3 s. */
		.pregunta__flecha :global(svg) {
			transition: transform 0.2s var(--curva-salida);
		}

		.pregunta[open] .pregunta__flecha :global(svg) {
			transition-duration: 0.3s;
		}

		/* El alto se abre de 0 a auto; al cerrar, content-visibility espera a que termine.
		   Cerrar (0.2 s) es más rápido que abrir (0.3 s): es sacar algo del medio. */
		.pregunta::details-content {
			block-size: 0;
			overflow: clip;
			transition:
				block-size 0.2s var(--curva-salida),
				content-visibility 0.2s allow-discrete;
		}

		.pregunta[open]::details-content {
			block-size: auto;
			transition-duration: 0.3s;
		}

		.pregunta p {
			opacity: 0;
			transform: translateY(-6px);
			transition: opacity 0.2s, transform 0.2s var(--curva-salida);
		}

		.pregunta[open] p {
			opacity: 1;
			transform: none;
			transition-duration: 0.2s, 0.3s;
			transition-delay: 60ms;
		}

		/* Sin esto, la primera apertura no tenía un "desde": el <p> de un <details> cerrado
		   nunca tuvo estilo calculado, así que no había nada de dónde partir la transición. */
		@starting-style {
			.pregunta[open] p {
				opacity: 0;
				transform: translateY(-6px);
			}
		}
	}

	/* Con reducción: solo al abrir hay un fundido corto de opacidad (igual que .fundir de
	   global.css); la transición vive en [open], no en la base, así que al cerrar no hay nada
	   que animar y la fila salta al alto cerrado de una, como el <details> nativo. El alto
	   sigue abriendo de golpe (no hay block-size acá): es el salto nativo, no movimiento nuestro. */
	@media (prefers-reduced-motion: reduce) {
		.pregunta::details-content {
			opacity: 0;
		}

		.pregunta[open]::details-content {
			opacity: 1;
			transition: opacity 0.2s, content-visibility 0.2s allow-discrete;
		}

		@starting-style {
			.pregunta[open]::details-content {
				opacity: 0;
			}
		}
	}

	/* Sin interpolate-size (Safari, Firefox) el alto salta de 0 a auto de golpe, con o sin
	   ::details-content. Un fundido de opacidad en el contenido disimula el salto, sin tocar
	   nada en Chrome (que sí tiene interpolate-size y ya funde por la regla de arriba). */
	@supports not (interpolate-size: allow-keywords) {
		@media (prefers-reduced-motion: no-preference) {
			.pregunta::details-content {
				opacity: 0;
				transition: opacity 0.2s, content-visibility 0.2s allow-discrete;
			}

			.pregunta[open]::details-content {
				opacity: 1;
			}

			@starting-style {
				.pregunta[open]::details-content {
					opacity: 0;
				}
			}
		}
	}
</style>
