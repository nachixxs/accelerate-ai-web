---
// SPECS §2 y §4.3: la promesa amplia. Tres ejemplos como muestra, no como menú, y después la
// pared: 8 tipos de sistema más (los que más piden las pymes, sin repetir los de arriba), cada uno
// con una línea de qué resuelve, y el remate "Y el que tu negocio necesite". Cada tipo abre
// WhatsApp con su propio mensaje. Antes eran 20 y se veían como una lista de relleno (pedido del
// usuario, 2026-09-25).
// Fondo oscuro: en el claro la marca permite una sola card invertida por sección, y acá cada
// ejemplo lleva su card con un mock del sistema funcionando. Arriba el grande a lo ancho
// (órdenes de trabajo); abajo dos medianos lado a lado (caja y stock); en el celular, una columna.
// Cada card define el timeline --celda: sus mocks se arman mientras la card cruza la pantalla.
import Glow from '../Glow.astro';
import Icono from '../Icono.astro';
import BotonWhatsApp from '../BotonWhatsApp.astro';
import MockOrdenes from '../mocks/MockOrdenes.astro';
import MockCaja from '../mocks/MockCaja.astro';
import MockStock from '../mocks/MockStock.astro';
import { whatsappUrl } from '../../config';

// Las bajadas son borrador (REVISION-TEXTOS.md).
const tipos = [
	{ nombre: 'Presupuestos', icono: 'file-text-duotone', bajada: 'Armados en minutos y con seguimiento hasta que se aprueban.' },
	{ nombre: 'Cobranzas', icono: 'hand-coins-duotone', bajada: 'Quién te debe, cuánto y desde cuándo, sin revisar papeles.' },
	{ nombre: 'Turnos y reservas', icono: 'calendar-check-duotone', bajada: 'Una agenda para todo el equipo, con aviso al cliente.' },
	{ nombre: 'Clientes', icono: 'address-book-duotone', bajada: 'La historia de cada cliente en un solo lugar.' },
	{ nombre: 'Compras a proveedores', icono: 'shopping-cart-duotone', bajada: 'Qué pediste, a qué precio y qué falta que llegue.' },
	{ nombre: 'Listas de precios', icono: 'tag-duotone', bajada: 'Cambiás un precio una vez y se actualiza en todos lados.' },
	{ nombre: 'Horas del equipo', icono: 'timer-duotone', bajada: 'Quién trabajó en qué y cuánto, sin planillas sueltas.' },
	{ nombre: 'Reportes para el contador', icono: 'calculator-duotone', bajada: 'Lo que te pide cada mes, listo para mandar.' },
];
---

<section id="sistemas" class="seccion seccion--oscura con-glow sistemas" aria-labelledby="sistemas-titulo">
	<Glow tono="azul" esquina="arriba-der" />
	<Glow tono="cian" esquina="arriba-der" />

	<div class="contenedor">
		<div class="encabezado-seccion revelar">
			<h2 id="sistemas-titulo" class="t-titular">Armamos el sistema que tu negocio necesita</h2>
			<p class="t-cuerpo">
				No vendemos un producto cerrado. Elegimos el proceso que más tiempo o plata te hace perder y
				armamos el sistema para eso. Algunos ejemplos de lo que armamos:
			</p>
		</div>

		<div class="ejemplos">
			<article class="ejemplo ejemplo--ordenes">
				<div class="ejemplo__texto">
					<h3 class="t-label">Cada trabajo, de la entrada a la entrega</h3>
					<p>Sabés en qué está cada pedido, quién lo tiene y qué vence hoy, sin preguntar en voz alta.</p>
				</div>
				<MockOrdenes />
			</article>

			<article class="ejemplo ejemplo--caja">
				<div class="ejemplo__texto">
					<h3 class="t-label">Cajas y cierres diarios sin cuadernos</h3>
					<p>Cada movimiento queda registrado y el cierre del día sale en minutos.</p>
				</div>
				<MockCaja />
			</article>

			<article class="ejemplo ejemplo--stock">
				<div class="ejemplo__texto">
					<h3 class="t-label">Sabés qué falta antes de que falte</h3>
					<p>Cada venta descuenta del stock y, cuando algo baja del mínimo, el pedido al proveedor ya está armado.</p>
				</div>
				<MockStock />
			</article>
		</div>

		<div class="pared">
			<h3 class="t-label pared__titulo">Y también armamos</h3>
			<ul class="pared__lista">
				{
					tipos.map(({ nombre, icono, bajada }, i) => (
						<li style={`--i: ${i}`}>
							<a
								class="tipo"
								href={whatsappUrl(`Hola, vi la web y me interesa un sistema de ${nombre.toLowerCase()}.`)}
								target="_blank"
								rel="noopener"
							>
								<span class="tipo__icono">
									<Icono nombre={icono} size={24} />
								</span>
								<span class="tipo__textos">
									<span class="tipo__nombre">{nombre}</span>
									<span class="tipo__bajada">{bajada}</span>
								</span>
								<Icono nombre="arrow-up-right-bold" size={18} class="tipo__flecha" />
								<span class="solo-lector"> (abre WhatsApp)</span>
							</a>
						</li>
					))
				}
			</ul>
			<div class="pared__final">
				<span class="pared__final-texto">
					<Icono nombre="plus-circle-duotone" size={24} />
					Y el que tu negocio necesite
				</span>
				<BotonWhatsApp
					variante="secundario"
					texto="Quiero uno para mi negocio"
					mensaje="Hola, vi los sistemas que arman y quiero uno para mi negocio."
				/>
			</div>
		</div>
	</div>
</section>

<style>
	.sistemas .encabezado-seccion .t-cuerpo {
		color: var(--text-body-light);
	}

	.ejemplos {
		display: grid;
		gap: var(--space-4);
		margin-top: var(--space-6);
	}

	.ejemplo {
		position: relative;
		display: grid;
		align-content: start;
		gap: var(--space-4);
		/* Menos aire a los costados por debajo de 480 px: le da a los mocks (sobre todo el de
		   órdenes) el ancho que necesitan. */
		padding: var(--space-4) var(--space-2) var(--space-5);
		border: 1px solid var(--border-dark);
		border-radius: var(--radius-card-lg);
		background: var(--surface-card-dark);
		box-shadow: var(--shadow-card-oscura);
		view-timeline: --celda block;
	}

	@media (min-width: 480px) {
		.ejemplo {
			padding-inline: var(--space-3);
		}
	}

	.ejemplo__texto {
		display: grid;
		gap: var(--space-1);
		max-width: 560px;
	}

	.ejemplo h3 {
		font-weight: var(--fw-semibold);
	}

	/* Variedad de fondos: el grande lleva un degradé azul profundo desde abajo. */
	.ejemplo--ordenes {
		background: linear-gradient(180deg, var(--surface-card-dark) 45%, var(--blue-950));
	}

	.ejemplo--caja {
		background: linear-gradient(160deg, var(--surface-card-dark) 55%, var(--navy-850));
	}

	/* Desde 1024 esta card iguala el alto de la de stock (misma fila de grilla): el mock de caja
	   se centra en el sobrante en vez de dejarlo vacío abajo. */
	@media (min-width: 1024px) {
		.ejemplo--caja {
			grid-template-rows: auto 1fr;
		}

		.ejemplo--caja :global(.mock-caja) {
			align-self: center;
		}
	}

	/* --- La pared: el título con una línea que sigue hasta el borde, 8 tipos en cards y el remate
	   a lo ancho. --- */
	.pared {
		display: grid;
		gap: var(--space-3);
		margin-top: var(--espacio-seccion);
	}

	.pared__titulo {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		color: var(--text-heading-light);
		font-weight: var(--fw-semibold);
	}

	.pared__titulo::after {
		content: '';
		flex: 1;
		height: 1px;
		background: var(--border-dark);
	}

	.pared__lista {
		--cols: 1;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-1);
	}

	/* Cada tipo: el ícono en un cuadrado, el nombre y qué resuelve. Con el mouse se levanta, el
	   cuadrado se prende de cian y aparece la flecha (abre WhatsApp). */
	.tipo {
		position: relative;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-content: start;
		align-items: start;
		gap: var(--space-2);
		height: 100%;
		padding: var(--space-2);
		border: 1px solid var(--border-dark);
		border-radius: var(--radius-card);
		background: var(--surface-card-dark);
		color: var(--text-body-light);
		-webkit-tap-highlight-color: transparent;
		transition:
			border-color 0.2s ease,
			translate 0.25s var(--curva-salida);
	}

	.tipo__icono {
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border-radius: 12px;
		background: var(--blue-950);
		color: var(--cyan-400);
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	.tipo__textos {
		display: grid;
		gap: 4px;
		padding-right: var(--space-2);
	}

	.tipo__nombre {
		color: var(--text-heading-light);
		font-weight: var(--fw-semibold);
		line-height: 1.25;
	}

	.tipo__bajada {
		color: var(--text-muted-light);
		font-size: var(--type-meta-size);
		line-height: 1.4;
		text-wrap: pretty;
	}

	.tipo :global(.tipo__flecha) {
		position: absolute;
		top: var(--space-2);
		right: var(--space-2);
		color: var(--cyan-300);
		opacity: 0;
		transform: translate(-4px, 4px);
		transition: opacity 0.2s ease, transform 0.25s var(--curva-salida);
	}

	.tipo:active {
		border-color: var(--cyan-300);
	}

	/* En táctil no hay hover que la muestre: la flecha queda siempre visible, como con el teclado. */
	@media (hover: none) {
		.tipo :global(.tipo__flecha) {
			opacity: 1;
			transform: none;
		}
	}

	.tipo:focus-visible :global(.tipo__flecha) {
		opacity: 1;
		transform: none;
	}

	@media (hover: hover) and (pointer: fine) {
		.tipo:hover {
			border-color: var(--blue-700);
			translate: 0 -4px;
		}

		.tipo:hover .tipo__icono {
			background: var(--cyan-300);
			color: var(--navy-950);
		}

		.tipo:hover :global(.tipo__flecha) {
			opacity: 1;
			transform: none;
		}
	}

	/* El remate: a lo ancho, con borde punteado (el lugar para el tuyo) y el botón. */
	.pared__final {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
		padding: var(--space-3);
		border: 1.5px dashed var(--blue-700);
		border-radius: var(--radius-card);
		color: var(--text-heading-light);
		font-size: var(--type-label-size);
		font-weight: var(--fw-semibold);
	}

	.pared__final-texto {
		display: inline-flex;
		align-items: center;
		gap: 12px;
	}

	.pared__final-texto :global(svg) {
		flex: none;
		color: var(--cyan-400);
	}

	@media (min-width: 768px) {
		.ejemplo {
			padding: var(--space-5) var(--space-4);
		}

		.pared__lista {
			--cols: 2;
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1024px) {
		.ejemplos {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space-4) var(--space-3);
		}

		.ejemplo--ordenes {
			grid-column: 1 / -1;
		}

		.pared__lista {
			--cols: 4;
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		/* La reserva entre nombre y bajada es por fila, no por página: cada li toma las 3 filas
		   del subgrid de la pared (ícono, nombre, bajada), así que la bajada arranca en el mismo
		   lugar en las 4 columnas sea cual sea el alto del nombre en esa fila. */
		.pared__lista li {
			display: grid;
			grid-row: span 3;
			grid-template-rows: subgrid;
		}

		/* En cuatro columnas, el ícono arriba y el texto abajo. */
		.tipo {
			grid-row: 1 / -1;
			grid-template-columns: minmax(0, 1fr);
			grid-template-rows: subgrid;
			gap: var(--space-3);
			padding: var(--space-3);
		}

		.tipo__icono {
			grid-row: 1;
		}

		.tipo__textos {
			grid-row: 2 / -1;
			grid-template-rows: subgrid;
		}
	}

	/* Borde que se aclara al pasar el mouse: la card responde sin moverse de lugar. */
	@media (hover: hover) and (pointer: fine) {
		.ejemplo {
			transition: border-color 0.2s;
		}

		.ejemplo:hover {
			border-color: var(--blue-800);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			.ejemplo {
				animation: entrar-subiendo var(--curva-salida) both;
				animation-timeline: --celda;
				animation-range: entry 0% entry 50%;
			}

			/* Los tipos entran en cascada según van entrando a la pantalla, cada uno con su propio
			   timeline (no uno compartido para toda la lista, que a 360 es más alta que la
			   pantalla): el desfase es por columna, no por índice global, así el paso no se pierde
			   fuera de vista. */
			.pared__lista li {
				animation: entrar-corto var(--curva-salida) both;
				animation-timeline: view();
				animation-range:
					entry calc(10% + mod(var(--i), var(--cols)) * 8%)
					entry calc(60% + mod(var(--i), var(--cols)) * 8%);
			}
		}
	}
</style>
