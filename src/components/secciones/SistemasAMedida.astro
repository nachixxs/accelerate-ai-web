---
// SPECS §2 y §4.3: la promesa amplia. Tres ejemplos como muestra, no como menú, y después la
// pared: 20 tipos de sistema que se encienden con el scroll, fila por fila, y rematan en "Y el que tu
// negocio necesite". Los de arriba son muestras; la pared es la amplitud.
// Fondo oscuro: en el claro la marca permite una sola card invertida por sección, y acá cada
// ejemplo lleva su card con un mock del sistema funcionando. Arriba el grande a lo ancho
// (órdenes de trabajo); abajo dos medianos lado a lado (caja y stock); en el celular, una columna.
// Cada card define el timeline --celda: sus mocks se arman mientras la card cruza la pantalla.
import Glow from '../Glow.astro';
import Icono from '../Icono.astro';
import BotonWhatsApp from '../BotonWhatsApp.astro';
import MockOrdenes from '../mocks/MockOrdenes.astro';
import MockCaja from '../mocks/MockCaja.astro';
import MockStock from '../mocks/MockStock.astro';

const tipos = [
	{ nombre: 'Órdenes de trabajo', icono: 'clipboard-text-duotone' },
	{ nombre: 'Stock', icono: 'package-duotone' },
	{ nombre: 'Presupuestos', icono: 'file-text-duotone' },
	{ nombre: 'Cobranzas', icono: 'hand-coins-duotone' },
	{ nombre: 'Turnos y reservas', icono: 'calendar-check-duotone' },
	{ nombre: 'Clientes y seguimiento', icono: 'address-book-duotone' },
	{ nombre: 'Compras a proveedores', icono: 'shopping-cart-duotone' },
	{ nombre: 'Horas del equipo', icono: 'timer-duotone' },
	{ nombre: 'Listas de precios', icono: 'tag-duotone' },
	{ nombre: 'Comisiones', icono: 'percent-duotone' },
	{ nombre: 'Mantenimiento', icono: 'wrench-duotone' },
	{ nombre: 'Flota y vehículos', icono: 'truck-duotone' },
	{ nombre: 'Gastos', icono: 'receipt-duotone' },
	{ nombre: 'Vencimientos', icono: 'hourglass-duotone' },
	{ nombre: 'Legajos', icono: 'folder-user-duotone' },
	{ nombre: 'Pedidos', icono: 'shopping-bag-duotone' },
	{ nombre: 'Reportes para el contador', icono: 'calculator-duotone' },
	{ nombre: 'Tareas del día', icono: 'list-checks-duotone' },
	{ nombre: 'Encuestas a clientes', icono: 'star-duotone' },
	{ nombre: 'Consignaciones', icono: 'handshake-duotone' },
];
---

<section id="sistemas" class="seccion seccion--oscura con-glow sistemas" aria-labelledby="sistemas-titulo">
	<Glow tono="azul" esquina="arriba-der" />
	<Glow tono="cian" esquina="arriba-der" />

	<div class="contenedor">
		<div class="encabezado-seccion revelar">
			<h2 id="sistemas-titulo" class="t-titular">Armamos el sistema que tu negocio necesita</h2>
			<p class="t-cuerpo">
				No vendemos un producto cerrado. Elegimos el proceso que más tiempo o plata te hace perder y
				armamos el sistema para eso. Algunos ejemplos de lo que armamos:
			</p>
		</div>

		<div class="ejemplos">
			<article class="ejemplo ejemplo--ordenes">
				<div class="ejemplo__texto">
					<h3 class="t-label">Cada trabajo, de la entrada a la entrega</h3>
					<p>Sabés en qué está cada pedido, quién lo tiene y qué vence hoy, sin preguntar en voz alta.</p>
				</div>
				<MockOrdenes />
			</article>

			<article class="ejemplo ejemplo--caja">
				<div class="ejemplo__texto">
					<h3 class="t-label">Cajas y cierres diarios sin cuadernos</h3>
					<p>Cada movimiento queda registrado y el cierre del día sale en minutos.</p>
				</div>
				<MockCaja />
			</article>

			<article class="ejemplo ejemplo--stock">
				<div class="ejemplo__texto">
					<h3 class="t-label">Sabés qué falta antes de que falte</h3>
					<p>Cada venta descuenta del stock y, cuando algo baja del mínimo, el pedido al proveedor ya está armado.</p>
				</div>
				<MockStock />
			</article>
		</div>

		<div class="pared">
			<h3 class="t-label pared__titulo">Y también armamos</h3>
			<ul class="pared__lista">
				{
					tipos.map(({ nombre, icono }) => (
						<li class="tipo">
							<Icono nombre={icono} size={22} />
							{nombre}
						</li>
					))
				}
				<li class="tipo tipo--final">
					<span class="tipo__final-texto">
						<Icono nombre="plus-circle-duotone" size={24} />
						Y el que tu negocio necesite
					</span>
					<BotonWhatsApp
						variante="secundario"
						texto="Quiero uno para mi negocio"
						mensaje="Hola, vi los sistemas que arman y quiero uno para mi negocio."
					/>
				</li>
			</ul>
		</div>
	</div>
</section>

<style>
	.sistemas .encabezado-seccion .t-cuerpo {
		color: var(--text-body-light);
	}

	.ejemplos {
		display: grid;
		gap: var(--space-4);
		margin-top: var(--space-6);
	}

	.ejemplo {
		position: relative;
		display: grid;
		align-content: start;
		gap: var(--space-4);
		padding: var(--space-4) var(--space-3) var(--space-5);
		border: 1px solid var(--border-dark);
		border-radius: var(--radius-card-lg);
		background: var(--surface-card-dark);
		box-shadow: var(--shadow-card-oscura);
		view-timeline: --celda block;
	}

	.ejemplo__texto {
		display: grid;
		gap: var(--space-1);
		max-width: 560px;
	}

	.ejemplo h3 {
		font-weight: var(--fw-semibold);
	}

	/* Variedad de fondos: el grande lleva un degradé azul profundo desde abajo. */
	.ejemplo--ordenes {
		background: linear-gradient(180deg, var(--surface-card-dark) 45%, var(--blue-950));
	}

	.ejemplo--caja {
		background: linear-gradient(160deg, var(--surface-card-dark) 55%, var(--navy-850));
	}

	/* --- La pared --- */
	.pared {
		display: grid;
		gap: var(--space-3);
		margin-top: var(--space-7);
	}

	.pared__titulo {
		color: var(--text-heading-light);
		font-weight: var(--fw-semibold);
	}

	.pared__lista {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-1);
	}

	.tipo {
		display: flex;
		align-items: center;
		gap: 10px;
		min-height: 56px;
		padding: 12px 14px;
		border: 1px solid var(--border-dark);
		border-radius: 16px;
		background: var(--surface-card-dark);
		color: var(--text-body-light);
		font-size: var(--type-meta-size);
		font-weight: var(--fw-medium);
		line-height: 1.25;
	}

	/* Solo el ícono del tipo, no la flecha del botón del remate. */
	.tipo > :global(svg),
	.tipo__final-texto > :global(svg) {
		flex: none;
		color: var(--cyan-400);
	}

	/* El remate: a lo ancho, con borde punteado (el lugar para el tuyo) y el botón. */
	.tipo--final {
		grid-column: 1 / -1;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-2);
		padding: var(--space-3);
		border: 1.5px dashed var(--blue-700);
		background: transparent;
		color: var(--text-heading-light);
		font-size: var(--type-label-size);
		font-weight: var(--fw-semibold);
	}

	.tipo__final-texto {
		display: inline-flex;
		align-items: center;
		gap: 12px;
	}

	@media (min-width: 768px) {
		.ejemplo {
			padding: var(--space-5) var(--space-4);
		}

		.pared__lista {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (min-width: 1024px) {
		.ejemplos {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space-4) var(--space-3);
		}

		.ejemplo--ordenes {
			grid-column: 1 / -1;
		}

		.pared__lista {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	/* Borde que se aclara al pasar el mouse: la card responde sin moverse de lugar. */
	@media (hover: hover) and (pointer: fine) {
		.ejemplo {
			transition: border-color 0.2s;
		}

		.ejemplo:hover {
			border-color: var(--blue-800);
		}
	}

	@keyframes sistemas-tipo-enciende {
		from { opacity: 0.25; transform: translateY(8px); }
	}

	@keyframes sistemas-icono-enciende {
		from { opacity: 0.3; }
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			.ejemplo {
				animation: entrar-subiendo var(--curva-salida) both;
				animation-timeline: --celda;
				animation-range: entry 0% entry 50%;
			}

			/* Cada tipo se enciende al entrar en pantalla: la pared se prende fila por fila a medida
			   que sube, con cualquier cantidad de columnas y de tipos. */
			.tipo {
				animation: sistemas-tipo-enciende var(--curva-salida) both;
				animation-timeline: view();
				animation-range: entry 10% entry 90%;
			}

			.tipo > :global(svg),
			.tipo__final-texto > :global(svg) {
				animation: sistemas-icono-enciende linear both;
				animation-timeline: view();
				animation-range: entry 60% cover 30%;
			}
		}
	}
</style>
