---
// SPECS §2 y §4.3: la promesa amplia con 4 ejemplos al lado, como muestra y no como menú.
// Fondo oscuro: en el claro la marca permite una sola card invertida por sección, y acá cada
// ejemplo lleva su card con un mock del sistema funcionando. Grilla bento asimétrica: pedidos
// ancho y turnos angosto arriba, caja angosta y panel ancho abajo; en el celular, una columna.
// Cada card define el timeline --celda: sus mocks se arman mientras la card cruza la pantalla.
// Las clases .ejemplo--destacado y .chip-montado las usa scripts/capturas.mjs.
import Glow from '../Glow.astro';
import MockPedidos from '../mocks/MockPedidos.astro';
import MockTurnos from '../mocks/MockTurnos.astro';
import MockCaja from '../mocks/MockCaja.astro';
import MockPanel from '../mocks/MockPanel.astro';
---

<section id="sistemas" class="seccion seccion--oscura con-glow sistemas" aria-labelledby="sistemas-titulo">
	<Glow tono="azul" esquina="arriba-der" />
	<Glow tono="cian" esquina="arriba-der" />

	<div class="contenedor">
		<div class="encabezado-seccion revelar">
			<h2 id="sistemas-titulo" class="t-titular">Armamos el sistema que tu negocio necesita</h2>
			<p class="t-cuerpo">
				No vendemos un producto cerrado. Elegimos el proceso que más tiempo o plata te hace perder y
				armamos el sistema para eso. Algunos de los que ya construimos:
			</p>
		</div>

		<div class="bento">
			<article class="ejemplo ejemplo--destacado ejemplo--pedidos">
				<span class="chip-montado">Ya funciona en una imprenta</span>
				<div class="ejemplo__texto">
					<h3 class="t-label">Pedidos por WhatsApp que se cargan solos en una planilla</h3>
					<p>El cliente pide por WhatsApp y el pedido queda anotado sin que nadie lo tipee. Vos solo revisás los casos raros.</p>
				</div>
				<MockPedidos />
			</article>

			<article class="ejemplo ejemplo--turnos">
				<div class="ejemplo__texto">
					<h3 class="t-label">Turnos y reservas con recordatorios</h3>
					<p>Tus clientes reservan por WhatsApp a cualquier hora y reciben un aviso antes del turno.</p>
				</div>
				<MockTurnos />
			</article>

			<article class="ejemplo ejemplo--caja">
				<div class="ejemplo__texto">
					<h3 class="t-label">Cajas y cierres diarios sin cuadernos</h3>
					<p>Cada movimiento queda registrado y el cierre del día sale en minutos.</p>
				</div>
				<MockCaja />
			</article>

			<article class="ejemplo ejemplo--panel">
				<div class="ejemplo__texto">
					<h3 class="t-label">Paneles para ver tu negocio de un vistazo</h3>
					<p>Ventas, gastos y lo que más se mueve, en un tablero armado con tus propios datos.</p>
				</div>
				<MockPanel />
			</article>
		</div>
	</div>
</section>

<style>
	.sistemas .encabezado-seccion .t-cuerpo {
		color: var(--text-body-light);
	}

	.bento {
		display: grid;
		gap: var(--space-3);
		margin-top: var(--space-6);
	}

	.ejemplo {
		position: relative;
		display: grid;
		grid-template-rows: auto 1fr;
		align-content: start;
		gap: var(--space-4);
		padding: var(--space-4) var(--space-3);
		border: 1px solid var(--border-dark);
		border-radius: var(--radius-card-lg);
		background: var(--surface-card-dark);
		box-shadow: 0 24px 60px rgba(2, 6, 18, 0.35);
		view-timeline: --celda block;
	}

	/* Los mocks van abajo de la card, pegados al borde de abajo en las celdas más altas. */
	.ejemplo > :last-child {
		align-self: end;
	}

	.ejemplo__texto {
		display: grid;
		gap: var(--space-1);
	}

	.ejemplo h3 {
		font-weight: var(--fw-semibold);
	}

	/* Variedad de fondos en la grilla: el destacado lleva un degradé azul profundo desde abajo. */
	.ejemplo--destacado {
		padding-top: var(--space-5);
		background: linear-gradient(180deg, var(--surface-card-dark) 40%, var(--blue-950));
	}

	/* Chip "acento" de la marca, montado mitad adentro y mitad afuera del borde de la card. */
	.chip-montado {
		position: absolute;
		top: 0;
		left: var(--space-3);
		max-width: calc(100% - 2 * var(--space-3));
		transform: translateY(-50%);
		padding: 10px 18px;
		border-radius: var(--radius-pill);
		background: var(--cyan-300);
		color: var(--navy-950);
		font-size: var(--type-meta-size);
		font-weight: var(--fw-semibold);
		line-height: 1.2;
		box-shadow: var(--shadow-elevada);
	}

	.ejemplo--caja {
		background: linear-gradient(160deg, var(--surface-card-dark) 55%, var(--navy-850));
	}

	/* Tablet: pedidos y panel a lo ancho, turnos y caja lado a lado. */
	@media (min-width: 768px) {
		.bento {
			grid-template-columns: 1fr 1fr;
		}

		.ejemplo--pedidos,
		.ejemplo--panel {
			grid-column: span 2;
		}

		.ejemplo {
			padding: var(--space-5) var(--space-4) var(--space-4);
		}

		.ejemplo--destacado {
			padding-top: var(--space-6);
		}
	}

	@media (min-width: 1024px) {
		.bento {
			grid-template-columns: repeat(12, 1fr);
			gap: var(--space-3);
		}

		.ejemplo--pedidos {
			grid-column: span 7;
		}

		.ejemplo--turnos {
			grid-column: span 5;
		}

		.ejemplo--caja {
			grid-column: span 5;
		}

		.ejemplo--panel {
			grid-column: span 7;
		}
	}

	/* Borde que se aclara al pasar el mouse: la card responde sin moverse de lugar. */
	@media (hover: hover) and (pointer: fine) {
		.ejemplo {
			transition: border-color 0.2s;
		}

		.ejemplo:hover {
			border-color: var(--blue-800);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			.ejemplo {
				animation: entrar-subiendo linear both;
				animation-timeline: --celda;
				animation-range: entry 0% entry 60%;
			}
		}
	}
</style>
