---
// SPECS §4.5: Nacho y Colo, qué hace cada uno. Corto. Roles según la sociedad
// (notas/negocio/Sociedad-y-Acuerdos.md). La marca no usa fotos.
// Es el "momento de escala" de la marca: los dos nombres a tamaño gigante, cada uno con su rol
// al lado. Con el scroll, los nombres se acercan desde lados opuestos hasta quedar alineados.
const personas = [
	{
		nombre: 'Nacho',
		rol: 'La parte técnica: programa los sistemas, los bots de WhatsApp y las automatizaciones.',
	},
	{
		nombre: 'Colo',
		rol: 'Los números: planillas, paneles en Excel y Power BI, y la administración.',
	},
];
---

<section class="seccion somos" aria-labelledby="somos-titulo">
	<div class="contenedor">
		<div class="encabezado-seccion revelar">
			<h2 id="somos-titulo" class="t-titular">Una agencia chica, a propósito</h2>
			<p class="t-cuerpo">Hablás directo con las dos personas que arman tu sistema.</p>
		</div>

		<dl class="personas">
			{
				personas.map(({ nombre, rol }, i) => (
					<div class="persona">
						<dt class="persona__nombre">
							{i > 0 && <span class="persona__y" aria-hidden="true">y </span>}
							{nombre}
						</dt>
						<dd class="persona__rol">{rol}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>

<style>
	.personas {
		display: grid;
		gap: var(--space-4);
		margin-top: var(--space-5);
	}

	.persona {
		display: grid;
		gap: var(--space-2);
	}

	/* La escala gigante de la marca (200 en el lienzo de 1080), llevada a la web: 88 → 208 px. */
	.persona__nombre {
		color: var(--text-heading-dark);
		font-size: clamp(5.5rem, 2.565rem + 13.04vw, 13rem);
		font-weight: var(--fw-black);
		line-height: 0.9;
		letter-spacing: -0.04em;
		white-space: nowrap;
	}

	.persona__y {
		color: var(--brand-primary-deep);
		font-weight: var(--fw-medium);
	}

	.persona__rol {
		margin: 0;
		max-width: 34ch;
		padding-left: var(--space-2);
		border-left: 2px solid var(--brand-primary-deep);
	}

	/* Escritorio: cada nombre con su rol al lado, al pie de la línea. El segundo, corrido a la
	   derecha: el espacio vacío cae de un lado distinto en cada fila. */
	@media (min-width: 1024px) {
		.personas {
			gap: var(--space-3);
		}

		.persona {
			grid-template-columns: auto 1fr;
			align-items: end;
			column-gap: var(--space-5);
		}

		.persona:nth-child(2) {
			grid-template-columns: 1fr auto;
		}

		.persona:nth-child(2) .persona__nombre {
			grid-column: 2;
			grid-row: 1;
		}

		.persona:nth-child(2) .persona__rol {
			grid-column: 1;
			grid-row: 1;
			justify-self: end;
		}

		.persona__rol {
			margin-bottom: var(--space-3);
		}
	}

	@keyframes nombre-desde-izquierda {
		from { transform: translateX(-14%); }
	}

	@keyframes nombre-desde-derecha {
		from { transform: translateX(14%); }
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			.persona__nombre {
				animation: nombre-desde-izquierda linear both;
				animation-timeline: view();
				animation-range: entry 0% cover 50%;
			}

			.persona:nth-child(2) .persona__nombre {
				animation-name: nombre-desde-derecha;
			}

			.persona__rol {
				animation: aparecer linear both;
				animation-timeline: view();
				animation-range: entry 40% cover 40%;
			}
		}
	}
</style>
