---
// SPECS §4.5: Ignacio y Gabriel, qué hace cada uno. Corto. Roles según la sociedad
// (notas/negocio/Sociedad-y-Acuerdos.md). La marca no usa fotos.
// Es el "momento de escala" de la marca: los dos nombres a tamaño gigante, cada uno con su rol
// al lado. Con el scroll, los nombres se acercan desde lados opuestos y se van llenando de
// izquierda a derecha, del gris claro al color del titular.
const personas = [
	{
		nombre: 'Ignacio',
		rol: 'La parte técnica: programa los sistemas, los bots de WhatsApp y las automatizaciones.',
	},
	{
		nombre: 'Gabriel',
		rol: 'Los números: planillas, paneles en Excel y Power BI, y la administración.',
	},
];
import BotonWhatsApp from '../BotonWhatsApp.astro';
---

<section id="somos" class="seccion somos" aria-labelledby="somos-titulo">
	<div class="contenedor">
		<div class="encabezado-seccion revelar">
			<h2 id="somos-titulo" class="t-titular">Una agencia chica, a propósito</h2>
			<p class="t-cuerpo">Hablás directo con las dos personas que arman tu sistema.</p>
		</div>

		<dl class="personas">
			{
				personas.map(({ nombre, rol }, i) => (
					<div class="persona">
						<dt class="persona__nombre">
							{i > 0 && <span class="persona__y" aria-hidden="true">y </span>}
							<span class="persona__texto">{nombre}</span>
						</dt>
						<dd class="persona__rol">{rol}</dd>
					</div>
				))
			}
		</dl>

		<div class="somos__pie">
			<BotonWhatsApp
				variante="link"
				texto="Hablar directo con Ignacio y Gabriel"
				mensaje="Hola Ignacio y Gabriel, vi la web y quiero charlar sobre mi negocio."
			/>
		</div>
	</div>
</section>

<style>
	.somos__pie {
		margin-top: var(--space-5);
	}

	.personas {
		display: grid;
		gap: var(--space-4);
		margin-top: var(--space-5);
	}

	.persona {
		display: grid;
		gap: var(--space-2);
	}

	/* La escala gigante de la marca (200 en el lienzo de 1080), llevada a la web: 68 → 163 px.
	   El tope lo pone "y Gabriel" en 360 px: a 68 px ocupa unos 290 de los 328 disponibles. */
	.persona__nombre {
		color: var(--text-heading-dark);
		font-size: clamp(4.25rem, 1.8rem + 10.5vw, 10.25rem);
		font-weight: var(--fw-black);
		line-height: 0.9;
		letter-spacing: -0.04em;
		white-space: nowrap;
	}

	.persona__y {
		color: var(--brand-primary-deep);
		font-weight: var(--fw-medium);
	}

	.persona__rol {
		margin: 0;
		max-width: 34ch;
	}

	/* Escritorio: cada nombre con su rol al lado, al pie de la línea. El segundo, corrido a la
	   derecha: el espacio vacío cae de un lado distinto en cada fila. */
	@media (min-width: 1024px) {
		.personas {
			gap: var(--space-3);
		}

		.persona {
			grid-template-columns: auto 1fr;
			align-items: end;
			column-gap: var(--space-5);
		}

		.persona:nth-child(2) {
			grid-template-columns: 1fr auto;
		}

		.persona:nth-child(2) .persona__nombre {
			grid-column: 2;
			grid-row: 1;
		}

		.persona:nth-child(2) .persona__rol {
			grid-column: 1;
			grid-row: 1;
			justify-self: end;
		}

		.persona__rol {
			margin-bottom: var(--space-3);
		}
	}

	@keyframes nombre-desde-izquierda {
		from { transform: translateX(-14%); }
	}

	@keyframes nombre-desde-derecha {
		from { transform: translateX(14%); }
	}

	@keyframes nombre-se-llena {
		from { background-size: 0% 100%; }
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			/* El relleno: una capa del color del titular que crece sobre un gris claro, recortada
			   a las letras. Color plano, no el gradiente de la marca. */
			.persona__texto {
				background: linear-gradient(var(--text-heading-dark), var(--text-heading-dark)) 0 0 / 100% 100% no-repeat;
				background-color: var(--slate-200);
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
				-webkit-text-fill-color: transparent;
				animation: nombre-se-llena linear both;
				animation-timeline: view();
				animation-range: entry 60% cover 55%;
			}

			.persona__nombre {
				animation: nombre-desde-izquierda linear both;
				animation-timeline: view();
				animation-range: entry 0% cover 50%;
			}

			.persona:nth-child(2) .persona__nombre {
				animation-name: nombre-desde-derecha;
			}

			.persona__rol {
				animation: aparecer linear both;
				animation-timeline: view();
				animation-range: entry 40% cover 40%;
			}
		}
	}
</style>
