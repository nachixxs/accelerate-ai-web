---
// Cinta de rubros debajo de la portada: responde "¿sirve para mi rubro?" antes de que lo
// pregunten. Es la única cinta en movimiento de la página: todos los rubros en una sola fila
// que corre lenta de izquierda a derecha, como una cinta transportadora, y se funde en los dos
// costados de la pantalla. Sin botón de pausa (al usuario no le gustó): WCAG 2.2.2 pide poder
// frenar lo que se mueve más de 5 segundos, así que frena con el mouse encima, al tocarla en el
// celular y al llegar con el teclado (la ventana es enfocable). Corre aunque el sistema pida
// movimiento reducido: lo pidió el usuario (ver el comentario de la animación).
// No son clientes: son rubros donde se repiten las mismas tareas todos los días.
import Icono from '../Icono.astro';
import BotonWhatsApp from '../BotonWhatsApp.astro';

const rubros = [
	{ icono: 'printer-duotone', nombre: 'Imprentas' },
	{ icono: 'fork-knife-duotone', nombre: 'Gastronomía' },
	{ icono: 'wrench-duotone', nombre: 'Talleres' },
	{ icono: 'storefront-duotone', nombre: 'Comercios' },
	{ icono: 'stethoscope-duotone', nombre: 'Consultorios' },
	{ icono: 'truck-duotone', nombre: 'Distribuidoras' },
	{ icono: 'buildings-duotone', nombre: 'Inmobiliarias' },
	{ icono: 'calculator-duotone', nombre: 'Estudios contables' },
	{ icono: 'barbell-duotone', nombre: 'Gimnasios' },
	{ icono: 'scissors-duotone', nombre: 'Peluquerías' },
	{ icono: 'paw-print-duotone', nombre: 'Veterinarias' },
	{ icono: 'hammer-duotone', nombre: 'Ferreterías' },
	{ icono: 'airplane-tilt-duotone', nombre: 'Agencias de viaje' },
	{ icono: 'eyeglasses-duotone', nombre: 'Ópticas' },
	{ icono: 'book-open-duotone', nombre: 'Librerías' },
	{ icono: 'car-duotone', nombre: 'Lavaderos de autos' },
	{ icono: 't-shirt-duotone', nombre: 'Indumentaria' },
	{ icono: 'pill-duotone', nombre: 'Farmacias' },
	{ icono: 'graduation-cap-duotone', nombre: 'Institutos' },
];
---

<section class="rubros" aria-labelledby="rubros-titulo">
	<div class="contenedor rubros__cabecera">
		<h2 id="rubros-titulo" class="rubros__titulo">Para cualquier negocio que repite tareas todos los días</h2>
	</div>

	<!-- El marco es enfocable para poder frenar la cinta sin botón: con Tab o con un toque en el
	     celular. Va afuera de la ventana para que la máscara del fundido no borre el foco. -->
	<div class="rubros__marco" tabindex="0" role="group" aria-label="Rubros">
		<div class="rubros__ventana">
			<div class="rubros__pista">
				{
					[false, true].map((copia) => (
						<ul class="rubros__lista" aria-hidden={copia ? 'true' : undefined}>
							{rubros.map(({ icono, nombre }) => (
								<li>
									<span class="rubros__icono">
										<Icono nombre={icono} size={20} />
									</span>
									{nombre}
								</li>
							))}
						</ul>
					))
				}
			</div>
		</div>
	</div>

	<div class="contenedor rubros__pie">
		<BotonWhatsApp
			variante="link"
			texto="¿No ves tu rubro? Contanos el tuyo"
			mensaje="Hola, vi la web. Mi rubro no estaba en la lista y quiero saber si un sistema me sirve."
		/>
	</div>
</section>

<style>
	.rubros {
		padding-block: var(--space-4) var(--space-5);
		border-block: 1px solid var(--border-light);
		background: var(--white);
	}

	.rubros__cabecera {
		margin-bottom: var(--space-2);
	}

	.rubros__pie {
		margin-top: var(--space-2);
	}

	.rubros__titulo {
		color: var(--text-muted-dark);
		font-size: var(--type-meta-size);
		font-weight: var(--fw-medium);
	}

	/* Los costados se funden con el fondo: los rubros aparecen y se van difuminados en vez de
	   cortarse seco. El fundido crece con la pantalla (48 px en el celular, 240 px en la compu). */
	.rubros__ventana {
		--fundido: clamp(48px, 16vw, 240px);
		overflow: hidden;
		mask-image: linear-gradient(
			90deg,
			transparent,
			#000 var(--fundido),
			#000 calc(100% - var(--fundido)),
			transparent
		);
	}

	/* La cinta corre sola de izquierda a derecha: arranca corrida media pista (una copia de la
	   lista) hacia la izquierda y vuelve a cero, donde la copia queda justo en el lugar del
	   original y el salto no se ve. Lineal, porque es movimiento constante. 150 s por vuelta da
	   unos 25 px por segundo: se lee cada rubro sin perseguirlo.
	   Corre también con prefers-reduced-motion: con los efectos de animación de Windows apagados
	   se veía una lista quieta, y el usuario eligió que se mueva siempre (2026-09-24). Es lenta,
	   lineal y se puede frenar. */
	@keyframes cinta {
		from { transform: translateX(-50%); }
		to { transform: translateX(0); }
	}

	.rubros__pista {
		display: flex;
		width: max-content;
		animation: cinta 150s linear infinite;
	}

	/* Frena mientras el marco tiene el foco (Tab, o un toque en el celular: se retoma al tocar
	   afuera) y mientras se mantiene apretada. */
	.rubros__marco:focus .rubros__pista,
	.rubros__marco:active .rubros__pista {
		animation-play-state: paused;
	}

	/* El aire de arriba y abajo separa el anillo de foco de las fichas. */
	.rubros__marco {
		padding-block: 8px;
	}

	.rubros__marco:focus {
		outline: none;
	}

	.rubros__marco:focus-visible {
		outline: 3px solid var(--brand-primary-deep);
		outline-offset: -3px;
	}

	/* Con el mouse encima frena para leer. Solo con puntero fino: en el celular, un toque dejaría
	   el :hover pegado y la cinta frenada. */
	@media (hover: hover) and (pointer: fine) {
		.rubros__marco:hover .rubros__pista {
			animation-play-state: paused;
		}
	}

	.rubros__lista {
		display: flex;
		gap: 12px;
		padding-right: 12px;
	}

	.rubros__lista li {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 6px 18px 6px 6px;
		border: 1px solid var(--border-light);
		border-radius: var(--radius-pill);
		background: var(--surface-alt);
		color: var(--text-heading-dark);
		font-weight: var(--fw-semibold);
		white-space: nowrap;
	}

	/* El ícono en su propio círculo: la píldora se lee como una ficha, no como un tag. */
	.rubros__icono {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: var(--radius-pill);
		background: var(--blue-50);
		color: var(--brand-primary-deep);
	}
</style>
