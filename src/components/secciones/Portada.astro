---
// SPECS §4.1: qué hacen y para quién en una línea, con el botón visible sin scroll.
// Portada partida: el texto a la izquierda y el producto a la derecha (debajo en el celular).
// El producto es el tablero de un negocio con varios sistemas adentro (mocks/MockPanel.astro),
// del ancho de su columna. El titular no se anima: es lo más grande de la primera pantalla
// (el LCP) y tiene que pintarse de entrada.
import BotonWhatsApp from '../BotonWhatsApp.astro';
import Glow from '../Glow.astro';
import MockPanel from '../mocks/MockPanel.astro';
---

<section id="inicio" class="portada con-glow" aria-labelledby="portada-titulo">
	<Glow tono="azul" fondo="claro" esquina="arriba-der" />

	<div class="contenedor portada__grilla">
		<div class="portada__texto">
			<p class="t-eyebrow entrada" style="--orden: 0">Automatización para pymes</p>
			<h1 id="portada-titulo" class="t-hook">
				Tu equipo deja de <span class="texto-gradiente">copiar y pegar</span>
			</h1>
			<p class="t-cuerpo portada__bajada entrada" style="--orden: 1">
				Armamos sistemas a medida para tu negocio. Empezamos con una auditoría gratis para ver
				dónde perdés más tiempo.
			</p>
			<div class="portada__cta entrada" style="--orden: 2">
				<BotonWhatsApp />
			</div>
			<p class="t-meta portada__nota entrada" style="--orden: 3">
				Gratis y sin compromiso. Te contesta Ignacio o Gabriel.
			</p>
		</div>

		<div class="portada__producto">
			<MockPanel />
		</div>
	</div>
</section>

<style>
	/* La cápsula del encabezado es sticky y ocupa 80px en el flujo (8 + 64 + 8,
	   Encabezado.astro:128-134), así que la portada arrancaba en y=80 y el glow se
	   veía cortado en recto. Con el margen negativo arranca en y=0, debajo de la
	   cápsula, y el padding-top compensa para dejar el mismo aire que antes. */
	.portada {
		margin-top: -80px;
		padding-top: calc(80px + var(--space-4));
		padding-bottom: var(--espacio-seccion);
	}

	.portada__grilla {
		display: grid;
		gap: var(--space-5);
	}

	.portada__texto {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-3);
	}

	.portada__bajada {
		max-width: 44ch;
		color: var(--text-body-dark);
	}

	.portada__nota {
		color: var(--text-muted-dark);
	}

	.portada__producto {
		min-width: 0;
	}

	/* El degradé de la marca no llega a 3:1 sobre el fondo claro de la portada (baja a 1,7:1 al
	   final, y a 1,6:1 con el tinte del glow). Acá, y solo acá, va oscurecido: azul profundo a
	   cian 600 (decisión del usuario, ver a11y/INFORME.md #2). El resto de .texto-gradiente
	   (global.css) no cambia: sigue siendo el degradé de marca sobre el cierre oscuro. */
	.portada :global(.texto-gradiente) {
		background: linear-gradient(90deg, var(--brand-primary-deep), var(--cyan-600));
		-webkit-background-clip: text;
		background-clip: text;
	}

	@media (min-width: 1024px) {
		.portada {
			padding-top: calc(80px + var(--space-6));
		}

		.portada__grilla {
			grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
			align-items: center;
			gap: var(--space-5);
		}

		/* La escala del hook a 60 px dejaba el titular parecido al h2: subimos a ~64 px a 1280
		   (68 en el tope) y le sumamos tracking negativo, como las referencias del rubro. */
		.portada :global(.t-hook) {
			font-size: clamp(2.75rem, 1.45rem + 3vw, 4.25rem);
			letter-spacing: -0.03em;
		}

		/* El tablero entra en su columna: antes se pasaba y lo cortaba la pantalla, y se veía
		   demasiado grande (pedido del usuario, 2026-09-25). */
		.portada__producto > :global(*) {
			max-width: 600px;
			margin-left: auto;
		}
	}
</style>
