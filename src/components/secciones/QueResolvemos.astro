---
// SPECS §4.2: 2-3 dolores concretos, contados como los cuenta el dueño.
// Un interruptor "Hoy / Con un sistema" cambia cada dolor por cómo queda resuelto. Funciona como
// un antes y después: la card invertida con las soluciones (la única de la sección) barre por
// encima de los dolores, de izquierda a derecha, y los dolores se tachan. Cada punto de la
// pantalla está siempre en su versión clara o en la oscura: el contraste no baja a mitad de
// camino.
// Todo depende de --p (0 = hoy, 1 = con un sistema). Con un clic o con las flechas, --p va de
// una punta a la otra con una transición de CSS (dos radios y :has(), sin JavaScript). Con el
// script de abajo la perilla además se arrastra, con el mouse o el dedo, y --p sigue al puntero
// (pedido del usuario, 2026-09-25); al soltar se acomoda del lado más cercano.
// Las dos capas tienen las dos versiones de cada fila (la otra oculta): así las filas miden lo
// mismo en las dos y el barrido no se corre.
import Icono from '../Icono.astro';
import BotonWhatsApp from '../BotonWhatsApp.astro';

const dolores = [
	{
		icono: 'package-duotone',
		frase: 'Me entero de lo que falta cuando ya falta.',
		detalle: 'Nadie sabe bien qué queda en el depósito hasta que un cliente lo pide y no hay.',
		solucion: 'Sabés qué reponer antes de quedarte sin nada.',
		como: 'Cada venta descuenta del stock, y cuando algo baja del mínimo el pedido al proveedor ya está armado.',
	},
	{
		icono: 'note-pencil-duotone',
		frase: 'Los pedidos quedan anotados en tres lados.',
		detalle: 'Un cuaderno, un chat y una planilla. En algún pase, siempre se pierde uno.',
		solucion: 'Cada pedido queda en un solo lugar.',
		como: 'Se carga una vez y todo el equipo ve en qué está. Nadie lo pasa a mano.',
	},
	{
		icono: 'calculator-duotone',
		frase: 'Cerrar la caja me lleva una hora.',
		detalle: 'Y cuando no cierra, nadie sabe dónde está la diferencia.',
		solucion: 'El cierre del día sale en minutos.',
		como: 'Cada movimiento queda registrado, y si algo no cuadra ves dónde está la diferencia.',
	},
];

const capas = ['hoy', 'sistema'] as const;
---

<section id="resolvemos" class="seccion resolvemos" aria-labelledby="resolvemos-titulo">
	<div class="contenedor resolvemos__grilla">
		<div class="resolvemos__intro">
			<h2 id="resolvemos-titulo" class="t-titular">¿Te suena alguna de estas?</h2>
			<p class="t-cuerpo">Mirá cómo cambia cada una con un sistema armado para tu negocio.</p>

			<fieldset class="interruptor">
				<legend class="solo-lector">Ver los problemas</legend>
				<span class="interruptor__marca" aria-hidden="true"></span>
				<label>
					<input type="radio" name="resolvemos" value="hoy" checked />
					Hoy
				</label>
				<label>
					<input type="radio" name="resolvemos" value="sistema" class="interruptor__sistema" />
					<Icono nombre="sparkle-duotone" size={18} class="interruptor__chispa" />
					Con un sistema
				</label>
			</fieldset>
		</div>

		<div class="comparar" aria-live="polite">
			{
				capas.map((capa) => (
					<ul class={`lista lista--${capa}`}>
						{dolores.map(({ icono, frase, detalle, solucion, como }, i) => (
							<li class="dolor" style={`--i: ${i}`}>
								<span class="dolor__icono" aria-hidden="true">
									<Icono nombre={capa === 'hoy' ? icono : 'check-circle-duotone'} size={28} />
								</span>
								<div class="dolor__textos">
									<div class="hoy">
										<p class="t-label dolor__frase">
											<span class="tachado">“{frase}”</span>
										</p>
										<p class="dolor__detalle">{detalle}</p>
									</div>
									<div class="sistema">
										<p class="t-label dolor__frase">{solucion}</p>
										<p class="dolor__detalle">{como}</p>
									</div>
								</div>
							</li>
						))}
					</ul>
				))
			}
			<span class="comparar__borde" aria-hidden="true"></span>
		</div>

		<div class="resolvemos__pie">
			<BotonWhatsApp
				variante="contorno"
				texto="Quiero sacarme esto de encima"
				mensaje="Hola, vi la web. Me pasa alguna de esas y quiero ver cómo resolverla."
			/>
		</div>
	</div>
</section>

<script>
	// La perilla se arrastra: --p sigue al puntero y, al soltar, el radio queda del lado más
	// cercano (o del lado hacia el que la tiraste, si fue un tirón rápido). Un clic sin arrastrar
	// lo resuelve el label, como sin JavaScript.
	const seccion = document.querySelector<HTMLElement>('.resolvemos');
	if (seccion) {
		const interruptor = seccion.querySelector<HTMLElement>('.interruptor')!;
		const [hoy, sistema] = seccion.querySelectorAll<HTMLInputElement>('.interruptor input');
		let arrastre: { x: number; p: number; ancho: number; id: number; t: number; v: number } | null = null;
		let moviendo = false;

		const elegir = (conSistema: boolean) => {
			if (sistema.checked !== conSistema) (conSistema ? sistema : hoy).checked = true;
		};

		interruptor.addEventListener('pointerdown', (evento) => {
			if (evento.button !== 0 || arrastre) return;
			arrastre = {
				x: evento.clientX,
				p: sistema.checked ? 1 : 0,
				ancho: interruptor.offsetWidth / 2,
				id: evento.pointerId,
				t: evento.timeStamp,
				v: 0,
			};
		});

		interruptor.addEventListener('pointermove', (evento) => {
			if (!arrastre || evento.pointerId !== arrastre.id) return;
			const dx = evento.clientX - arrastre.x;
			if (!moviendo) {
				if (Math.abs(dx) < 4) return;
				// Recién ahora se captura el puntero: con un clic simple, el clic le llega al label.
				moviendo = true;
				interruptor.setPointerCapture(evento.pointerId);
				seccion.classList.add('resolvemos--arrastrando');
			}
			const p = Math.min(1, Math.max(0, arrastre.p + dx / arrastre.ancho));
			arrastre.v = evento.movementX / Math.max(1, evento.timeStamp - arrastre.t);
			arrastre.t = evento.timeStamp;
			seccion.style.setProperty('--p', String(p));
			elegir(p > 0.5);
		});

		const soltar = (evento: PointerEvent) => {
			if (!arrastre || evento.pointerId !== arrastre.id) return;
			if (moviendo) {
				// Un tirón rápido decide por la dirección, aunque no haya pasado la mitad.
				if (Math.abs(arrastre.v) > 0.11) elegir(arrastre.v > 0);
				seccion.classList.remove('resolvemos--arrastrando');
				seccion.style.removeProperty('--p');
				// El clic que sigue a un arrastre no tiene que volver a cambiar el radio.
				interruptor.addEventListener('click', (clic) => clic.preventDefault(), { capture: true, once: true });
			}
			arrastre = null;
			moviendo = false;
		};

		interruptor.addEventListener('pointerup', soltar);
		interruptor.addEventListener('pointercancel', soltar);
	}
</script>

<style>
	/* --p: cuánto del cambio se ve, de 0 (hoy) a 1 (con un sistema). Registrada para que se pueda
	   animar con una transición. */
	@property --p {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}

	.resolvemos {
		--p: 0;
		--duracion: 0.45s;
		transition: --p var(--duracion) var(--curva-cajon);
	}

	.resolvemos:has(.interruptor__sistema:checked) {
		--p: 1;
	}

	/* Mientras arrastrás, --p va pegado al puntero. */
	.resolvemos--arrastrando {
		transition: none;
	}

	.resolvemos__grilla {
		display: grid;
		gap: var(--space-5);
	}

	.resolvemos__intro {
		display: grid;
		justify-items: start;
		align-content: start;
		gap: var(--space-3);
	}

	.resolvemos__intro .t-cuerpo {
		max-width: 36ch;
	}

	/* --- El interruptor: dos radios con forma de píldora partida. La marca que se desliza es
	   el fill #1f57c2 del estado activo de la marca. touch-action: el dedo que se desliza de
	   costado arrastra la perilla; el que sube o baja, la página. --- */
	.interruptor {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 1fr;
		margin: var(--space-1) 0 0;
		padding: 4px;
		border: 1px solid var(--border-light);
		border-radius: var(--radius-pill);
		background: var(--white);
		box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
		touch-action: pan-y;
		user-select: none;
		-webkit-user-select: none;
	}

	.interruptor__marca {
		grid-area: 1 / 1;
		border-radius: var(--radius-pill);
		background: var(--brand-primary-deep);
		box-shadow: 0 6px 16px rgba(15, 36, 80, 0.28);
		transform: translateX(calc(var(--p) * 100%));
	}

	.resolvemos--arrastrando .interruptor,
	.resolvemos--arrastrando .interruptor label {
		cursor: grabbing;
	}

	.interruptor label {
		position: relative;
		grid-row: 1;
		grid-column: 1;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		min-height: 48px;
		padding-inline: var(--space-2);
		border-radius: var(--radius-pill);
		font-weight: var(--fw-semibold);
		white-space: nowrap;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}

	/* El texto es blanco justo donde está la perilla y oscuro donde no: a mitad de un arrastre,
	   una palabra puede quedar mitad y mitad. Cada label mide lo mismo que la perilla, así que el
	   corte cae en --p × 100 % de su ancho. */
	.interruptor label {
		--tinta: var(--text-body-dark);
		background: linear-gradient(90deg, var(--tinta) calc(var(--p) * 100%), var(--white) 0);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.interruptor label:nth-of-type(2) {
		background-image: linear-gradient(90deg, var(--white) calc(var(--p) * 100%), var(--tinta) 0);
	}

	/* Las dos columnas miden lo que la opción más larga: con letra grande en el celular, 24 px de
	   aire por lado empujaban el interruptor fuera del margen. */
	@media (min-width: 640px) {
		.interruptor label {
			padding-inline: var(--space-3);
		}
	}

	/* La marca comparte la primera celda con "Hoy": cada opción va en su columna, o la grilla
	   las empuja a una tercera. */
	.interruptor label:nth-of-type(2) {
		grid-column: 2;
	}

	.interruptor input {
		position: absolute;
		inset: 0;
		margin: 0;
		opacity: 0;
		cursor: inherit;
	}

	.interruptor label:has(input:focus-visible) {
		outline: 3px solid var(--brand-primary-deep);
		outline-offset: 3px;
	}

	@media (hover: hover) and (pointer: fine) {
		.interruptor label:not(:has(input:checked)):hover {
			--tinta: var(--brand-primary-deep);
		}
	}

	/* El ícono no toma el recorte del texto: va de color pleno, blanco cuando la perilla lo tapa. */
	.interruptor :global(.interruptor__chispa) {
		color: var(--brand-primary-deep);
		transform: rotate(calc(var(--p) * 72deg));
	}

	.resolvemos:has(.interruptor__sistema:checked) .interruptor :global(.interruptor__chispa) {
		color: var(--white);
	}

	/* --- Las dos capas, una encima de la otra. --- */
	.comparar {
		position: relative;
		display: grid;
		container-type: inline-size;
	}

	.lista {
		grid-area: 1 / 1;
		display: grid;
		padding: var(--space-2) var(--space-3);
		border: 1px solid transparent;
		border-radius: var(--radius-card-lg);
	}

	.dolor {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: var(--space-2);
		padding-block: var(--space-3);
	}

	/* Las dos versiones de cada fila ocupan la misma celda: la fila mide lo que la más alta. */
	.dolor__textos {
		display: grid;
	}

	.dolor__textos > * {
		grid-area: 1 / 1;
	}

	.dolor__icono {
		display: grid;
		align-self: start;
		place-items: center;
		width: 48px;
		height: 48px;
		border: 1px dashed var(--slate-300);
		border-radius: var(--radius-pill);
		color: var(--brand-primary-deep);
	}

	.dolor__frase {
		color: var(--text-heading-dark);
		font-weight: var(--fw-semibold);
	}

	.dolor__detalle {
		margin-top: var(--space-1);
	}

	/* Hoy: sin contenedor, con divisiones punteadas, como anotado a las apuradas. */
	.lista--hoy .dolor + .dolor {
		border-top: 1px dashed var(--slate-300);
	}

	.lista--hoy .sistema,
	.lista--sistema .hoy {
		visibility: hidden;
	}

	/* La tachadura: una línea de fondo que crece con --p, un dolor detrás de otro;
	   box-decoration-break la repite en cada renglón de la frase. */
	.tachado {
		--tachado: clamp(0, var(--p) * 2.2 - var(--i) * 0.4, 1);
		background: linear-gradient(var(--brand-primary-deep), var(--brand-primary-deep)) no-repeat 0 58% / calc(var(--tachado) * 100%) 2px;
		-webkit-box-decoration-break: clone;
		box-decoration-break: clone;
	}

	/* Con un sistema: la card invertida, todo alineado. Barre desde la izquierda: el recorte se
	   come desde la derecha lo que todavía no llegó. */
	.lista--sistema {
		border-color: var(--border-dark);
		background: var(--surface-card-dark);
		clip-path: inset(0 calc((1 - var(--p)) * 100%) 0 0);
	}

	.lista--sistema .dolor + .dolor {
		border-top: 1px solid var(--border-dark);
	}

	.lista--sistema .dolor__icono {
		border-style: solid;
		border-color: var(--border-dark);
		background: var(--blue-950);
		color: var(--brand-accent);
	}

	.lista--sistema .dolor__frase {
		color: var(--text-heading-light);
	}

	.lista--sistema .dolor__detalle {
		color: var(--text-body-light);
	}

	/* La línea del barrido: cian, en el borde de la card que avanza. Se ve solo a mitad de camino. */
	.comparar__borde {
		position: absolute;
		top: 0;
		bottom: 0;
		left: -1px;
		width: 2px;
		border-radius: 2px;
		background: var(--cyan-400);
		opacity: clamp(0, min(var(--p), 1 - var(--p)) * 16, 1);
		transform: translateX(calc(var(--p) * 100cqw));
		pointer-events: none;
	}

	/* Para los lectores de pantalla (y el foco) existe una sola capa: la elegida. La otra se
	   oculta cuando termina el barrido; mientras arrastrás, se ven las dos. */
	.lista--sistema {
		visibility: hidden;
		transition: visibility 0s var(--duracion);
	}

	.resolvemos:has(.interruptor__sistema:checked) .lista--sistema,
	.resolvemos--arrastrando .lista--sistema {
		visibility: visible;
		transition: none;
	}

	.resolvemos:has(.interruptor__sistema:checked) .lista--hoy {
		visibility: hidden;
		transition: visibility 0s var(--duracion);
	}

	.resolvemos.resolvemos--arrastrando .lista--hoy {
		visibility: visible;
		transition: none;
	}

	@media (min-width: 1024px) {
		.resolvemos__grilla {
			grid-template-columns: 5fr 7fr;
			gap: var(--space-6);
		}

		/* El botón va después de las filas, no entre el interruptor y lo que el interruptor cambia. */
		.resolvemos__pie {
			grid-column: 2;
		}

		.resolvemos__intro {
			position: sticky;
			top: 120px;
		}

		.lista {
			padding: var(--space-3) var(--space-5);
		}
	}

	/* --- Movimiento. El barrido es un recorte y no un desplazamiento: queda también con
	   movimiento reducido, más corto. --- */
	@media (prefers-reduced-motion: reduce) {
		.resolvemos {
			--duracion: 0.25s;
		}
	}

	/* Dos anillos que se abren y se apagan. */
	@keyframes invita {
		0%, 50% { box-shadow: 0 0 0 0 var(--blue-200); opacity: 0; }
		5%, 55% { opacity: 1; }
		45%, 95%, 100% { box-shadow: 0 0 0 14px var(--blue-200); opacity: 0; }
	}

	@media (prefers-reduced-motion: no-preference) {
		/* Invitación a tocar: cuando la sección llega a la pantalla, un anillo sale dos veces del
		   interruptor. Atado al scroll: no queda latiendo mientras leés, y si ya lo tocaste no
		   aparece más. */
		@supports (animation-timeline: view()) {
			.interruptor::after {
				content: '';
				position: absolute;
				inset: -1px;
				border-radius: inherit;
				pointer-events: none;
				animation: invita linear both;
				animation-timeline: view();
				animation-range: entry 100% cover 55%;
			}

			.resolvemos:has(.interruptor__sistema:checked) .interruptor::after {
				animation: none;
			}

			.dolor {
				animation: entrar-subiendo linear both;
				animation-timeline: view();
				animation-range: entry 10% entry 80%;
			}
		}
	}
</style>
