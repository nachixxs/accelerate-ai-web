---
// SPECS §4.2: 2-3 dolores concretos, contados como los cuenta el dueño.
// Un interruptor "Hoy / Con un sistema" cambia cada dolor por cómo queda resuelto. Cada fila tiene
// dos caras en la misma celda: la de hoy (suelta sobre el fondo, con divisiones punteadas) y la
// resuelta (oscura). Al cambiar, cada dolor se tacha y después su cara oscura lo barre entero, en
// 350 ms: la card invertida (la única de la sección) se arma fila por fila. Ningún texto queda
// cortado a mitad de camino, y cada punto de la pantalla está siempre en su versión clara o en
// la oscura: el contraste no baja nunca.
// Con un clic o con las flechas, todo sale de los radios y :has(), sin JavaScript. Con el script
// de abajo la perilla además se arrastra (pedido del usuario, 2026-09-25): la tachadura sigue al
// puntero y cada fila se da vuelta cuando la perilla pasa su punto (--t). Al soltar se acomoda
// del lado más cercano, o hacia el que la tiraste.
import Icono from '../Icono.astro';
import BotonWhatsApp from '../BotonWhatsApp.astro';

const dolores = [
	{
		icono: 'package-duotone',
		frase: 'Me entero de lo que falta cuando ya falta.',
		detalle: 'Nadie sabe bien qué queda en el depósito hasta que un cliente lo pide y no hay.',
		solucion: 'Sabés qué reponer antes de quedarte sin nada.',
		como: 'Cada venta descuenta del stock, y cuando algo baja del mínimo el pedido al proveedor ya está armado.',
	},
	{
		icono: 'note-pencil-duotone',
		frase: 'Los pedidos quedan anotados en tres lados.',
		detalle: 'Un cuaderno, un chat y una planilla. En algún pase, siempre se pierde uno.',
		solucion: 'Cada pedido queda en un solo lugar.',
		como: 'Se carga una vez y todo el equipo ve en qué está. Nadie lo pasa a mano.',
	},
	{
		icono: 'calculator-duotone',
		frase: 'Cerrar la caja me lleva una hora.',
		detalle: 'Y cuando no cierra, nadie sabe dónde está la diferencia.',
		solucion: 'El cierre del día sale en minutos.',
		como: 'Cada movimiento queda registrado, y si algo no cuadra ves dónde está la diferencia.',
	},
];

// El punto de la perilla (de 0 a 1) en el que se da vuelta cada fila.
const punto = (i: number) => 0.3 + i * 0.25;
---

<section id="resolvemos" class="seccion resolvemos" aria-labelledby="resolvemos-titulo">
	<div class="contenedor resolvemos__grilla">
		<div class="resolvemos__intro">
			<h2 id="resolvemos-titulo" class="t-titular">¿Te suena alguna de estas?</h2>
			<p class="t-cuerpo">Mirá cómo cambia cada una con un sistema armado para tu negocio.</p>

			<fieldset class="interruptor">
				<legend class="solo-lector">Ver los problemas</legend>
				<span class="interruptor__marca" aria-hidden="true"></span>
				<label>
					<input type="radio" name="resolvemos" value="hoy" checked />
					Hoy
				</label>
				<label>
					<input type="radio" name="resolvemos" value="sistema" class="interruptor__sistema" />
					<Icono nombre="sparkle-duotone" size={18} class="interruptor__chispa" />
					Con un sistema
				</label>
			</fieldset>
		</div>

		<ul class="lista" aria-live="polite">
			{
				dolores.map(({ icono, frase, detalle, solucion, como }, i) => (
					<li class="dolor" style={`--i: ${i}; --t: ${punto(i)}`} data-punto={punto(i)}>
						{(['hoy', 'sistema'] as const).map((cara) => (
							<div class={`cara cara--${cara}`}>
								<span class="cara__icono" aria-hidden="true">
									<Icono nombre={cara === 'hoy' ? icono : 'check-circle-duotone'} size={28} />
								</span>
								<div class="cara__textos">
									<div class="hoy">
										<p class="t-label dolor__frase">
											<span class="tachado">“{frase}”</span>
										</p>
										<p class="dolor__detalle">{detalle}</p>
									</div>
									<div class="sistema">
										<p class="t-label dolor__frase">{solucion}</p>
										<p class="dolor__detalle">{como}</p>
									</div>
								</div>
							</div>
						))}
					</li>
				))
			}
		</ul>

		<div class="resolvemos__pie">
			<BotonWhatsApp
				variante="contorno"
				texto="Quiero sacarme esto de encima"
				mensaje="Hola, vi la web. Me pasa alguna de esas y quiero ver cómo resolverla."
			/>
		</div>
	</div>
</section>

<script>
	// La perilla se arrastra: --p (de 0 a 1) sigue al puntero y cada fila se da vuelta cuando la
	// perilla pasa su punto. Al soltar, el radio queda del lado más cercano (o hacia el que la
	// tiraste, si fue un tirón rápido). Un clic sin arrastrar lo resuelve el label, como sin
	// JavaScript.
	const seccion = document.querySelector<HTMLElement>('.resolvemos');
	if (seccion) {
		const interruptor = seccion.querySelector<HTMLElement>('.interruptor')!;
		const lista = seccion.querySelector<HTMLElement>('.lista')!;
		const [hoy, sistema] = seccion.querySelectorAll<HTMLInputElement>('.interruptor input');
		const filas = [...seccion.querySelectorAll<HTMLElement>('.dolor')];
		let arrastre: { x: number; p: number; ancho: number; id: number; t: number; v: number } | null = null;
		let moviendo = false;

		const elegir = (conSistema: boolean) => {
			if (sistema.checked !== conSistema) (conSistema ? sistema : hoy).checked = true;
		};

		interruptor.addEventListener('pointerdown', (evento) => {
			if (evento.button !== 0 || arrastre) return;
			arrastre = {
				x: evento.clientX,
				p: sistema.checked ? 1 : 0,
				ancho: interruptor.offsetWidth / 2 - 4,
				id: evento.pointerId,
				t: evento.timeStamp,
				v: 0,
			};
		});

		interruptor.addEventListener('pointermove', (evento) => {
			if (!arrastre || evento.pointerId !== arrastre.id) return;
			const dx = evento.clientX - arrastre.x;
			if (!moviendo) {
				if (Math.abs(dx) < 4) return;
				// Recién ahora se captura el puntero: con un clic simple, el clic le llega al label.
				moviendo = true;
				interruptor.setPointerCapture(evento.pointerId);
				seccion.classList.add('resolvemos--arrastrando');
			}
			const p = Math.min(1, Math.max(0, arrastre.p + dx / arrastre.ancho));
			arrastre.v = evento.movementX / Math.max(1, evento.timeStamp - arrastre.t);
			arrastre.t = evento.timeStamp;
			// Se escribe solo en donde --p se usa (el interruptor y la lista), no en toda la
			// sección: si no, cada pointermove recalcula el estilo del botón del pie también.
			interruptor.style.setProperty('--p', String(p));
			lista.style.setProperty('--p', String(p));
			filas.forEach((fila) => fila.classList.toggle('dolor--vuelta', p >= Number(fila.dataset.punto)));
			elegir(p > 0.5);
		});

		// Al soltar con el dedo no llega ningún click, así que este listener sacaría el próximo
		// toque real si quedara colgado esperando el clic fantasma: se saca solo en el próximo tick.
		const bloquear = (clic: MouseEvent) => clic.preventDefault();

		const soltar = (evento: PointerEvent) => {
			if (!arrastre || evento.pointerId !== arrastre.id) return;
			if (moviendo) {
				// Un tirón rápido decide por la dirección, aunque no haya pasado la mitad.
				if (Math.abs(arrastre.v) > 0.11) elegir(arrastre.v > 0);
				// El --p de la sección ya saltó al valor final sin transición (cada elegir() de
				// arriba cambia el radio y con él el :has() de la sección), aunque solo el
				// interruptor y la lista mostraban el p soltado. Se pasa ese p soltado a la
				// sección primero (todavía con resolvemos--arrastrando puesta, sin transición) y
				// se fuerza el estilo, para que recién después, al sacar la clase y el --p de
				// acá, transicione de p a ese valor final en vez de saltar.
				const p = interruptor.style.getPropertyValue('--p');
				seccion.style.setProperty('--p', p);
				interruptor.style.removeProperty('--p');
				lista.style.removeProperty('--p');
				filas.forEach((fila) => fila.classList.remove('dolor--vuelta'));
				getComputedStyle(seccion).getPropertyValue('--p');
				seccion.classList.remove('resolvemos--arrastrando');
				seccion.style.removeProperty('--p');
				// El clic que sigue a un arrastre (si llega, con mouse) no tiene que volver a
				// cambiar el radio.
				interruptor.addEventListener('click', bloquear, { capture: true, once: true });
				setTimeout(() => interruptor.removeEventListener('click', bloquear, true), 0);
			}
			arrastre = null;
			moviendo = false;
		};

		interruptor.addEventListener('pointerup', soltar);
		interruptor.addEventListener('pointercancel', soltar);
	}
</script>

<style>
	/* --p: dónde está la perilla, de 0 (hoy) a 1 (con un sistema). --vuelta: cuánto de la cara
	   oscura cubre la fila. --tachar: cuánto de la frase está tachado. Registradas para que se
	   puedan animar con transiciones. */
	@property --p {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}

	@property --vuelta {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}

	@property --tachar {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}

	.resolvemos {
		--p: 0;
		transition: --p 0.25s var(--curva-cajon);
	}

	.resolvemos:has(.interruptor__sistema:checked) {
		--p: 1;
	}

	/* Mientras arrastrás, la perilla va pegada al puntero. */
	.resolvemos--arrastrando {
		transition: none;
	}

	.resolvemos__grilla {
		display: grid;
		gap: var(--space-5);
	}

	.resolvemos__intro {
		display: grid;
		justify-items: start;
		align-content: start;
		gap: var(--space-3);
	}

	.resolvemos__intro .t-cuerpo {
		max-width: 36ch;
	}

	/* --- El interruptor: dos radios con forma de píldora partida. La perilla que se desliza es
	   el fill #1f57c2 del estado activo de la marca. touch-action: el dedo que se desliza de
	   costado arrastra la perilla; el que sube o baja, la página. --- */
	.interruptor {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 1fr;
		margin: var(--space-1) 0 0;
		padding: 4px;
		border: 1px solid var(--border-light);
		border-radius: var(--radius-pill);
		background: var(--white);
		box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
		touch-action: pan-y;
		user-select: none;
		-webkit-user-select: none;
	}

	.interruptor__marca {
		grid-area: 1 / 1;
		border-radius: var(--radius-pill);
		background: var(--brand-primary-deep);
		box-shadow: 0 6px 16px rgba(15, 36, 80, 0.28);
		transform: translateX(calc(var(--p) * 100%));
		transition: scale 0.15s var(--curva-salida);
	}

	/* Agarrada, la perilla crece un poco: se siente que la tenés en la mano. */
	.resolvemos--arrastrando .interruptor__marca {
		scale: 1.04;
	}

	.resolvemos--arrastrando .interruptor,
	.resolvemos--arrastrando .interruptor label {
		cursor: grabbing;
	}

	.interruptor label {
		position: relative;
		grid-row: 1;
		grid-column: 1;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		min-height: 48px;
		padding-inline: var(--space-2);
		border-radius: var(--radius-pill);
		font-weight: var(--fw-semibold);
		white-space: nowrap;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}

	/* El texto es blanco justo donde está la perilla y oscuro donde no. Cada label mide lo mismo
	   que la perilla, así que el corte cae en --p × 100 % de su ancho. */
	.interruptor label {
		--tinta: var(--text-body-dark);
		background: linear-gradient(90deg, var(--tinta) calc(var(--p) * 100%), var(--white) 0);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.interruptor label:nth-of-type(2) {
		grid-column: 2;
		background-image: linear-gradient(90deg, var(--white) calc(var(--p) * 100%), var(--tinta) 0);
	}

	/* Las dos columnas miden lo que la opción más larga: con letra grande en el celular, 24 px de
	   aire por lado empujaban el interruptor fuera del margen. */
	@media (min-width: 640px) {
		.interruptor label {
			padding-inline: var(--space-3);
		}
	}

	.interruptor input {
		position: absolute;
		inset: 0;
		margin: 0;
		opacity: 0;
		cursor: inherit;
	}

	.interruptor label:has(input:focus-visible) {
		outline: 3px solid var(--brand-primary-deep);
		outline-offset: 3px;
	}

	@media (hover: hover) and (pointer: fine) {
		.interruptor label:not(:has(input:checked)):hover {
			--tinta: var(--brand-primary-deep);
		}
	}

	/* El ícono no toma el recorte del texto: va de color pleno, blanco cuando la perilla lo tapa. */
	.interruptor :global(.interruptor__chispa) {
		color: var(--brand-primary-deep);
		transform: rotate(calc(var(--p) * 72deg));
		transition: color 0.15s ease;
	}

	.resolvemos:has(.interruptor__sistema:checked) .interruptor :global(.interruptor__chispa) {
		color: var(--white);
	}

	/* --- La lista: cada fila con sus dos caras, una encima de la otra. --- */
	.lista {
		position: relative;
		display: grid;
	}

	/* La sombra de la card, en una capa que solo cambia de opacidad: se enciende cuando la card
	   está entera. */
	.lista::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: var(--radius-card-lg);
		box-shadow: var(--shadow-card);
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.resolvemos:where(:has(.interruptor__sistema:checked)) .lista::before {
		opacity: 1;
		transition-delay: 0.5s;
	}

	.dolor {
		--vuelta: 0;
		--tachar: 0;
		display: grid;
		transition:
			--tachar 0.2s var(--curva-salida) calc(var(--i) * 90ms),
			--vuelta 0.35s var(--curva-salida) calc(150ms + var(--i) * 90ms);
	}

	.resolvemos:where(:has(.interruptor__sistema:checked)) .dolor {
		--vuelta: 1;
		--tachar: 1;
	}

	/* Al volver a hoy, la tachadura se borra después de que la fila se dio vuelta. */
	.resolvemos:where(:not(:has(.interruptor__sistema:checked))) .dolor {
		transition:
			--tachar 0.2s var(--curva-salida) calc(350ms + var(--i) * 90ms),
			--vuelta 0.35s var(--curva-salida) calc(var(--i) * 90ms);
	}

	/* Las reglas de los radios van en :where() para pesar menos que las del arrastre, que tienen
	   que ganarles aunque el radio ya haya cambiado a mitad de camino. */
	/* Arrastrando: la tachadura sigue a la perilla (llega entera justo al punto de la fila) y la
	   fila se da vuelta al pasarlo. */
	.resolvemos.resolvemos--arrastrando .dolor {
		--tachar: clamp(0, (var(--p) - var(--t) + 0.2) * 5, 1);
		--vuelta: 0;
		transition: --vuelta 0.35s var(--curva-salida);
	}

	.resolvemos.resolvemos--arrastrando .dolor.dolor--vuelta {
		--vuelta: 1;
	}

	.cara {
		grid-area: 1 / 1;
		display: grid;
		grid-template-columns: auto 1fr;
		gap: var(--space-2);
		padding: var(--space-3);
	}

	.dolor:first-child .cara {
		padding-top: var(--space-4);
	}

	.dolor:last-child .cara {
		padding-bottom: var(--space-4);
	}

	/* Las dos versiones del texto ocupan la misma celda en las dos caras: las filas miden lo
	   mismo en las dos y la cara oscura cae justo encima de la clara. */
	.cara__textos {
		display: grid;
	}

	.cara__textos > * {
		grid-area: 1 / 1;
	}

	.cara--hoy .sistema,
	.cara--sistema .hoy {
		visibility: hidden;
	}

	.cara__icono {
		display: grid;
		align-self: start;
		place-items: center;
		width: 48px;
		height: 48px;
		border: 1px dashed var(--slate-300);
		border-radius: var(--radius-pill);
		color: var(--brand-primary-deep);
	}

	.dolor__frase {
		color: var(--text-heading-dark);
		font-weight: var(--fw-semibold);
	}

	.dolor__detalle {
		margin-top: var(--space-1);
	}

	/* Hoy: sin contenedor, con divisiones punteadas, como anotado a las apuradas. */
	.dolor + .dolor .cara--hoy {
		border-top: 1px dashed var(--slate-300);
	}

	/* La tachadura: una línea de fondo; box-decoration-break la repite en cada renglón. */
	.tachado {
		background: linear-gradient(var(--brand-primary-deep), var(--brand-primary-deep)) no-repeat 0 58% / calc(var(--tachar) * 100%) 2px;
		-webkit-box-decoration-break: clone;
		box-decoration-break: clone;
	}

	/* Resuelto: la cara oscura barre la fila de izquierda a derecha. Las filas juntas forman la
	   card invertida: la primera lleva las esquinas de arriba y la última las de abajo. */
	.cara--sistema {
		background: var(--surface-card-dark);
		clip-path: inset(0 calc((1 - var(--vuelta)) * 100%) 0 0);
	}

	.dolor:first-child .cara--sistema {
		border-radius: var(--radius-card-lg) var(--radius-card-lg) 0 0;
	}

	.dolor:last-child .cara--sistema {
		border-radius: 0 0 var(--radius-card-lg) var(--radius-card-lg);
	}

	.dolor + .dolor .cara--sistema {
		box-shadow: inset 0 1px var(--border-dark);
	}

	.cara--sistema .cara__icono {
		border-style: solid;
		border-color: var(--border-dark);
		background: var(--blue-950);
		color: var(--brand-accent);
	}

	.cara--sistema .dolor__frase {
		color: var(--text-heading-light);
	}

	.cara--sistema .dolor__detalle {
		color: var(--text-body-light);
	}

	/* Para los lectores de pantalla (y el foco) existe una sola cara por fila: la elegida. La otra
	   se oculta cuando terminó de darse vuelta; mientras arrastrás, se ven las dos. */
	.cara--sistema {
		visibility: hidden;
		transition: visibility 0s 0.8s;
	}

	.resolvemos:where(:has(.interruptor__sistema:checked)) .cara--sistema,
	.resolvemos--arrastrando .cara--sistema {
		visibility: visible;
		transition: none;
	}

	.resolvemos:where(:has(.interruptor__sistema:checked)) .cara--hoy {
		visibility: hidden;
		transition: visibility 0s 0.8s;
	}

	.resolvemos.resolvemos--arrastrando .cara--hoy {
		visibility: visible;
		transition: none;
	}

	@media (min-width: 1024px) {
		.resolvemos__grilla {
			grid-template-columns: 5fr 7fr;
			gap: var(--space-6);
		}

		/* El botón va después de las filas, no entre el interruptor y lo que el interruptor cambia. */
		.resolvemos__pie {
			grid-column: 2;
		}

		.resolvemos__intro {
			position: sticky;
			top: 120px;
		}

		.cara {
			padding-inline: var(--space-5);
		}
	}

	/* --- Movimiento. La perilla, la chispa y el barrido fila por fila corren también con
	   movimiento reducido: los dispara quien toca el interruptor, no el scroll. Lo que sigue
	   (el anillo que invita y la entrada de las filas) sí se apaga con reducción, porque lo
	   dispara el scroll y no una acción directa. --- */
	/* Un anillo que se abre y se apaga. */
	@keyframes invita {
		0%, 50% { scale: 1; opacity: 0; }
		5%, 55% { opacity: 1; }
		45%, 95%, 100% { scale: 1.14; opacity: 0; }
	}

	@media (prefers-reduced-motion: no-preference) {
		/* Invitación a tocar: cuando la sección llega a la pantalla, un anillo sale dos veces del
		   interruptor. Atado al scroll: no queda latiendo mientras leés, y si ya lo tocaste no
		   aparece más. */
		@supports (animation-timeline: view()) {
			.interruptor::after {
				content: '';
				position: absolute;
				inset: -1px;
				border: 2px solid var(--blue-200);
				border-radius: inherit;
				pointer-events: none;
				animation: invita linear both;
				animation-timeline: view();
				animation-range: entry 100% cover 55%;
			}

			.resolvemos:has(.interruptor__sistema:checked) .interruptor::after {
				animation: none;
			}

			.dolor {
				animation: entrar-subiendo linear both;
				animation-timeline: view();
				animation-range: entry 10% entry 80%;
			}
		}
	}
</style>
