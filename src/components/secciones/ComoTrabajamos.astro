---
// SPECS §4.4 y el proceso de venta: auditoría gratis → propuesta con dos números →
// construcción de 1 a 3 semanas con demo a mitad de camino → soporte mensual.
// Es un <ol>: el orden ya lo dice la lista, sin rótulos de "Paso 1".
// Los pasos van sobre un riel a la izquierda que se llena con el scroll; cada marca se enciende
// cuando la punta la alcanza. En escritorio, a la derecha, una sola card invertida queda fija y
// cambia de pantalla según el paso que está a media pantalla. En el celular no hay nada fijo:
// cada paso lleva su visual abajo, en card clara (la propuesta es la única invertida).
// Con movimiento reducido (decisión del usuario, 2026-09-28), o sin soporte de animaciones atadas
// al scroll, la card fija no existe: en escritorio cada visual queda al lado de su paso, completo
// y quieto, como en el celular. Sin JS la card fija sigue el scroll sola: el script solo suma.
import { Image } from 'astro:assets';
import Icono from '../Icono.astro';
import avatar from '../../assets/identidad/avatar-claro.png';
import BotonWhatsApp from '../BotonWhatsApp.astro';

const auditoria = [
	{ proceso: 'Pedidos', tiempo: 0.55 },
	{ proceso: 'Caja', tiempo: 0.4 },
	{ proceso: 'Turnos', tiempo: 1, elegido: true },
	{ proceso: 'Stock', tiempo: 0.25 },
];
---

<section id="proceso" class="seccion proceso" aria-labelledby="proceso-titulo">
	<div class="contenedor">
		<div class="encabezado-seccion revelar">
			<p class="t-eyebrow">Cómo trabajamos</p>
			<h2 id="proceso-titulo" class="t-titular">Primero entendemos tu negocio, después construimos</h2>
		</div>

		<div class="proceso__riel">
		<ol class="linea">
			<li class="paso">
				<span class="paso__marca"><Icono nombre="magnifying-glass-duotone" size={22} /></span>
				<div class="paso__texto" style="--paso: --paso-1">
					<h3 class="t-label">Auditoría gratis</h3>
					<p>Una charla de 30 a 45&nbsp;minutos sobre cómo se mueve tu negocio. Salimos con un problema concreto para resolver.</p>
				</div>
				<div class="pantalla pantalla--1 fundir" aria-hidden="true">
					<span class="pantalla__titulo">Dónde se va el tiempo</span>
					<ul class="auditoria">
						{
							auditoria.map(({ proceso, tiempo, elegido }, i) => (
								<li class:list={['auditoria__fila', { 'auditoria__fila--elegida': elegido }]} style={`--i: ${i}`}>
									<span class="auditoria__nombre">{proceso}</span>
									<span class="auditoria__barra">
										<span style={`--tiempo: ${tiempo}`} />
									</span>
								</li>
							))
						}
					</ul>
					<span class="pantalla__chip">
						<Icono nombre="target-duotone" size={16} />
						Turnos: el que más tiempo te lleva
					</span>
				</div>
			</li>

			<li class="paso">
				<span class="paso__marca"><Icono nombre="file-text-duotone" size={22} /></span>
				<div class="paso__texto" style="--paso: --paso-2">
					<h3 class="t-label">Propuesta con dos números</h3>
					<p>Lo que cuesta armarlo y lo que cuesta por mes, con la fecha de entrega.</p>
				</div>
				<div class="pantalla pantalla--2 pantalla--invertida fundir" aria-hidden="true">
					<span class="pantalla__titulo">Propuesta</span>
					<dl class="propuesta">
						<div style="--i: 0"><dt>Armado</dt><dd>un pago</dd></div>
						<div style="--i: 1"><dt>Soporte</dt><dd>por mes</dd></div>
						<div style="--i: 2"><dt>Entrega</dt><dd>con fecha</dd></div>
					</dl>
					<span class="propuesta__sello">
						<Icono nombre="seal-check-duotone" size={18} />
						Aprobada
					</span>
				</div>
			</li>

			<li class="paso">
				<span class="paso__marca"><Icono nombre="hammer-duotone" size={22} /></span>
				<div class="paso__texto" style="--paso: --paso-3">
					<h3 class="t-label">Construcción en 1 a 3&nbsp;semanas</h3>
					<p>A mitad de camino te mostramos cómo va, para ajustar antes de terminar.</p>
				</div>
				<div class="pantalla pantalla--3 fundir" aria-hidden="true">
					<span class="pantalla__titulo">Construcción</span>
					<div class="semanas">
						<span class="semanas__demo"><Icono nombre="flag-duotone" size={14} /> Demo</span>
						<span class="semanas__tramo" style="--i: 0">Semana 1</span>
						<span class="semanas__tramo" style="--i: 1">Semana 2</span>
						<span class="semanas__tramo" style="--i: 2">Semana 3</span>
					</div>
					<ul class="tareas">
						<li style="--i: 0"><Icono nombre="check-circle-duotone" size={18} />Lo que hoy anotás a mano, cargado</li>
						<li style="--i: 1"><Icono nombre="check-circle-duotone" size={18} />Demo: lo probás y ajustamos</li>
						<li style="--i: 2"><Icono nombre="check-circle-duotone" size={18} />Listo para tu equipo</li>
					</ul>
				</div>
			</li>

			<li class="paso">
				<span class="paso__marca"><Icono nombre="lifebuoy-duotone" size={22} /></span>
				<div class="paso__texto" style="--paso: --paso-4">
					<h3 class="t-label">Soporte todos los meses</h3>
					<p>Arreglamos lo que falle y mejoramos el sistema a medida que tu negocio cambia.</p>
				</div>
				<div class="pantalla pantalla--4 fundir" aria-hidden="true">
					<span class="pantalla__titulo">Soporte</span>
					<div class="soporte">
						<p class="soporte__pedido">¿Podemos sumar el CUIT en las órdenes?</p>
						<p class="soporte__respuesta">
							<Image src={avatar} alt="" width={48} class="soporte__quien" />
							Listo, ya aparece en cada orden.
						</p>
					</div>
					<span class="soporte__mejora">
						<Icono nombre="arrow-up-right-bold" size={16} />
						El sistema cambia con tu negocio
					</span>
				</div>
			</li>
		</ol>
		<span class="linea__relleno" aria-hidden="true"></span>
		<span class="linea__punto" aria-hidden="true"></span>
		</div>

		<div class="proceso__pie">
			<BotonWhatsApp
				variante="secundario"
				texto="Pedir mi auditoría gratis"
				mensaje="Hola, quiero agendar la auditoría gratis de 30 a 45 minutos."
			/>
		</div>
	</div>
</section>

<script>
	import { movimientoReducido } from '../../scripts/contar';

	// La tarjeta fija (escritorio, con movimiento y con scroll-timeline) apila las cuatro
	// pantallas en la misma celda: sin esto el mouse siempre cae sobre la última del DOM. Acá se
	// marca cuál está a media pantalla (pantalla--activa); el CSS le da el pointer-events. Donde
	// no hay tarjeta fija, cada pantalla ya está sola junto a su paso y no hace falta nada.
	const pasos = [...document.querySelectorAll<HTMLElement>('.proceso .paso__texto')];
	const pantallas = [...document.querySelectorAll<HTMLElement>('.proceso .pantalla')];
	const anchoFijo = matchMedia('(min-width: 1024px)');
	const conTarjetaFija = () =>
		!movimientoReducido() &&
		anchoFijo.matches &&
		CSS.supports('(animation-timeline: view()) and (timeline-scope: none)');

	let observador: IntersectionObserver | null = null;
	const enBanda = new Set<HTMLElement>();

	// El sello "Aprobada" (pantalla 2) entra con un fundido por tiempo, una sola vez. Con la card
	// fija se estampa cuando esa pantalla pasa a activa, no por su propio observador (con el
	// observador se estampaba con la pantalla todavía en opacidad 0). Donde el sello está junto a
	// su paso (celular, tablet, sin soporte) lo dispara un observador propio al verse. Con
	// reducción o sin JS no se agrega ninguna clase y el CSS lo deja en su estado final.
	const sello = document.querySelector<HTMLElement>('.propuesta__sello');
	let selloEstampado = false;
	function estamparSello() {
		if (selloEstampado || !sello) return;
		selloEstampado = true;
		sello.classList.remove('proceso-sello-espera');
		sello.classList.add('proceso-sello-entra');
	}

	// En la franja del medio puede haber dos pasos a la vez (la transición entre uno y otro):
	// se activa el que tiene el centro más cerca del centro de la pantalla, nunca dos juntos.
	// Si ninguno está en la franja (antes del paso 1 o después del 4), se queda con el extremo
	// que corresponde: nunca se vacía la tarjeta fija (B2).
	function elegirActiva() {
		pantallas.forEach((p) => p.classList.remove('pantalla--activa'));
		let elegido: HTMLElement | null = null;
		let distancia = Infinity;
		for (const paso of enBanda) {
			const r = paso.getBoundingClientRect();
			const d = Math.abs((r.top + r.bottom) / 2 - innerHeight / 2);
			if (d < distancia) { distancia = d; elegido = paso; }
		}
		if (!elegido && pasos.length) {
			elegido = pasos[0].getBoundingClientRect().top > innerHeight / 2 ? pasos[0] : pasos[pasos.length - 1];
		}
		if (!elegido) return;
		const activa = pantallas[pasos.indexOf(elegido)];
		activa?.classList.add('pantalla--activa');
		if (activa?.classList.contains('pantalla--2')) estamparSello();
	}

	function activar() {
		if (observador || !conTarjetaFija()) return;
		observador = new IntersectionObserver(
			(entradas) => {
				for (const { target, isIntersecting } of entradas) {
					if (isIntersecting) enBanda.add(target as HTMLElement);
					else enBanda.delete(target as HTMLElement);
				}
				elegirActiva();
			},
			{ rootMargin: '-45% 0px -45% 0px' },
		);
		pasos.forEach((paso) => observador!.observe(paso));
	}

	function desactivar() {
		observador?.disconnect();
		observador = null;
		enBanda.clear();
		pantallas.forEach((p) => p.classList.remove('pantalla--activa'));
	}

	// Observador del sello para cuando no hay card fija; se prende y se apaga con el ancho.
	const observadorSello = new IntersectionObserver(
		(entradas) => entradas[0].isIntersecting && estamparSello(),
		{ threshold: 0.6 },
	);

	function ajustar() {
		if (conTarjetaFija()) {
			activar();
			if (sello) observadorSello.unobserve(sello);
		} else {
			desactivar();
			if (sello && !movimientoReducido()) observadorSello.observe(sello);
		}
	}

	if (sello && !movimientoReducido()) sello.classList.add('proceso-sello-espera');
	anchoFijo.addEventListener('change', ajustar);
	ajustar();
</script>

<style>
	.proceso__pie {
		display: flex;
		justify-content: center;
		margin-top: var(--space-6);
	}

	/* --- El riel y los pasos (celular primero) ---
	   El envoltorio lleva --marca (la comparten .linea, .linea__relleno y .linea__punto, que son
	   hermanos: una custom property solo pasa a los descendientes) y el margen que antes tenía
	   .linea, para que el punto pueda medirse contra la misma caja sin offsets. */
	.proceso__riel {
		position: relative;
		margin-top: var(--space-6);
		--marca: 48px;
		/* .linea declara el timeline --proceso; .linea__punto es su hermano, no su descendiente,
		   así que necesita este scope para poder usarlo (igual que --paso-N con las pantallas). */
		timeline-scope: --proceso;
	}

	.linea {
		position: relative;
		display: grid;
		gap: var(--space-6);
		view-timeline: --proceso block;
		timeline-scope: --paso-1, --paso-2, --paso-3, --paso-4;
	}

	/* El riel sin relleno, a la altura del centro de las marcas; se desvanece al final: el soporte
	   sigue. */
	.linea::before {
		content: '';
		position: absolute;
		top: calc(var(--marca) / 2);
		bottom: 0;
		left: calc(var(--marca) / 2 - 1px);
		width: 2px;
		mask-image: linear-gradient(#000 80%, transparent);
		background: var(--border-light);
	}

	/* El relleno del riel: una ventana que no se mueve (mismo tamaño y máscara que el riel) con
	   el color adentro, en transform. Antes esto era un clip-path animado en .linea::after: en el
	   hilo principal costaba casi toda la pintura del scroll con movimiento reducido. Con
	   transform el costo lo asume el compositor. Sin ella (o sin soporte) queda al final, como
	   el riel ya lleno (el ::before no lleva ninguna traslación fuera de la animación). */
	.linea__relleno {
		position: absolute;
		top: calc(var(--marca) / 2);
		bottom: 0;
		left: calc(var(--marca) / 2 - 1px);
		width: 2px;
		overflow: clip;
		mask-image: linear-gradient(#000 80%, transparent);
		pointer-events: none;
	}

	.linea__relleno::before {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--brand-primary-deep);
	}

	/* El punto que viaja con la punta del relleno: el mismo truco que .linea__relleno::before (una
	   caja del alto del riel que se traslada el 100% de su propia altura), pero con translate en
	   vez de transform para no pisar ninguna otra animación. Sin ella (o sin soporte) queda al
	   final, como el riel ya lleno. */
	.linea__punto {
		position: absolute;
		top: calc(var(--marca) / 2);
		bottom: 0;
		left: calc(var(--marca) / 2 - 1px);
		width: 2px;
		translate: 0 100%;
		pointer-events: none;
	}

	.linea__punto::before {
		content: '';
		position: absolute;
		top: 0;
		left: 50%;
		translate: -50% -50%;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--brand-primary-deep);
		box-shadow: 0 0 0 4px var(--surface-alt);
	}

	.paso {
		position: relative;
		display: grid;
		grid-template-columns: var(--marca) minmax(0, 1fr);
		gap: var(--space-3);
	}

	/* Encendida es la de base: sin movimiento (o en Firefox) todo se ve completo. Apagada es una
	   capa blanca encima, que se funde: solo opacidad, sin repintar el fondo en cada cuadro. */
	.paso__marca {
		position: relative;
		z-index: 1;
		display: grid;
		place-items: center;
		width: var(--marca);
		height: var(--marca);
		border-radius: var(--radius-pill);
		background: var(--brand-primary-deep);
		color: var(--white);
		box-shadow: 0 0 0 8px var(--surface-alt);
	}

	.paso__marca::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		border: 1px solid var(--border-light);
		border-radius: inherit;
		background: var(--white);
		opacity: 0;
	}

	/* El anillo que pulsa una vez, cuando la punta del relleno alcanza la marca. Termina en
	   opacidad 0: sin animación (o sin soporte) ya quedó invisible, como si ya hubiera pulsado. */
	.paso__marca::after {
		content: '';
		position: absolute;
		inset: -6px;
		z-index: -1;
		border: 2px solid var(--brand-primary-deep);
		border-radius: inherit;
		opacity: 0;
	}

	.paso__texto {
		display: grid;
		gap: var(--space-1);
		align-content: start;
		padding-top: var(--space-1);
	}

	.paso__texto h3 {
		color: var(--text-heading-dark);
		font-weight: var(--fw-semibold);
	}

	.paso__texto p {
		max-width: 42ch;
	}

	/* --- Las pantallas: card clara en el celular (la propuesta, invertida). Los colores van en
	   variables: en escritorio las cuatro pasan a ser la misma card invertida. --- */
	.pantalla {
		--p-fondo: var(--white);
		--p-borde: var(--border-light);
		--p-titulo: var(--text-heading-dark);
		--p-texto: var(--text-body-dark);
		--p-suave: var(--text-muted-dark);
		--p-riel: var(--slate-100);
		--p-acento: var(--brand-primary-deep);
		--p-chip-fondo: var(--blue-50);
		--p-chip-texto: var(--brand-primary-deep);
		grid-column: 2;
		position: relative;
		display: grid;
		align-content: start;
		gap: var(--space-2);
		max-width: 420px;
		padding: var(--space-3);
		border: 1px solid var(--p-borde);
		border-radius: var(--radius-card);
		background: var(--p-fondo);
		color: var(--p-texto);
		font-size: 0.9375rem;
		line-height: 1.4;
		box-shadow: var(--shadow-elevada);
		transition: translate 0.2s var(--curva-salida), border-color 0.2s var(--curva-salida);
	}

	/* Con mouse, la pantalla activa reacciona: se despega un poco y el borde toma el acento. En
	   la tarjeta fija (más abajo) solo la activa puede recibirlo; en las demás disposiciones,
	   cada pantalla ya está sola junto a su paso. */
	@media (hover: hover) and (pointer: fine) {
		.pantalla:hover {
			translate: 0 -4px;
			border-color: var(--p-acento);
		}
	}

	.pantalla--invertida {
		--p-fondo: var(--surface-card-dark);
		--p-borde: var(--border-dark);
		--p-titulo: var(--text-heading-light);
		--p-texto: var(--text-body-light);
		--p-suave: var(--text-muted-light);
		--p-riel: var(--navy-800);
		--p-acento: var(--cyan-300);
		--p-chip-fondo: var(--cyan-300);
		--p-chip-texto: var(--navy-950);
		box-shadow: var(--shadow-card);
	}

	.pantalla__titulo {
		color: var(--p-titulo);
		font-weight: var(--fw-bold);
	}

	.pantalla__chip,
	.propuesta__sello,
	.soporte__mejora {
		justify-self: start;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 8px 14px;
		border-radius: var(--radius-pill);
		background: var(--p-chip-fondo);
		color: var(--p-chip-texto);
		font-size: var(--type-meta-size);
		font-weight: var(--fw-semibold);
		line-height: 1.2;
	}

	/* 1. Auditoría: dónde se va el tiempo, sin números; el proceso elegido resalta. */
	.auditoria {
		display: grid;
		gap: 12px;
	}

	.auditoria__fila {
		display: grid;
		grid-template-columns: 72px minmax(0, 1fr);
		align-items: center;
		gap: 12px;
		color: var(--p-suave);
		font-weight: var(--fw-medium);
	}

	.auditoria__fila--elegida {
		color: var(--p-titulo);
		font-weight: var(--fw-bold);
	}

	.auditoria__barra {
		height: 10px;
		border-radius: 10px;
		background: var(--p-riel);
		overflow: clip;
	}

	.auditoria__barra > span {
		display: block;
		height: 100%;
		border-radius: inherit;
		background: var(--p-suave);
		opacity: 0.5;
		transform-origin: left;
		transform: scaleX(var(--tiempo));
	}

	.auditoria__fila--elegida .auditoria__barra > span {
		background: var(--p-acento);
		opacity: 1;
	}

	/* 2. Propuesta: sin montos, los precios van en otra etapa. */
	.propuesta {
		display: grid;
		gap: var(--space-1);
	}

	.propuesta div {
		display: flex;
		justify-content: space-between;
		gap: var(--space-2);
		padding-top: var(--space-1);
		border-top: 1px solid var(--p-borde);
	}

	.propuesta dd {
		color: var(--p-acento);
		font-weight: var(--fw-semibold);
	}

	.propuesta__sello {
		rotate: -3deg;
	}

	/* El sello entra con un fundido corto la primera vez que se ve (no atado al scroll: ver el
	   script). "espera" es el estado antes de verse, que solo pone el JS: sin él (o con
	   movimiento reducido, que ni lo agrega) el sello queda en su estado final de una. */
	@keyframes proceso-sello-entra {
		/* scale (la propiedad, no transform) para no pisar el rotate: -3deg de la base. */
		from { opacity: 0; scale: 1.3; }
	}

	@media (prefers-reduced-motion: no-preference) {
		.propuesta__sello.proceso-sello-espera {
			opacity: 0;
		}

		.propuesta__sello.proceso-sello-entra {
			animation: proceso-sello-entra 450ms var(--curva-salida) both;
		}
	}

	/* 3. Construcción: las tres semanas, la bandera de la demo a mitad de camino y las tareas. */
	.semanas {
		position: relative;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 4px;
		padding-top: 36px;
	}

	.semanas__tramo {
		/* Sin min-width: 0 un ítem de grilla no baja de su ancho de contenido (aunque la columna
		   sea 1fr): con la letra más grande, "Semana 3" sin poder bajar de línea empujaba la
		   grilla entera y aparecía scroll horizontal. */
		min-width: 0;
		padding: 8px 2px;
		border-radius: 8px;
		background: var(--blue-100);
		color: var(--blue-900);
		/* min() y no rem solo: "letra grande" (Android/iOS) infla el rem pero no el vw, así que
		   el tope en vw evita que "Semana" desborde su tramo cuando crece la fuente del sistema. */
		font-size: min(0.8125rem, 3.6vw);
		font-weight: var(--fw-semibold);
		text-align: center;
	}

	.semanas__tramo:nth-of-type(2) { border-radius: var(--radius-pill) 8px 8px var(--radius-pill); }
	.semanas__tramo:nth-of-type(4) { border-radius: 8px var(--radius-pill) var(--radius-pill) 8px; }

	.semanas__demo {
		position: absolute;
		top: 0;
		left: 50%;
		translate: -50% 0;
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding: 4px 10px;
		border-radius: var(--radius-pill);
		background: var(--cyan-300);
		color: var(--navy-950);
		font-size: 0.8125rem;
		font-weight: var(--fw-bold);
		box-shadow: var(--shadow-elevada);
	}

	.tareas {
		display: grid;
		gap: 8px;
	}

	.tareas li {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.tareas :global(svg) {
		flex: none;
		color: var(--p-acento);
	}

	/* 4. Soporte: el pedido y la respuesta, que la da la agencia (el avatar de la marca, sobre el globo azul oscuro). */
	.soporte {
		display: grid;
		gap: 8px;
	}

	.soporte p {
		max-width: 30ch;
		padding: 10px 14px;
		border-radius: var(--radius-card);
	}

	.soporte__pedido {
		justify-self: start;
		border: 1px solid var(--p-borde);
		border-bottom-left-radius: var(--radius-input);
		color: var(--p-titulo);
	}

	.soporte__respuesta {
		justify-self: end;
		display: flex;
		align-items: center;
		gap: 8px;
		border-bottom-right-radius: var(--radius-input);
		background: var(--brand-primary-deep);
		color: var(--blue-50);
	}

	.soporte__quien {
		flex: none;
		width: 24px;
		height: 24px;
		border-radius: 50%;
	}

	/* --- Escritorio sin la card fija (movimiento reducido o sin soporte): cada visual al lado de
	   su paso, como el celular pero en dos columnas. La card fija (con movimiento) lo pisa más
	   abajo. --- */
	@media (min-width: 1024px) {
		.proceso__riel {
			--marca: 56px;
		}

		.linea {
			gap: var(--space-7);
		}

		.paso {
			grid-template-columns: var(--marca) minmax(0, 5fr) minmax(0, 6fr);
			column-gap: var(--space-4);
			align-items: start;
		}

		.pantalla {
			grid-column: 3;
			grid-row: 1;
			width: 100%;
		}
	}

	/* --- Movimiento --- */
	/* De -100% a 0 y no scaleY: con scaleY el mask-image de .linea__relleno (el desvanecido del
	   final) se escalaba junto con la caja, así que la punta del relleno siempre se apagaba un 20%
	   y quedaba despegada del punto. Acá la ventana (.linea__relleno, con overflow: clip) no
	   cambia de tamaño ni se mueve: solo se traslada el ::before de adentro, así que el mask se ve
	   siempre en el mismo lugar y el borde recortado coincide con el punto en todo el recorrido. */
	@keyframes proceso-llenar {
		from { translate: 0 -100%; }
	}

	@keyframes proceso-apagada {
		from, to { opacity: 1; }
	}

	@keyframes proceso-icono-apagado {
		from, to { color: var(--brand-primary-deep); }
	}

	@keyframes proceso-barra {
		from { transform: scaleX(0); }
	}

	/* Recorte de izquierda a derecha y no scaleX: así "Semana" no se aplasta mientras avanza. */
	@keyframes proceso-tramo {
		from { clip-path: inset(0 100% 0 0); }
		to { clip-path: inset(0 0 0 0); }
	}

	/* El punto viaja de punta a punta del riel, junto con .linea__relleno::before. */
	@keyframes proceso-punto-viaja {
		from { translate: 0 0%; }
	}

	/* El anillo se abre y se va mientras crece, una sola vez. */
	@keyframes proceso-anillo {
		0% { opacity: 0; scale: 0.7; }
		35% { opacity: 0.6; }
		100% { opacity: 0; scale: 1.7; }
	}

	/* Excepción pedida por el usuario (2026-09-25), como la cinta de rubros: el riel, el punto y
	   las marcas corren también con movimiento reducido. Todo queda atado al scroll (lo maneja
	   quien baja, nada se mueve solo), así que no es la animación que reduced-motion busca evitar.
	   La tarjeta fija de escritorio y el texto activo no entran acá: siguen solo con
	   no-preference, más abajo. */
	@supports (animation-timeline: view()) {
		/* La punta del relleno va a media pantalla. */
		.linea__relleno::before {
			animation: proceso-llenar linear both;
			animation-timeline: --proceso;
			animation-range: cover 50vh cover calc(100% - 50vh);
		}

		.linea__punto {
			animation: proceso-punto-viaja linear both;
			animation-timeline: --proceso;
			animation-range: cover 50vh cover calc(100% - 50vh);
		}

		/* Cada marca está apagada hasta que la punta la alcanza (fill backwards: antes del
		   tramo, apagada; después, la de base, encendida). */
		.paso__marca::before {
			animation: proceso-apagada linear backwards;
			animation-timeline: view();
			animation-range: cover calc(50vh - 8px) cover calc(50vh + 16px);
		}

		.paso__marca :global(svg) {
			animation: proceso-icono-apagado linear backwards;
			animation-timeline: view();
			animation-range: cover calc(50vh - 8px) cover calc(50vh + 16px);
		}

		/* El pulso del anillo, en la misma marca en la que la punta enciende el ícono. Rango de
		   160px (no los 48 de antes): con un scroll rápido, un tramo más corto se salteaba entero
		   y el anillo quedaba a mitad de camino si el usuario paraba justo ahí. */
		.paso__marca::after {
			animation: proceso-anillo var(--curva-salida) both;
			animation-timeline: view();
			animation-range: cover calc(50vh - 8px) cover calc(50vh + 152px);
		}
	}

	/* Celular y tablet: cada visual entra y se arma con su propio view(). */
	@media (prefers-reduced-motion: no-preference) and (max-width: 1023px) {
		@supports (animation-timeline: view()) {
			.pantalla {
				view-timeline: --pantalla block;
				animation: entrar-corto var(--curva-salida) both;
				animation-timeline: view();
				animation-range: entry 10% entry 80%;
			}

			.auditoria__barra > span {
				animation: proceso-barra var(--curva-salida) both;
				animation-timeline: --pantalla;
				animation-range: entry calc(50% + var(--i) * 10%) cover calc(45% + var(--i) * 4%);
			}

			.semanas__tramo {
				animation: proceso-tramo var(--curva-salida) both;
				animation-timeline: --pantalla;
				animation-range: cover calc(30% + var(--i) * 8%) cover calc(40% + var(--i) * 8%);
			}
		}
	}

	/* --- Escritorio con movimiento: la card fija que cambia de pantalla. Los pasos pierden su
	   caja (display: contents) y sus partes pasan a la grilla de la lista: marca y texto en una
	   fila por paso, las cuatro pantallas apiladas en la tercera columna, fijas a media pantalla.
	   Cada texto es alto (el tramo de scroll de su paso) y define su timeline, con la línea que
	   cuenta a media pantalla (view-timeline-inset). --- */
	/* Los timelines de dos pasos seguidos se pisan un 12 % (la franja de media pantalla): la que
	   sale termina de irse antes de que llegue la otra, para que nunca se lean dos a la vez. */
	@keyframes proceso-pantalla {
		0%, 6% { opacity: 0; transform: translateY(16px); }
		14%, 86% { opacity: 1; transform: none; }
		93%, 100% { opacity: 0; transform: translateY(-16px); }
	}

	@keyframes proceso-pantalla-primera {
		0%, 86% { opacity: 1; transform: none; }
		93%, 100% { opacity: 0; transform: translateY(-16px); }
	}

	@keyframes proceso-pantalla-ultima {
		0%, 6% { opacity: 0; transform: translateY(16px); }
		14%, 100% { opacity: 1; transform: none; }
	}

	/* El texto del paso activo se aclara del resto. 0.76 es el piso: sobre este fondo deja el
	   cuerpo en el gris de --text-muted-dark, que todavía pasa AA. */
	@keyframes proceso-texto-activo {
		0%, 100% { opacity: 0.76; }
		12%, 88% { opacity: 1; }
	}

	/* El primero arranca activo y el último queda activo, como sus pantallas. */
	@keyframes proceso-texto-primero {
		0%, 88% { opacity: 1; }
		100% { opacity: 0.76; }
	}

	@keyframes proceso-texto-ultimo {
		0% { opacity: 0.76; }
		12%, 100% { opacity: 1; }
	}

	/* Las pantallas usan los timelines de sus hermanos (--paso-N), que necesitan timeline-scope:
	   sin él quedarían las cuatro visibles y encimadas en la card. Con movimiento reducido o sin
	   soporte no entra nada de esto: quedan las cuatro cards al lado de su paso (arriba). */
	@media (prefers-reduced-motion: no-preference) and (min-width: 1024px) {
		@supports (animation-timeline: view()) and (timeline-scope: none) {
			.linea {
				grid-template-columns: var(--marca) minmax(0, 5fr) minmax(0, 6fr);
				grid-template-rows: repeat(4, auto);
				gap: 0 var(--space-4);
				--fija-arriba: max(112px, calc(50vh - var(--fija-alto) / 2));
				--fija-alto: 400px;
			}

			.paso {
				display: contents;
			}

			/* Marca y texto no llevan fila: con su columna fija, la grilla los pone solos en la
			   fila siguiente de cada paso. Las pantallas y el marco ocupan todas las filas. */
			.paso__marca {
				grid-column: 1;
			}

			.paso__texto {
				grid-column: 2;
				min-height: 70vh;
				padding-bottom: var(--space-6);
				view-timeline: var(--paso) block;
				view-timeline-inset: 45% 45%;
				animation: proceso-texto-activo linear both;
				animation-timeline: var(--paso);
			}

			.paso:first-child .paso__texto { animation-name: proceso-texto-primero; }
			.paso:last-child .paso__texto { animation-name: proceso-texto-ultimo; }

			/* El marco: la única card invertida, fija. Es el ::before del primer paso, que con
			   display: contents igual genera su caja y cae en la grilla de la lista. Las cuatro
			   pantallas van encima, transparentes: solo cambia el contenido. */
			.paso:first-child::before {
				content: '';
				grid-column: 3;
				grid-row: 1 / -1;
				align-self: start;
				position: sticky;
				top: var(--fija-arriba);
				height: var(--fija-alto);
				border: 1px solid var(--border-dark);
				border-radius: var(--radius-card);
				background: var(--surface-card-dark);
				box-shadow: var(--shadow-card);
			}

			/* La paleta de .pantalla--invertida, para las cuatro; sin fondo, lo pone el marco. */
			.pantalla {
				--p-borde: var(--border-dark);
				--p-titulo: var(--text-heading-light);
				--p-texto: var(--text-body-light);
				--p-suave: var(--text-muted-light);
				--p-riel: var(--navy-800);
				--p-acento: var(--cyan-300);
				--p-chip-fondo: var(--cyan-300);
				--p-chip-texto: var(--navy-950);
				grid-row: 1 / -1;
				align-self: start;
				position: sticky;
				top: var(--fija-arriba);
				max-width: none;
				height: var(--fija-alto);
				padding: var(--space-5) var(--space-4);
				gap: var(--space-3);
				border-color: transparent;
				background: none;
				font-size: 1.0625rem;
				box-shadow: none;
				animation: proceso-pantalla linear both;
				/* Las cuatro están apiladas en la misma celda: sin esto, el mouse siempre cae
				   sobre la última del DOM. El script marca cuál está a media pantalla. */
				pointer-events: none;
			}

			.pantalla--activa {
				pointer-events: auto;
			}

			.pantalla__titulo {
				font-size: var(--type-label-size);
			}

			/* Con la tarjeta fija el marco (::before) no se mueve: si la pantalla sube 4px en
			   hover queda un doble borde abajo. Acá solo cambia el borde. */
			@media (hover: hover) and (pointer: fine) {
				.pantalla:hover {
					translate: none;
				}
			}

			.pantalla--1 { animation-name: proceso-pantalla-primera; animation-timeline: --paso-1; }
			.pantalla--2 { animation-timeline: --paso-2; }
			.pantalla--3 { animation-timeline: --paso-3; }
			.pantalla--4 { animation-name: proceso-pantalla-ultima; animation-timeline: --paso-4; }

			/* Cada pantalla se arma mientras su paso cruza la mitad. */
			.pantalla--1 .auditoria__barra > span {
				animation: proceso-barra var(--curva-salida) both;
				animation-timeline: --paso-1;
				animation-range: cover calc(5% + var(--i) * 6%) cover calc(35% + var(--i) * 6%);
			}

			.pantalla--2 .propuesta div {
				animation: entrar-corto var(--curva-salida) both;
				animation-timeline: --paso-2;
				animation-range: cover calc(8% + var(--i) * 8%) cover calc(24% + var(--i) * 8%);
			}

			.pantalla--3 .semanas__tramo {
				animation: proceso-tramo var(--curva-salida) both;
				animation-timeline: --paso-3;
				animation-range: cover calc(8% + var(--i) * 14%) cover calc(22% + var(--i) * 14%);
			}

			.pantalla--3 .tareas li {
				animation: entrar-corto var(--curva-salida) both;
				animation-timeline: --paso-3;
				animation-range: cover calc(20% + var(--i) * 14%) cover calc(30% + var(--i) * 14%);
			}

			.pantalla--4 .soporte p,
			.pantalla--4 .soporte__mejora {
				animation: entrar-corto var(--curva-salida) both;
				animation-timeline: --paso-4;
			}

			.pantalla--4 .soporte__pedido { animation-range: cover 8% cover 20%; }
			.pantalla--4 .soporte__respuesta { animation-range: cover 22% cover 34%; }
			.pantalla--4 .soporte__mejora { animation-range: cover 36% cover 46%; }
		}
	}

</style>
