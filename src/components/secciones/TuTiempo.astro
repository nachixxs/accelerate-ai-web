---
// SPECS §4.5: una calculadora. El dueño elige la tarea, las horas por semana y cuántas personas la
// hacen, y ve las horas por mes (horas × personas × 4). La cifra es de él: la página no promete
// nada. El resultado es el "momento de escala" de la marca y la única card invertida de la sección.
// El botón de WhatsApp manda ese número y esa tarea. Sin JS, o donde el navegador avisa que no
// hay scripting, se ve el ejemplo ya calculado y sin controles (el HTML trae el estado final).
// Las piezas están en `src/components/tiempo/`: los controles, la card del resultado y sus scripts.
import BotonWhatsApp from '../BotonWhatsApp.astro';
import Controles from '../tiempo/Controles.astro';
import Resultado from '../tiempo/Resultado.astro';

// "Hacer la caja" arranca elegida: es el ejemplo de Sistemas a medida (MockCaja), la tarea que
// hace cualquier rubro y la que mejor suena en el mensaje ("haciendo la caja").
const tareas = [
	{ id: 'pedidos', chip: 'Cargar pedidos', verbo: 'cargando pedidos', icono: 'receipt-duotone' },
	{ id: 'caja', chip: 'Hacer la caja', verbo: 'haciendo la caja', icono: 'cash-register-duotone' },
	{ id: 'stock', chip: 'Controlar el stock', verbo: 'controlando el stock', icono: 'package-duotone' },
	{ id: 'datos', chip: 'Pasar datos de un lado a otro', verbo: 'pasando datos de un lado a otro', icono: 'arrows-left-right-duotone' },
	{ id: 'otra', chip: 'Otra', verbo: 'en tareas que se repiten', icono: 'dots-three-circle-duotone' },
];
const [HORAS, PERSONAS, TAREA] = [5, 2, 'caja'];
const total = HORAS * PERSONAS * 4;
const verboEjemplo = tareas.find((t) => t.id === TAREA)!.verbo;

// La plantilla vive acá y la usa también el script: {n} es el total y {verbo}, la tarea.
const PLANTILLA = 'Hola, vi la web. Se me van unas {n} horas por mes {verbo}.';
const mensaje = PLANTILLA.replace('{n}', String(total)).replace('{verbo}', verboEjemplo);

const controles = [
	{ id: 'horas', etiqueta: 'Horas por semana', min: 1, max: 20, valor: HORAS, uno: 'hora por semana', varias: 'horas por semana' },
	{ id: 'personas', etiqueta: 'Personas que lo hacen', min: 1, max: 10, valor: PERSONAS, uno: 'persona', varias: 'personas' },
];
---

<section id="tiempo" class="seccion tiempo" aria-labelledby="tiempo-titulo" data-plantilla={PLANTILLA}>
	<div class="contenedor">
		<div class="encabezado-seccion revelar">
			<h2 id="tiempo-titulo" class="t-titular">¿Cuánto tiempo se te va?</h2>
			<p class="t-cuerpo">Elegí una tarea que se repite y poné cuánto le dedican. La cuenta es tuya.</p>
		</div>

		<div class="tiempo__calc">
			<Controles tareas={tareas} controles={controles} tarea={TAREA} />
			<Resultado tareas={tareas} tarea={TAREA} total={total} horas={HORAS} personas={PERSONAS}>
				<BotonWhatsApp variante="contorno" texto="Contanos en qué se te van" mensaje={mensaje} />
			</Resultado>
		</div>
	</div>
</section>

<style>
	.tiempo__calc { display: grid; gap: var(--space-5); margin-top: var(--space-5); }

	/* Debajo de 1024 la card va arriba de los controles y el botón, después: los tres son hijos
	   directos de esta grilla (la salida es `display: contents`) y se ordenan con `order`, que está
	   en cada componente: card 1, ejemplo sin JS 2, controles 3, botón 4. El HTML no se reordena (el
	   foco sigue chips, horas, personas, botón, y el lector recibe el total por el status). */
	@media (max-width: 1023.98px) {
		.tiempo__calc { gap: var(--space-3); }
	}
	@media (max-width: 767.98px) {
		.tiempo__calc { gap: var(--space-2); }
	}

	@media (min-width: 1024px) {
		.tiempo__calc { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-6); align-items: start; }
	}

	/* Sin controles, la card sola no se queda pegada a la izquierda con media pantalla vacía. */
	@media (scripting: none) and (min-width: 1024px) {
		.tiempo__calc { grid-template-columns: minmax(0, 640px); }
	}
</style>

<script>
	import { controles } from '../tiempo/controles';
	import { resultado } from '../tiempo/resultado';

	const seccion = document.getElementById('tiempo')!;
	const horas = seccion.querySelector<HTMLInputElement>('#tiempo-horas')!;
	const personas = seccion.querySelector<HTMLInputElement>('#tiempo-personas')!;
	const anuncio = seccion.querySelector<HTMLElement>('[data-anuncio]')!;
	const boton = seccion.querySelector<HTMLAnchorElement>('.tiempo__accion a')!;
	const base = boton.href.split('?')[0];
	const vista = controles(seccion);
	const card = resultado(seccion);
	let aviso = 0;
	let arrastrando = false;

	// Recalcula todo desde los controles. `animar` es falso al arrancar: el HTML ya trae el ejemplo.
	function actualizar(animar: boolean) {
		const n = Number(horas.value) * Number(personas.value) * 4;
		const tarea = seccion.querySelector<HTMLInputElement>('input[name="tarea"]:checked')!;
		const verbo = tarea.dataset.verbo!;
		boton.href = `${base}?text=${encodeURIComponent(seccion.dataset.plantilla!.replace('{n}', String(n)).replace('{verbo}', verbo))}`;
		vista.perillas(animar && !arrastrando);
		card.poner(n, tarea.value, animar);

		// El lector de pantalla se entera una vez que se deja de mover, no en cada paso. Cambiar solo
		// la tarea también se anuncia (una vez): el texto nombra el total y la tarea.
		clearTimeout(aviso);
		const texto = `Se te van ${n} horas por mes ${verbo}`;
		if (!animar) anuncio.textContent = texto;
		else if (anuncio.textContent !== texto) aviso = window.setTimeout(() => (anuncio.textContent = texto), 700);
	}

	// Al arrastrar, la perilla y el número van pegados al dedo (transiciones cortas, sin teclado).
	const soltar = () => {
		arrastrando = false;
		delete seccion.dataset.arrastrando;
		seccion.querySelectorAll('[data-presionado]').forEach((el) => el.removeAttribute('data-presionado'));
	};
	seccion.addEventListener('pointerdown', (e) => {
		const rango = (e.target as HTMLElement).closest<HTMLInputElement>('input[type="range"]');
		if (!rango) return;
		arrastrando = true;
		seccion.dataset.arrastrando = '';
		rango.closest('.tiempo__control')!.setAttribute('data-presionado', '');
	});
	addEventListener('pointerup', soltar);
	addEventListener('pointercancel', soltar);

	seccion.addEventListener('input', (e) => {
		if ((e.target as HTMLInputElement).type === 'radio') vista.marcar(true);
		actualizar(true);
	});
	vista.marcar(false);
	actualizar(false);
	requestAnimationFrame(() => requestAnimationFrame(() => (seccion.dataset.listo = '')));
</script>
