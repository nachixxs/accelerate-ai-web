	class:list={['logo', `logo--${fondo}`, clase]}
	viewBox="-52.2 -181.3 2104.1 184.6"
	role={oculto ? undefined : 'img'}
	aria-label={oculto ? undefined : 'Accelerate.ai'}
	aria-hidden={oculto ? 'true' : undefined}
	focusable="false"
>
