			<rect {...region} fill="#fff"></rect>
			<g fill="#000" stroke="#000" stroke-width="10">
				<rect x="-60" y="-180" width="300" height="125" stroke="none"></rect>
				<use href={ref('s')} transform="translate(-28)"></use>
				<use href={ref('s')}></use>
			</g>
		</mask>
		<mask id={`${id}-m2`} maskUnits="userSpaceOnUse" {...region}>
