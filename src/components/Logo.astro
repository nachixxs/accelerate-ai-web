---
// El logo: wordmark integrado [A]ccelerate[·]ai. La A del isotipo C4 (con sus dos capas de velocidad) es la
// primera letra y el punto con sus dos rastros es el punto de ".ai". Un solo SVG fijo, sin texto en vivo.
// Las letras "ccelerate" y "ai" son contornos de Archivo variable (wght 800, wdth 125: el ancho de la A de C4;
// el sitio no carga el eje wdth), con el kerning de la fuente y tracking -0,01em, escaladas para que las
// mayúsculas midan lo que la A (171,89) sobre la base y = 0. Se sacaron con fontkit (getVariation + layout);
// el generador no es parte del repo. Si cambia el logo hay que volver a sacarlos.
// Los SVG de la marca separan las capas pintando encima formas del color del fondo; acá cada capa lleva una
// <mask> que recorta lo que esas formas tapaban (con 5 px de margen: son los cortes), así no hay fondo y sirve
// sobre cualquier color. Coordenadas del SVG original (la A en 3.8 … 229.4, el punto en 267.4 … 342.2).
// El tamaño lo da el ancho que ponga quien lo usa (el alto sale del viewBox). `id` tiene que ser único en
// la página: va en las máscaras. `oculto`: el logo es decorativo (el del menú) y no se lee.
// Colores por custom property (--logo-*), con los tokens --mark-* y los de título.
interface Props {
	fondo: 'claro' | 'oscuro';
	id: string;
	oculto?: boolean;
	class?: string;
}

const { fondo, id, oculto, class: clase } = Astro.props;
const ref = (nombre: string) => `#${id}-${nombre}`;
// Región de las máscaras: el viewBox de la A y el punto con un poco de aire.
const region = { x: -60, y: -180, width: 410, height: 185 };
---

