		--logo-atras: var(--mark-back);
		--logo-letras: var(--text-heading-dark);
	}

	.logo--oscuro {
		--logo-frente: var(--mark-front-on-dark);
		--logo-medio: var(--mark-mid-on-dark);
		--logo-atras: var(--mark-back-on-dark);
		--logo-letras: var(--mark-front-on-dark);
	}

	.logo__frente { fill: var(--logo-frente); }
	.logo__medio { fill: var(--logo-medio); }
	.logo__atras { fill: var(--logo-atras); }
	.logo__letras { fill: var(--logo-letras); }

	/* Alto contraste: el fondo pasa a Canvas y los fills del SVG no se ajustan solos; todo sigue al tema. */
	@media (forced-colors: active) {
